<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      Local override for a Meowshell package version newer than what has been
      published (e.g. after a Meowshell PR merges but before its own CI has
      packed and pushed a nupkg). Relative to this file, so it resolves
      regardless of the working directory a build is run from. Gitignored
      and may not exist on a fresh clone: restore keeps working off nuget.org
      alone until something is dropped in here, mirroring Meowshell's own
      dotnet/nuget.config.
    -->
    <add key="local" value="nupkg" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
