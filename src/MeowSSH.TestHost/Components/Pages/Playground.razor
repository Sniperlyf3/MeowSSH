@page "/"
@page "/hosts"
@using MeowSSH.UI.Pages
@using MeowSSH.Core.Ssh
@* Without an explicit render mode the page is statically rendered: it looks
   right but no button does anything, so every interaction test fails. *@
@rendermode InteractiveServer

@*
    The Linux-runnable face of the app. It mounts the same components the Android
    build does, against fakes, so Playwright can drive real flows in CI without an
    emulator. Query parameters pick the scenario, which keeps each test a plain
    navigation rather than a setup script.
*@

@if (RendererInfo.IsInteractive)
{
    @* Marks the circuit as live. Until this appears the markup is server-rendered
       only: it looks finished but no handler is wired, so a click does nothing. *@
    <span data-testid="interactive" hidden></span>
}

@if (_setup)
{
    <VaultSetupScreen OnReady="() => { _setup = false; _unlocked = true; }" />
}
else if (!_unlocked)
{
    <VaultLockScreen OnUnlocked="() => _unlocked = true" />
}
else if (_files is not null)
{
    <FilesPage Host="_files.Host" Sftp="_files.Sftp" OnClosed="CloseFiles" />
}
else if (_session is not null)
{
    <SessionPage Host="_session.Host" Shell="_session.Shell" OnClosed="CloseSession" />
}
else if (_editing)
{
    <HostEditorPage Host="_editTarget" OnSaved="CloseEditor" OnCancelled="CloseEditor" />
}
else if (_tab == "files")
{
    <FilesLandingPage OnHostSelected="OpenFiles" OnTabSelected="tab => _tab = tab" />
}
else if (_tab == "keys")
{
    <KeysPage OnTabSelected="tab => _tab = tab" />
}
else if (_tab == "settings")
{
    <SettingsPage OnTabSelected="tab => _tab = tab" />
}
else
{
    <HostsPage OnHostSelected="OpenSession"
               OnAddHost="() => { _editTarget = null; _editing = true; }"
               OnEditHost="host => { _editTarget = host; _editing = true; }"
               OnTabSelected="tab => _tab = tab" />
}

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private FakeVaultSession Vault { get; set; } = default!;

    private bool _unlocked;
    private bool _setup;
    private bool _editing;
    private string _tab = "hosts";
    private HostRecord? _editTarget;
    private SessionState? _session;
    private FilesState? _files;

    private sealed record SessionState(HostRecord Host, FakeSshShell Shell);

    private sealed record FilesState(HostRecord Host, FakeSftpSession Sftp);

    protected override void OnInitialized()
    {
        var query = new Uri(Navigation.Uri).Query;
        _setup = query.Contains("setup", StringComparison.OrdinalIgnoreCase);
        // The session has to agree with the screen: rendering the setup screen
        // against a vault that reports itself as merely locked makes "create"
        // answer "a vault already exists" and the flow dead-ends.
        Vault.Reset(_setup ? VaultState.NotCreated : VaultState.Locked);
        // "locked" and "setup" are separate scenarios: one is a returning user,
        // the other a first run, and they are different screens.
        _unlocked = !_setup && !query.Contains("locked", StringComparison.OrdinalIgnoreCase);
        if (query.Contains("keys", StringComparison.OrdinalIgnoreCase)) _tab = "keys";
        if (query.Contains("newhost", StringComparison.OrdinalIgnoreCase)) _editing = true;
        if (query.Contains("files", StringComparison.OrdinalIgnoreCase))
            _files = new FilesState(SampleHost, new FakeSftpSession());
    }

    private bool _sessionStarted;

    private void OpenSession(HostRecord host)
    {
        _session = new SessionState(host, new FakeSshShell());
        _sessionStarted = false;
    }

    private void OpenFiles(HostRecord host) =>
        _files = new FilesState(host, new FakeSftpSession());

    // The shell is started after a render, so TerminalView has been initialised
    // and is subscribed. Starting it inline would emit the banner into a session
    // nothing is listening to yet.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_session is null || _sessionStarted) return;
        _sessionStarted = true;
        await _session.Shell.StartAsync();
    }

    private void CloseSession()
    {
        _session = null;
        _sessionStarted = false;
    }

    private void CloseFiles() => _files = null;

    private void CloseEditor()
    {
        _editing = false;
        _editTarget = null;
    }

    /// <summary>The host the file browser opens against when driven by URL.</summary>
    private static HostRecord SampleHost => new()
    {
        Id = Guid.NewGuid(),
        Label = "prod-web-01",
        Address = "10.4.2.11",
        Username = "deploy",
        Transport = SshTransport.Tcp,
        UpdatedAt = DateTimeOffset.UtcNow,
    };
}
