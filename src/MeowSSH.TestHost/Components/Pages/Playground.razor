@page "/"
@page "/hosts"
@using MeowSSH.UI.Pages
@using MeowSSH.Core.Diagnostics
@using MeowSSH.Core.Ssh
@rendermode InteractiveServer

@if (RendererInfo.IsInteractive)
{
    <span data-testid="interactive" hidden></span>
}

@if (_diagnosticReport is not null)
{
    <div class="hosts" data-testid="diagnostic-background">
        <p class="visually-hidden">Diagnostic prompt playground</p>
    </div>
    <DiagnosticReportPrompt Report="_diagnosticReport"
                            OnSave="SaveDiagnosticReport"
                            OnDiscard="DiscardDiagnosticReport" />
}
else if (_diagnosticResult is not null)
{
    <div class="sheet" role="status" data-testid="diagnostic-result">
        <p class="sheet__title">@_diagnosticResult</p>
    </div>
}
else if (_multi)
{
    <AppRoot />
}
else if (_setup)
{
    <VaultSetupScreen OnReady="() => { _setup = false; _unlocked = true; }" />
}
else if (!_unlocked)
{
    <VaultLockScreen OnUnlocked="() => _unlocked = true" />
}
else if (_files is not null)
{
    <FilesPage Host="_files.Host" Sftp="_files.Sftp" OnClosed="CloseFiles" />
}
else if (_session is not null)
{
    <SessionPage Host="_session.Host" Shell="_session.Shell" OnClosed="CloseSession" />
}
else if (_editing)
{
    <HostEditorPage Host="_editTarget" OnSaved="CloseEditor" OnCancelled="CloseEditor" />
}
else if (_tab == "files")
{
    <FilesLandingPage OnHostSelected="OpenFiles" OnTabSelected="tab => _tab = tab" />
}
else if (_tab == "keys")
{
    <KeysPage OnTabSelected="tab => _tab = tab" />
}
else if (_tab == "settings")
{
    <SettingsPage OnTabSelected="tab => _tab = tab" />
}
else
{
    <HostsPage OnHostSelected="OpenSession"
               OnAddHost="() => { _editTarget = null; _editing = true; }"
               OnEditHost="host => { _editTarget = host; _editing = true; }"
               OnTabSelected="tab => _tab = tab" />
}

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private FakeVaultSession Vault { get; set; } = default!;

    private bool _multi;
    private bool _unlocked;
    private bool _setup;
    private bool _editing;
    private string _tab = "hosts";
    private HostRecord? _editTarget;
    private SessionState? _session;
    private FilesState? _files;
    private DiagnosticReportSnapshot? _diagnosticReport;
    private string? _diagnosticResult;

    private sealed record SessionState(HostRecord Host, FakeSshShell Shell);
    private sealed record FilesState(HostRecord Host, FakeSftpSession Sftp);

    protected override void OnInitialized()
    {
        var query = new Uri(Navigation.Uri).Query;
        _multi = query.Contains("multi", StringComparison.OrdinalIgnoreCase);
        _setup = !_multi && query.Contains("setup", StringComparison.OrdinalIgnoreCase);
        Vault.Reset(_multi ? VaultState.Unlocked : _setup ? VaultState.NotCreated : VaultState.Locked);
        _unlocked = _multi || (!_setup && !query.Contains("locked", StringComparison.OrdinalIgnoreCase));
        if (query.Contains("keys", StringComparison.OrdinalIgnoreCase)) _tab = "keys";
        if (query.Contains("newhost", StringComparison.OrdinalIgnoreCase)) _editing = true;
        if (!_multi && query.Contains("files", StringComparison.OrdinalIgnoreCase))
            _files = new FilesState(SampleHost, new FakeSftpSession());
        if (query.Contains("diagnostic", StringComparison.OrdinalIgnoreCase))
            _diagnosticReport = SampleDiagnosticReport();
    }

    private bool _sessionStarted;

    private void OpenSession(HostRecord host)
    {
        _session = new SessionState(host, new FakeSshShell());
        _sessionStarted = false;
    }

    private void OpenFiles(HostRecord host) => _files = new FilesState(host, new FakeSftpSession());

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_multi || _session is null || _sessionStarted) return;
        _sessionStarted = true;
        await _session.Shell.StartAsync();
    }

    private void CloseSession()
    {
        _session = null;
        _sessionStarted = false;
    }

    private void CloseFiles() => _files = null;

    private void CloseEditor()
    {
        _editing = false;
        _editTarget = null;
    }

    private void SaveDiagnosticReport()
    {
        _diagnosticReport = null;
        _diagnosticResult = "Save requested";
    }

    private void DiscardDiagnosticReport()
    {
        _diagnosticReport = null;
        _diagnosticResult = "Discarded";
    }

    private static DiagnosticReportSnapshot SampleDiagnosticReport()
    {
        var breadcrumbs = new DiagnosticBreadcrumbBuffer();
        breadcrumbs.Add(DiagnosticBreadcrumbKind.AppStarted, DateTimeOffset.UtcNow.AddMinutes(-2));
        breadcrumbs.Add(DiagnosticBreadcrumbKind.StartedSshSession, DateTimeOffset.UtcNow.AddMinutes(-1));
        return DiagnosticReportSnapshotBuilder.Capture(
            new InvalidOperationException("Connection state changed unexpectedly."),
            breadcrumbs,
            "2.0.0-test",
            "Android",
            DateTimeOffset.UtcNow);
    }

    private static HostRecord SampleHost => new()
    {
        Id = Guid.NewGuid(),
        Label = "prod-web-01",
        Address = "10.4.2.11",
        Username = "deploy",
        Transport = SshTransport.Tcp,
        UpdatedAt = DateTimeOffset.UtcNow,
    };
}
