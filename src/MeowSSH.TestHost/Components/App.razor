<!DOCTYPE html>
<html lang="en" data-theme="@Theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>MeowSSH</title>
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href="_content/MeowSSH.UI/css/meowssh.css" />
    <link rel="stylesheet" href="_content/MeowSSH.UI/css/files-actions.css" />
    <link rel="stylesheet" href="_content/MeowSSH.UI/css/forwards.css" />
    <link rel="stylesheet" href="_content/MeowSSH.UI/css/shell-viewport.css" />
    <link rel="stylesheet" href="_content/MeowSSH.UI/css/session-tabs.css" />
    @* xterm ships its own stylesheet; without it the terminal renders with
       broken metrics, not merely unstyled. Served from the app, not a CDN --
       see wwwroot/vendor/xterm/README.md. *@
    <link rel="stylesheet" href="_content/MeowSSH.UI/vendor/xterm/xterm.css" />
    <HeadOutlet />
</head>
<body>
    <Routes />

    @* The same element the Android app's index.html carries. It is here so the
       browser tests exercise the rule that keeps it hidden -- that rule lives in
       the shared stylesheet, and a host without the element cannot prove it. *@
    <div id="blazor-error-ui" data-nosnippet>
        Something went wrong.
        <a href="." class="reload">Reload</a>
    </div>

    <script src="_content/MeowSSH.UI/vendor/xterm/xterm.js"></script>
    <script src="_content/MeowSSH.UI/vendor/xterm/addon-fit.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    /// <summary>
    /// Lets a test pin the theme with <c>?theme=light</c> so both palettes can be
    /// screenshotted deterministically, rather than depending on the CI browser's
    /// colour-scheme preference.
    /// </summary>
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? Theme => HttpContext?.Request.Query["theme"] is { Count: > 0 } value
        && (value == "light" || value == "dark") ? value.ToString() : null;
}
