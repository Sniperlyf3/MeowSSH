@implements IDisposable
@inject ITailcatHubService Hub

<link rel="stylesheet" href="_content/MeowSSH.UI/css/tailcat.css" />
<section class="tailcat-page" data-testid="tailcat-page">
    <nav class="tailcat-intents" aria-label="Tailcat tools" data-testid="tailcat-intent-groups">
        @foreach (var group in IntentGroups)
        {
            <section class="tailcat-intent-group" aria-labelledby="tailcat-intent-@group.Id">
                <div class="tailcat-intent-group__heading">
                    <strong id="tailcat-intent-@group.Id">@group.Label</strong>
                    <small>@group.Description</small>
                </div>
                <div class="segmented tailcat-sections" role="tablist" aria-label="@group.Label">
                    @foreach (var section in group.Sections)
                    {
                        <button type="button" role="tab"
                                id="tailcat-tab-@section.Id"
                                class="segmented__option @(_section == section.Id ? "segmented__option--on" : "")"
                                aria-selected="@(_section == section.Id ? "true" : "false")"
                                aria-controls="tailcat-panel-@section.Id"
                                data-testid="tailcat-section-@section.Id"
                                @onclick="() => _section = section.Id">@section.Label</button>
                    }
                </div>
            </section>
        }
    </nav>

    <div role="tabpanel"
         id="tailcat-panel-@_section"
         aria-labelledby="tailcat-tab-@_section"
         tabindex="0"
         data-testid="tailcat-active-panel">
        @if (_section == "workspaces")
        {
            <TailcatWorkspacesPanel />
        }
        else if (_section == "phone")
        {
            <TailcatPhonePanel />
        }
        else if (_section == "connect")
        {
            <TailcatConnectPanel />
        }
        else if (_section == "vpn")
        {
            <TailcatVpnPanel />
        }
        else if (_section == "transfers")
        {
            <TailcatTransfersPanel />
        }
        else if (_section == "address")
        {
            <TailcatAddressPanel />
        }
        else if (_section == "keys")
        {
            <TailcatKeysPanel />
        }
        else
        {
            <TailcatDiagnosticsPanel />
        }
    </div>

    @if (_snapshot.RecentLogLines.Count > 0)
    {
        <details class="tailcat-card tailcat-logs" data-testid="tailcat-native-logs">
            <summary>Native diagnostics</summary>
            <pre>@string.Join("\n", _snapshot.RecentLogLines.TakeLast(30))</pre>
        </details>
    }
</section>

@code {
    private sealed record Section(string Id, string Label);
    private sealed record IntentGroup(string Id, string Label, string Description, Section[] Sections);

    private static readonly IntentGroup[] IntentGroups =
    [
        new("connect", "Connect", "Reach peers and reusable Tailcat workspaces.",
        [
            new("connect", "Connect"),
            new("address", "Addresses"),
            new("workspaces", "Workspaces"),
        ]),
        new("devices", "Devices & keys", "Configure this phone and manage Tailcat identities.",
        [
            new("phone", "This phone"),
            new("keys", "Keys"),
        ]),
        new("network", "Network & VPN", "Route device traffic through Tailcat.",
        [
            new("vpn", "VPN"),
        ]),
        new("transfers", "Transfers", "Browse and transfer files over Tailcat.",
        [
            new("transfers", "Transfers"),
        ]),
        new("diagnostics", "Diagnostics", "Inspect connectivity and relay behavior.",
        [
            new("diagnostics", "Diagnostics"),
        ]),
    ];

    private string _section = "phone";
    private TailcatHubSnapshot _snapshot = new(null, null, [], []);

    protected override void OnInitialized()
    {
        _snapshot = Hub.Snapshot;
        Hub.Changed += OnChanged;
    }

    private void OnChanged(object? sender, EventArgs e) => _ = InvokeAsync(() =>
    {
        _snapshot = Hub.Snapshot;
        StateHasChanged();
    });

    public void Dispose() => Hub.Changed -= OnChanged;
}
