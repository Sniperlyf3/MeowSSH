@using MeowSSH.Core.Services
@using MeowSSH.Core.Ssh
@using MeowSSH.UI.Services
@implements IAsyncDisposable
@inject IVaultSession Vault
@inject ISshEngine Engine
@inject ISshPrompts Prompts
@inject InteractiveSshPrompts Questions
@inject ICredentialResolver Credentials

@*
    The whole app, composed from services. Both hosts render this: the Android
    app with the real engine and vault, the test host with fakes. Keeping the
    composition here rather than in each host is what stops the two from drifting
    into testing something the app does not do.
*@

@if (!_ready)
{
    <div class="lock" data-testid="app-loading">
        <p class="visually-hidden" role="status">Starting MeowSSH</p>
    </div>
}
else if (Vault.State == VaultState.NotCreated)
{
    <VaultSetupScreen OnReady="OnUnlockedAsync" />
}
else if (Vault.State is not VaultState.Unlocked)
{
    <VaultLockScreen OnUnlocked="OnUnlockedAsync" />
}
else if (_session is not null)
{
    <SessionPage Host="_session.Host" Shell="_session.Shell" OnClosed="CloseSessionAsync" />
}
else if (_files is not null)
{
    <FilesPage Host="_files.Host" Sftp="_files.Sftp" OnClosed="CloseFilesAsync" />
}
else if (_editing is not null)
{
    <HostEditorPage Host="_editing.Host" OnSaved="CloseEditorAsync" OnCancelled="CancelEditor" />
}
else if (_tab == "keys")
{
    <KeysPage OnTabSelected="SelectTab" />
}
else
{
    <HostsPage OnHostSelected="ConnectAsync" OnAddHost="AddHost" OnEditHost="EditHost" OnTabSelected="SelectTab" />

    @if (_connecting is not null)
    {
        <div class="sheet" role="status" data-testid="connecting">
            <p class="sheet__title">Connecting to @_connecting</p>
            <p class="sheet__body">Waiting for the host to answer.</p>
        </div>
    }
    @if (Questions.PendingHostKey is { } hostKey)
    {
        <div class="sheet sheet--danger" role="alertdialog" data-testid="host-key-prompt">
            <p class="sheet__title">Trust this server?</p>
            <p class="sheet__body">
                MeowSSH has not seen <strong>@hostKey.Prompt.Host</strong> before. Check the
                fingerprint against the server itself before accepting it — if it does not match,
                something is intercepting the connection.
            </p>
            <code class="recovery__code mono" data-testid="host-key-fingerprint">@hostKey.Prompt.Fingerprint</code>
            <div class="form__actions">
                <button type="button" class="btn btn--primary btn--block"
                        data-testid="trust-host-key" @onclick="() => hostKey.Answer(true)">
                    Trust and connect
                </button>
                <button type="button" class="btn btn--ghost btn--block"
                        data-testid="reject-host-key" @onclick="() => hostKey.Answer(false)">
                    Cancel
                </button>
            </div>
        </div>
    }
    @if (Questions.PendingPassword is { } password)
    {
        <div class="sheet" role="alertdialog" data-testid="password-prompt">
            <p class="sheet__title">Password required</p>
            <p class="sheet__body">@password.Prompt</p>
            <div class="form__actions">
                <label class="field">
                    <span class="field__label">Password</span>
                    <input class="field__input mono" type="password" data-testid="password-input"
                           autocomplete="off" autocapitalize="none" spellcheck="false"
                           @bind="_password" @bind:event="oninput"
                           @onkeydown="e => OnPasswordKey(e, password)" />
                </label>
                <button type="button" class="btn btn--primary btn--block"
                        data-testid="submit-password" @onclick="() => SubmitPassword(password)">
                    Sign in
                </button>
                <button type="button" class="btn btn--ghost btn--block"
                        data-testid="cancel-password" @onclick="() => CancelPassword(password)">
                    Cancel
                </button>
            </div>
        </div>
    }
    @if (_failure is not null)
    {
        <div class="sheet sheet--danger" role="alert" data-testid="connect-error">
            <p class="sheet__title">@_failure.Title</p>
            <p class="sheet__body">@_failure.Body</p>
            <button type="button" class="btn btn--ghost btn--block"
                    data-testid="dismiss-error" @onclick="() => _failure = null">Dismiss</button>
        </div>
    }
}

@code {
    private SessionState? _session;
    private FilesState? _files;
    private EditorState? _editing;
    private string _tab = "hosts";
    private string? _connecting;
    private Failure? _failure;
    private ISshConnection? _connection;
    private bool _ready;
    private string _password = "";

    private sealed record SessionState(HostRecord Host, ISshShell Shell);
    private sealed record FilesState(HostRecord Host, ISftpSession Sftp);
    /// <summary>Null Host means the editor is adding rather than changing one.</summary>
    private sealed record EditorState(HostRecord? Host);
    private sealed record Failure(string Title, string Body);

    protected override async Task OnInitializedAsync()
    {
        Vault.StateChanged += OnVaultChanged;
        // The handshake raises its questions on the agent's thread, so the shell
        // has to be told to repaint rather than noticing on its own.
        Questions.Changed += OnQuestionsChanged;
        // Nothing is drawn until this answers: a first run and a locked vault are
        // different screens, and showing the wrong one offers a fingerprint that
        // cannot work or a setup flow that would refuse to run.
        await Vault.InitializeAsync();
        _ready = true;
    }

    private void OnVaultChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);

    private void OnQuestionsChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);

    private void SubmitPassword(PasswordRequest request)
    {
        var answer = _password;
        // Cleared before the answer is handed over, so the field is not still
        // holding it when the sheet closes.
        _password = "";
        request.Answer(answer);
    }

    private void CancelPassword(PasswordRequest request)
    {
        _password = "";
        // Null, not empty: an empty password is an attempt, and the server would
        // count it as a failed one.
        request.Answer(null);
    }

    private void OnPasswordKey(KeyboardEventArgs e, PasswordRequest request)
    {
        if (e.Key == "Enter") SubmitPassword(request);
    }

    private Task OnUnlockedAsync()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void SelectTab(string tab) => _tab = tab;

    private void AddHost() => _editing = new EditorState(null);

    private void EditHost(HostRecord host) => _editing = new EditorState(host);

    private void CancelEditor() => _editing = null;

    private Task CloseEditorAsync()
    {
        _editing = null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task ConnectAsync(HostRecord host)
    {
        _connecting = host.Label;
        _failure = null;
        StateHasChanged();

        try
        {
            // Unsealed here and disposed as soon as the handshake is done, so the
            // key exists in memory for the length of one connection rather than
            // for the length of the session.
            using var credentials = await Credentials.ResolveAsync(host);
            _connection = await Engine.ConnectAsync(host, credentials, Prompts);
            var shell = await _connection.OpenShellAsync(80, 24);
            _session = new SessionState(host, shell);
        }
        catch (SshException ex)
        {
            // A changed host key is the one failure that must never read as a
            // routine retry, so it gets its own words.
            _failure = ex.Failure switch
            {
                SshFailure.HostKeyChanged => new("Host key changed", ex.Message),
                SshFailure.HostKeyUnknown => new("Host not trusted yet", ex.Message),
                SshFailure.AuthenticationFailed => new("Could not sign in", ex.Message),
                _ => new("Could not connect", ex.Message),
            };
            await DropConnectionAsync();
        }
        finally
        {
            _connecting = null;
            StateHasChanged();
        }
    }

    private async Task CloseSessionAsync()
    {
        if (_session is not null) await _session.Shell.DisposeAsync();
        _session = null;
        await DropConnectionAsync();
    }

    private async Task CloseFilesAsync()
    {
        if (_files is not null) await _files.Sftp.DisposeAsync();
        _files = null;
    }

    private async Task DropConnectionAsync()
    {
        if (_connection is not null) await _connection.DisposeAsync();
        _connection = null;
    }

    public async ValueTask DisposeAsync()
    {
        Vault.StateChanged -= OnVaultChanged;
        Questions.Changed -= OnQuestionsChanged;
        await CloseSessionAsync();
        await CloseFilesAsync();
    }
}
