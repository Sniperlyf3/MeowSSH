@using MeowSSH.Core.Services
@using MeowSSH.Core.Ssh
@using MeowSSH.UI.Services
@implements IAsyncDisposable
@inject IVaultSession Vault
@inject IConnectionEngine Engine
@inject ISshPrompts Prompts
@inject InteractiveSshPrompts Questions
@inject ICredentialResolver Credentials
@inject IActiveSessionLifetime SessionLifetime

@if (!_ready)
{
    <div class="lock" data-testid="app-loading">
        <p class="visually-hidden" role="status">Starting MeowSSH</p>
    </div>
}
else if (Vault.State == VaultState.NotCreated)
{
    <VaultSetupScreen OnReady="OnUnlockedAsync" />
}
else if (Vault.State is not VaultState.Unlocked)
{
    <VaultLockScreen OnUnlocked="OnUnlockedAsync" />
}
else if (_activeSessionId is not null && _sessions.Count > 0)
{
    @foreach (var session in _sessions)
    {
        var isActive = session.Id == _activeSessionId;
        <section class="session-workspace @(isActive ? "is-active" : "")"
                 data-testid="session-workspace" @key="session.Id">
            <SessionTabStrip Tabs="SessionTabs"
                             ActiveId="_activeSessionId"
                             OnSelected="SelectSession"
                             OnClosed="CloseSessionAsync"
                             OnToggleView="ToggleSessionViewAsync"
                             OnOpenForwards="ShowForwardsAsync"
                             OnNew="OpenNewSession" />

            <div class="session-workspace__pane @(session.View == SessionView.Terminal ? "is-active" : "")">
                @if (session.Terminal is not null)
                {
                    <SessionPage Host="session.DisplayHost"
                                 Shell="session.Terminal"
                                 SupportsFiles="session.SupportsSshFeatures"
                                 IsConnected="session.IsConnected"
                                 IsReconnecting="session.IsReconnecting"
                                 PathStatus="session.PathStatus"
                                 DisconnectMessage="session.Status"
                                 OnReconnect="() => ReconnectAsync(session.Id)"
                                 OnWriteFailed="ex => OnTerminalWriteFailedAsync(session.Id, ex)"
                                 OnOpenFiles="() => ShowFilesAsync(session.Id)"
                                 OnClosed="LeaveWorkspace" />
                }
            </div>

            <div class="session-workspace__pane @(session.View == SessionView.Files ? "is-active" : "")">
                @if (session.Sftp is not null)
                {
                    <FilesPage @key="session.Sftp"
                               Host="session.DisplayHost"
                               Sftp="session.Sftp"
                               OnClosed="LeaveWorkspace" />
                }
            </div>

            <div class="session-workspace__pane @(session.View == SessionView.Forwards ? "is-active" : "")">
                @if (session.SupportsSshFeatures)
                {
                    <ForwardsPage HostLabel="session.DisplayHost.Label"
                                  Forwards="ForwardInfos(session)"
                                  OnStart="request => StartForwardAsync(session.Id, request)"
                                  OnStop="request => StopForwardAsync(session.Id, request)"
                                  OnClosed="LeaveWorkspace" />
                }
            </div>
        </section>
    }
}
else if (_editing is not null)
{
    <HostEditorPage Host="_editing.Host" OnSaved="CloseEditorAsync" OnCancelled="CancelEditor" />
}
else if (_tab == "files")
{
    <FilesLandingPage OnHostSelected="OpenFilesAsync" OnTabSelected="SelectTab" />
}
else if (_tab == "keys")
{
    <KeysPage OnTabSelected="SelectTab" />
}
else if (_tab == "settings")
{
    <SettingsPage OnTabSelected="SelectTab" />
}
else
{
    <HostsPage OnHostSelected="ConnectAsync"
               OnAddHost="AddHost"
               OnEditHost="EditHost"
               OnTabSelected="SelectTab"
               OpenSessionCount="_sessions.Count"
               OnOpenSessions="ResumeSessions" />
}

@if (Vault.State == VaultState.Unlocked)
{
    <SshPromptSheets Questions="Questions" />
}

@if (_connecting is not null)
{
    <div class="sheet" role="status" data-testid="connecting">
        <p class="sheet__title">@(_connectingForFiles ? $"Opening files on {_connecting}" : $"Connecting to {_connecting}")</p>
        <p class="sheet__body">@(_connectingForFiles ? "Connecting to the host and starting SFTP." : "Waiting for the endpoint to answer.")</p>
    </div>
}

@if (_failure is not null)
{
    <div class="sheet sheet--danger" role="alert" data-testid="connect-error">
        <p class="sheet__title">@_failure.Title</p>
        <p class="sheet__body">@_failure.Body</p>
        <button type="button" class="btn btn--ghost btn--block"
                data-testid="dismiss-error" @onclick="() => _failure = null">Dismiss</button>
    </div>
}

@code {
    private readonly List<OpenSession> _sessions = [];
    private Guid? _activeSessionId;
    private EditorState? _editing;
    private string _tab = "hosts";
    private string? _connecting;
    private bool _connectingForFiles;
    private Failure? _failure;
    private bool _ready;

    private sealed record EditorState(HostRecord? Host);
    private sealed record Failure(string Title, string Body);

    private sealed class RunningForward(ForwardRequest request, ISshForward forward)
    {
        public Guid Id { get; } = Guid.NewGuid();
        public ForwardRequest Request { get; } = request;
        public ISshForward? Forward { get; set; } = forward;
    }

    private sealed class OpenSession(HostRecord sourceHost, HostRecord displayHost, IHostConnection connection)
    {
        public Guid Id { get; } = Guid.NewGuid();
        public HostRecord SourceHost { get; } = sourceHost;
        public HostRecord DisplayHost { get; set; } = displayHost;
        public IHostConnection Connection { get; set; } = connection;
        public ITerminalSession? Terminal { get; set; }
        public ISftpSession? Sftp { get; set; }
        public List<RunningForward> Forwards { get; } = [];
        public SessionView View { get; set; }
        public bool IsConnected { get; set; } = true;
        public bool IsReconnecting { get; set; }
        public string Status { get; set; } = "Connected.";
        public EventHandler<SshConnectionLost>? ConnectionLostHandler { get; set; }
        public EventHandler<SshPathStatus>? PathChangedHandler { get; set; }
        public SshPathStatus? PathStatus { get; set; }
        public EventHandler<int>? TerminalExitedHandler { get; set; }
        public CancellationTokenSource? ReconnectCancellation { get; set; }
        public Task? ReconnectTask { get; set; }
        public bool SupportsSshFeatures => Connection is ISshConnection;
    }

    private IReadOnlyList<SessionTabInfo> SessionTabs =>
        [.. _sessions.Select(s => new SessionTabInfo(
            s.Id,
            s.DisplayHost.Label,
            s.View,
            s.IsConnected,
            s.SupportsSshFeatures,
            s.SupportsSshFeatures))];

    protected override async Task OnInitializedAsync()
    {
        Vault.StateChanged += OnVaultChanged;
        Questions.Changed += OnQuestionsChanged;
        await Vault.InitializeAsync();
        _ready = true;
    }

    private void OnVaultChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);
    private void OnQuestionsChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);

    private Task OnUnlockedAsync()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task SelectTab(string tab)
    {
        _activeSessionId = null;
        _tab = tab;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void AddHost() => _editing = new EditorState(null);
    private void EditHost(HostRecord host) => _editing = new EditorState(host);
    private void CancelEditor() => _editing = null;

    private Task CloseEditorAsync()
    {
        _editing = null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task ConnectAsync(HostRecord host) => OpenSessionAsync(host, SessionView.Terminal);

    private Task OpenFilesAsync(HostRecord host)
    {
        if (host.Protocol != HostProtocol.Ssh)
        {
            _failure = new Failure("SFTP is not available", "Files are available only for SSH connections.");
            StateHasChanged();
            return Task.CompletedTask;
        }
        return OpenSessionAsync(host, SessionView.Files);
    }

    private async Task OpenSessionAsync(HostRecord host, SessionView initialView)
    {
        if (_connecting is not null) return;

        _connecting = host.Label;
        _connectingForFiles = initialView == SessionView.Files;
        _failure = null;
        StateHasChanged();

        IHostConnection? connection = null;
        ITerminalSession? terminal = null;
        ISftpSession? sftp = null;
        try
        {
            if (!_sessions.Any(s => s.IsConnected || s.IsReconnecting))
                await SessionLifetime.StartAsync();

            var connected = await ConnectHostAsync(host);
            connection = connected.Connection;
            var session = new OpenSession(host, connected.DisplayHost, connection)
            {
                View = initialView,
            };
            WireConnection(session);

            if (initialView == SessionView.Terminal)
            {
                terminal = await connection.OpenTerminalAsync(80, 24);
                session.Terminal = terminal;
                // Re-read after terminal creation so a transport that learns its
                // path while opening the live stream cannot race the initial
                // connection snapshot/event subscription.
                session.PathStatus = connection.PathStatus;
                WireTerminal(session);
            }
            else if (connection is ISshConnection ssh)
            {
                sftp = await ssh.OpenSftpAsync();
                session.Sftp = sftp;
            }
            else
            {
                throw new InvalidOperationException("This protocol does not provide SFTP.");
            }

            _sessions.Add(session);
            _activeSessionId = session.Id;
            connection = null;
            terminal = null;
            sftp = null;
        }
        catch (SshException ex)
        {
            _failure = MapFailure(initialView == SessionView.Files ? "Could not open files" : "Could not connect", ex);
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException or ObjectDisposedException)
        {
            _failure = new Failure(initialView == SessionView.Files ? "Could not open files" : "Could not connect", ex.Message);
        }
        finally
        {
            if (sftp is not null) await sftp.DisposeAsync();
            if (terminal is not null) await terminal.DisposeAsync();
            if (connection is not null) await connection.DisposeAsync();
            if (_sessions.Count == 0) await SessionLifetime.StopAsync();
            _connecting = null;
            StateHasChanged();
        }
    }

    private async Task<(HostRecord DisplayHost, IHostConnection Connection)> ConnectHostAsync(
        HostRecord host,
        CancellationToken cancellationToken = default)
    {
        using var credentials = await Credentials.ResolveAsync(host, cancellationToken);
        var displayHost = !string.IsNullOrWhiteSpace(credentials.Username)
            ? host with { Username = credentials.Username }
            : host;
        var credentialPrompts = new CredentialSshPrompts(Prompts, credentials);
        var connection = await Engine.ConnectAsync(displayHost, credentials, credentialPrompts, cancellationToken);
        return (displayHost, connection);
    }

    private void WireConnection(OpenSession session)
    {
        EventHandler<SshConnectionLost> handler = (_, lost) =>
            _ = InvokeAsync(() => MarkSessionDisconnectedAsync(session.Id, lost.Message, autoReconnect: true));
        session.ConnectionLostHandler = handler;
        session.Connection.ConnectionLost += handler;

        session.PathStatus = session.Connection.PathStatus;
        EventHandler<SshPathStatus> pathHandler = (_, path) =>
            _ = InvokeAsync(() =>
            {
                session.PathStatus = path;
                StateHasChanged();
            });
        session.PathChangedHandler = pathHandler;
        session.Connection.PathChanged += pathHandler;
    }

    private void WireTerminal(OpenSession session)
    {
        if (session.Terminal is null) return;
        EventHandler<int> handler = (_, exitCode) =>
            _ = InvokeAsync(() => MarkSessionDisconnectedAsync(
                session.Id,
                exitCode == 0 ? "The terminal session exited." : $"The terminal session exited with status {exitCode}.",
                autoReconnect: false));
        session.TerminalExitedHandler = handler;
        session.Terminal.Exited += handler;
    }

    private async Task ToggleSessionViewAsync(Guid id)
    {
        var session = FindSession(id);
        if (session is null || !session.IsConnected || !session.SupportsSshFeatures) return;

        if (session.View == SessionView.Terminal)
            await ShowFilesAsync(id);
        else
            await ShowTerminalAsync(id);
    }

    private async Task ShowFilesAsync(Guid id)
    {
        var session = FindSession(id);
        if (session is null || !session.IsConnected || session.Connection is not ISshConnection ssh) return;

        try
        {
            session.Sftp ??= await ssh.OpenSftpAsync();
            session.View = SessionView.Files;
            _activeSessionId = id;
        }
        catch (SshException ex)
        {
            _failure = MapFailure("Could not open files", ex);
        }
        StateHasChanged();
    }

    private async Task ShowTerminalAsync(Guid id)
    {
        var session = FindSession(id);
        if (session is null || !session.IsConnected) return;

        try
        {
            if (session.Terminal is null)
            {
                session.Terminal = await session.Connection.OpenTerminalAsync(80, 24);
                WireTerminal(session);
            }
            session.View = SessionView.Terminal;
            _activeSessionId = id;
        }
        catch (SshException ex)
        {
            _failure = MapFailure("Could not open terminal", ex);
        }
        StateHasChanged();
    }

    private Task ShowForwardsAsync(Guid id)
    {
        var session = FindSession(id);
        if (session is null || !session.IsConnected || !session.SupportsSshFeatures) return Task.CompletedTask;
        session.View = SessionView.Forwards;
        _activeSessionId = id;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private IReadOnlyList<ForwardInfo> ForwardInfos(OpenSession session) =>
        [.. session.Forwards
            .Where(f => f.Forward is not null)
            .Select(f => new ForwardInfo(
                f.Id,
                f.Forward!.Kind,
                f.Forward.BoundAddress,
                f.Forward.Destination,
                f.Forward.SocksUsername,
                f.Forward.SocksPassword))];

    private async Task StartForwardAsync(Guid id, ForwardRequest request)
    {
        var session = FindSession(id);
        if (session is null || !session.IsConnected || session.Connection is not ISshConnection ssh) return;

        try
        {
            var forward = await OpenForwardAsync(ssh, request);
            session.Forwards.Add(new RunningForward(request, forward));
            session.View = SessionView.Forwards;
            _failure = null;
        }
        catch (SshException ex)
        {
            _failure = MapFailure("Could not start forward", ex);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or IOException)
        {
            _failure = new Failure("Could not start forward", ex.Message);
        }
        StateHasChanged();
    }

    private static Task<ISshForward> OpenForwardAsync(ISshConnection connection, ForwardRequest request) =>
        request.Kind switch
        {
            SshForwardKind.Local when request.UseUnixSocket => connection.OpenLocalForwardOnUnixSocketAsync(
                request.ListenAddress,
                RequiredDestination(request),
                request.MaxConnections),
            SshForwardKind.Local => connection.OpenLocalForwardAsync(
                request.ListenAddress,
                RequiredDestination(request),
                request.AllowNonLoopbackBind,
                request.MaxConnections),
            SshForwardKind.Remote => connection.OpenRemoteForwardAsync(
                request.ListenAddress,
                RequiredDestination(request),
                request.MaxConnections),
            SshForwardKind.Socks when request.UseUnixSocket => connection.OpenSocksForwardOnUnixSocketAsync(
                request.ListenAddress,
                request.RequireSocksAuth,
                request.SocksUsername,
                request.SocksPassword,
                request.MaxConnections),
            SshForwardKind.Socks => connection.OpenSocksForwardAsync(
                request.ListenAddress,
                request.RequireSocksAuth,
                request.SocksUsername,
                request.SocksPassword,
                request.AllowNonLoopbackBind,
                request.MaxConnections),
            _ => throw new ArgumentOutOfRangeException(nameof(request.Kind)),
        };

    private async Task StopForwardAsync(Guid id, ForwardStopRequest request)
    {
        var session = FindSession(id);
        var running = session?.Forwards.FirstOrDefault(f => f.Id == request.Id);
        if (session is null || running is null) return;

        try
        {
            if (running.Forward is not null) await running.Forward.DisposeAsync();
            session.Forwards.Remove(running);
            _failure = null;
        }
        catch (Exception ex) when (ex is SshException or IOException or ObjectDisposedException)
        {
            _failure = new Failure("Could not stop forward", ex.Message);
        }
        StateHasChanged();
    }

    private static string RequiredDestination(ForwardRequest request) =>
        !string.IsNullOrWhiteSpace(request.Destination)
            ? request.Destination
            : throw new ArgumentException("A destination is required for this forward.");

    private Task SelectSession(Guid id)
    {
        if (FindSession(id) is not null) _activeSessionId = id;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OpenNewSession()
    {
        _activeSessionId = null;
        _tab = "hosts";
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task LeaveWorkspace()
    {
        _activeSessionId = null;
        _tab = "hosts";
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task ResumeSessions()
    {
        if (_sessions.Count > 0) _activeSessionId = _sessions[^1].Id;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnTerminalWriteFailedAsync(Guid id, Exception exception) =>
        MarkSessionDisconnectedAsync(id, "The terminal stopped accepting input.", autoReconnect: true);

    private async Task MarkSessionDisconnectedAsync(Guid id, string? message, bool autoReconnect)
    {
        var session = FindSession(id);
        if (session is null || !session.IsConnected) return;

        session.IsConnected = false;
        session.Status = string.IsNullOrWhiteSpace(message)
            ? "The terminal session is no longer connected."
            : message;
        await SuspendForwardsAsync(session);

        if (autoReconnect && session.SourceHost.AutoReconnect)
            StartAutoReconnect(session);

        if (!_sessions.Any(s => s.IsConnected || s.IsReconnecting))
            await SessionLifetime.StopAsync();
        StateHasChanged();
    }

    private void StartAutoReconnect(OpenSession session)
    {
        if (session.ReconnectTask is { IsCompleted: false }) return;

        session.ReconnectCancellation?.Dispose();
        var cts = new CancellationTokenSource();
        session.ReconnectCancellation = cts;
        session.ReconnectTask = AutoReconnectAsync(session, cts.Token);
    }

    private async Task AutoReconnectAsync(OpenSession session, CancellationToken cancellationToken)
    {
        session.IsReconnecting = true;
        await SessionLifetime.StartAsync();
        var attempt = 0;
        try
        {
            while (!cancellationToken.IsCancellationRequested && _sessions.Contains(session))
            {
                attempt++;
                var delay = ReconnectDelay(attempt);
                session.Status = $"Reconnect attempt {attempt} in {FormatDelay(delay)}…";
                StateHasChanged();
                await Task.Delay(delay, cancellationToken);

                session.Status = $"Reconnect attempt {attempt}…";
                StateHasChanged();
                var error = await TryReconnectAsync(session, cancellationToken);
                if (error is null) return;

                session.Status = ErrorMessage(error);
                if (!IsRetryable(error)) return;
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        finally
        {
            session.IsReconnecting = false;
            if (!session.IsConnected && !_sessions.Any(s => s.IsConnected || (s != session && s.IsReconnecting)))
                await SessionLifetime.StopAsync();
            StateHasChanged();
        }
    }

    private async Task ReconnectAsync(Guid id)
    {
        var session = FindSession(id);
        if (session is null) return;

        await CancelAutoReconnectAsync(session);
        session.IsReconnecting = true;
        session.Status = "Reconnecting now…";
        StateHasChanged();
        try
        {
            await SessionLifetime.StartAsync();
            var error = await TryReconnectAsync(session, CancellationToken.None);
            if (error is not null) session.Status = ErrorMessage(error);
        }
        finally
        {
            session.IsReconnecting = false;
            if (!session.IsConnected && !_sessions.Any(s => s.IsConnected || s.IsReconnecting))
                await SessionLifetime.StopAsync();
            StateHasChanged();
        }
    }

    private async Task<Exception?> TryReconnectAsync(OpenSession session, CancellationToken cancellationToken)
    {
        var hadTerminal = session.Terminal is not null;
        var hadSftp = session.Sftp is not null;
        try
        {
            await DisposeConnectionAsync(session, preserveForwardDefinitions: true);

            var connected = await ConnectHostAsync(session.SourceHost, cancellationToken);
            session.DisplayHost = connected.DisplayHost;
            session.Connection = connected.Connection;
            WireConnection(session);

            if (hadTerminal)
            {
                session.Terminal = await session.Connection.OpenTerminalAsync(80, 24, cancellationToken);
                WireTerminal(session);
            }

            if (hadSftp)
            {
                if (session.Connection is not ISshConnection ssh)
                    throw new InvalidOperationException("This reconnected protocol no longer provides SFTP.");
                session.Sftp = await ssh.OpenSftpAsync(cancellationToken);
            }

            if (session.Forwards.Count > 0)
            {
                if (session.Connection is not ISshConnection ssh)
                    throw new InvalidOperationException("This reconnected protocol no longer provides port forwarding.");
                foreach (var running in session.Forwards)
                    running.Forward = await OpenForwardAsync(ssh, running.Request);
            }

            session.IsConnected = true;
            session.Status = "Connected.";
            return null;
        }
        catch (Exception ex) when (ex is SshException or IOException or ObjectDisposedException or InvalidOperationException)
        {
            session.IsConnected = false;
            try { await DisposeConnectionAsync(session, preserveForwardDefinitions: true); }
            catch { }
            return ex;
        }
    }

    private static bool IsRetryable(Exception exception) => exception switch
    {
        SshException { Failure: SshFailure.AuthenticationFailed or SshFailure.HostKeyChanged or SshFailure.HostKeyUnknown
            or SshFailure.PermissionDenied or SshFailure.Cancelled } => false,
        InvalidOperationException => false,
        _ => true,
    };

    private static string ErrorMessage(Exception exception) => exception is SshException ssh
        ? ssh.Message
        : string.IsNullOrWhiteSpace(exception.Message) ? "Could not reconnect the terminal session." : exception.Message;

    private static TimeSpan ReconnectDelay(int attempt) => attempt switch
    {
        <= 1 => TimeSpan.FromSeconds(1),
        2 => TimeSpan.FromSeconds(2),
        3 => TimeSpan.FromSeconds(4),
        4 => TimeSpan.FromSeconds(8),
        5 => TimeSpan.FromSeconds(15),
        _ => TimeSpan.FromSeconds(30),
    };

    private static string FormatDelay(TimeSpan delay) => delay.TotalSeconds == 1 ? "1 second" : $"{delay.TotalSeconds:0} seconds";

    private async Task CloseSessionAsync(Guid id)
    {
        var session = FindSession(id);
        if (session is null) return;

        var index = _sessions.IndexOf(session);
        await CancelAutoReconnectAsync(session);
        await DisposeConnectionAsync(session);
        _sessions.Remove(session);

        if (_activeSessionId == id)
        {
            if (_sessions.Count == 0)
            {
                _activeSessionId = null;
                _tab = "hosts";
            }
            else
            {
                var next = Math.Min(index, _sessions.Count - 1);
                _activeSessionId = _sessions[next].Id;
            }
        }

        if (_sessions.Count == 0) await SessionLifetime.StopAsync();
        StateHasChanged();
    }

    private static async Task SuspendForwardsAsync(OpenSession session)
    {
        foreach (var running in session.Forwards)
        {
            if (running.Forward is null) continue;
            try { await running.Forward.DisposeAsync(); }
            catch (Exception ex) when (ex is SshException or IOException or ObjectDisposedException) { }
            running.Forward = null;
        }
    }

    private static async Task DisposeForwardsAsync(OpenSession session, bool preserveDefinitions)
    {
        await SuspendForwardsAsync(session);
        if (!preserveDefinitions) session.Forwards.Clear();
    }

    private async Task DisposeConnectionAsync(OpenSession session, bool preserveForwardDefinitions = false)
    {
        await DisposeForwardsAsync(session, preserveForwardDefinitions);

        if (session.Terminal is not null)
        {
            if (session.TerminalExitedHandler is not null)
                session.Terminal.Exited -= session.TerminalExitedHandler;
            await session.Terminal.DisposeAsync();
            session.Terminal = null;
            session.TerminalExitedHandler = null;
        }

        if (session.Sftp is not null)
        {
            await session.Sftp.DisposeAsync();
            session.Sftp = null;
        }

        if (session.ConnectionLostHandler is not null)
            session.Connection.ConnectionLost -= session.ConnectionLostHandler;
        if (session.PathChangedHandler is not null)
            session.Connection.PathChanged -= session.PathChangedHandler;
        await session.Connection.DisposeAsync();
        session.ConnectionLostHandler = null;
        session.PathChangedHandler = null;
        session.PathStatus = null;
    }

    private static async Task CancelAutoReconnectAsync(OpenSession session)
    {
        var cancellation = session.ReconnectCancellation;
        var task = session.ReconnectTask;
        session.ReconnectCancellation = null;
        session.ReconnectTask = null;
        if (cancellation is null) return;
        await cancellation.CancelAsync();
        if (task is not null)
        {
            try { await task; } catch (OperationCanceledException) { }
        }
        cancellation.Dispose();
    }

    private OpenSession? FindSession(Guid id) => _sessions.FirstOrDefault(s => s.Id == id);

    private static Failure MapFailure(string fallbackTitle, SshException ex) => ex.Failure switch
    {
        SshFailure.HostKeyChanged => new("Host key changed", ex.Message),
        SshFailure.HostKeyUnknown => new("Host not trusted yet", ex.Message),
        SshFailure.AuthenticationFailed => new("Could not sign in", ex.Message),
        _ => new(fallbackTitle, ex.Message),
    };

    public async ValueTask DisposeAsync()
    {
        Vault.StateChanged -= OnVaultChanged;
        Questions.Changed -= OnQuestionsChanged;

        foreach (var session in _sessions.ToArray())
            await CancelAutoReconnectAsync(session);
        foreach (var session in _sessions.ToArray())
            await DisposeConnectionAsync(session);
        _sessions.Clear();
        await SessionLifetime.StopAsync();
    }
}
