@using MeowSSH.Core.Diagnostics

<div class="sheet diagnostic-prompt" role="dialog" aria-labelledby="diagnostic-report-title" data-testid="diagnostic-report-prompt">
    <p class="sheet__title" id="diagnostic-report-title">Help improve MeowSSH?</p>
    <p class="sheet__body">
        MeowSSH saved an anonymized crash report on this device. You can send it in one tap, or review exactly what is included first.
    </p>

    <details class="diagnostic-prompt__details" data-testid="diagnostic-report-details">
        <summary>Review what’s included</summary>
        <div class="diagnostic-prompt__detail-body">
            <p class="sheet__body">
                Included: app version, platform, sanitized crash details, and recent high-level app actions.
                Not included: terminal contents, commands, host names, addresses, usernames, file names, passwords, keys, or account identifiers.
            </p>

            <dl class="diagnostic-prompt__metadata">
                <div>
                    <dt>App</dt>
                    <dd class="mono">@Report.AppVersion</dd>
                </div>
                <div>
                    <dt>Platform</dt>
                    <dd>@Report.Platform</dd>
                </div>
                <div>
                    <dt>Captured</dt>
                    <dd>@Report.CapturedAtUtc.ToLocalTime().ToString("g")</dd>
                </div>
            </dl>

            @if (Report.Exceptions.Count > 0)
            {
                <div class="diagnostic-prompt__crash" data-testid="diagnostic-exception-summary">
                    <p class="diagnostic-prompt__label">Crash</p>
                    <p class="mono diagnostic-prompt__type">@Report.Exceptions[0].Type</p>
                    @if (!string.IsNullOrWhiteSpace(Report.Exceptions[0].Message))
                    {
                        <pre class="diagnostic-prompt__technical">@Report.Exceptions[0].Message</pre>
                    }
                </div>
            }

            @if (Report.Breadcrumbs.Count > 0)
            {
                <div class="diagnostic-prompt__breadcrumbs">
                    <p class="diagnostic-prompt__label">Recent app actions</p>
                    <ul>
                        @foreach (var breadcrumb in Report.Breadcrumbs)
                        {
                            <li>@FriendlyBreadcrumb(breadcrumb.Kind)</li>
                        }
                    </ul>
                </div>
            }

            <button type="button" class="btn btn--ghost btn--block diagnostic-prompt__discard"
                    data-testid="discard-diagnostic-report" @onclick="OnDiscard">
                Discard report
            </button>
        </div>
    </details>

    <div class="form__actions diagnostic-prompt__actions">
        <button type="button" class="btn btn--primary btn--block"
                data-testid="send-diagnostic-report" disabled="@Busy" @onclick="OnSend">
            @(Busy ? "Sending…" : "Send anonymized report")
        </button>
        <button type="button" class="btn btn--ghost btn--block"
                data-testid="dismiss-diagnostic-report" disabled="@Busy" @onclick="OnDismiss">
            Not now
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public DiagnosticReportSnapshot Report { get; set; } = default!;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnSend { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }
    [Parameter] public EventCallback OnDiscard { get; set; }

    private static string FriendlyBreadcrumb(DiagnosticBreadcrumbKind kind) => kind switch
    {
        DiagnosticBreadcrumbKind.AppStarted => "App opened",
        DiagnosticBreadcrumbKind.OpenedSettings => "Opened Settings",
        DiagnosticBreadcrumbKind.OpenedHostEditor => "Opened host editor",
        DiagnosticBreadcrumbKind.OpenedSftp => "Opened Files",
        DiagnosticBreadcrumbKind.StartedSftpUpload => "Started a file upload",
        DiagnosticBreadcrumbKind.StartedSftpDownload => "Started a file download",
        DiagnosticBreadcrumbKind.StartedSshSession => "Started an SSH session",
        DiagnosticBreadcrumbKind.ClosedSshSession => "Closed an SSH session",
        DiagnosticBreadcrumbKind.PurchaseFlowStarted => "Started a purchase",
        DiagnosticBreadcrumbKind.RestorePurchasesStarted => "Started purchase restore",
        _ => "App action",
    };
}
