@using MeowSSH.UI.Services
@inject ITailcatHubService Hub
@inject ITailcatIdentityStore IdentityStore
@inject IHostEditor Editor

<div class="tailcat-stack">
    @if (_error is not null) { <p class="lock__error" role="alert">@_error</p> }
    @if (_notice is not null) { <p class="note" role="status">@_notice</p> }
    @if (Hub.Snapshot.Server is { } server)
    {
        <article class="tailcat-card" data-testid="tailcat-server-running">
            <h2>This phone is shared</h2>
            <label class="field"><span class="field__label">Tailcat address</span><textarea class="field__input mono" rows="4" readonly data-testid="tailcat-server-address">@server.Address</textarea></label>
            <p>@(server.ExitNodeEnabled ? "Exit node · " : "")@(server.AllowsAnyClient ? "INSECURE: any Tailcat client · " : "")@(server.ShellEnabled ? (server.UseTailcatCredentialForShell ? "Shell (Tailcat credential only) · " : "Shell · ") : "")@(server.FilesEnabled ? $"Files ({server.FileMode}) · " : "")@(server.ServeTargets.Count > 0 ? $"Services: {string.Join(", ", server.ServeTargets)}" : "")</p>
            <p class="field__hint">Expires @server.ExpiresAt.ToLocalTime().ToString("g"). Treat the address as a secret credential.</p>
            <button class="btn btn--danger btn--block" disabled="@_busy" data-testid="stop-tailcat-server" @onclick="StopAsync">Stop sharing</button>
        </article>
    }
    else
    {
        <article class="tailcat-card">
            <h2>Share this phone</h2>
            @if (!_allowAnyClient && _savedTailcatClientKeys.Count > 0)
            {
                <fieldset class="field" data-testid="tailcat-saved-client-keys">
                    <legend class="field__label">Saved Tailcat identities allowed to connect</legend>
                    @foreach (var key in _savedTailcatClientKeys)
                    {
                        <label class="forward-option"><input type="checkbox" data-testid="tailcat-saved-client-key" checked="@_selectedTailcatClientNames.Contains(key.Name)" @onchange="e => SetSavedTailcatClient(key.Name, e.Value is true)" /><span><strong>@key.Name</strong><small class="mono tailcat-break">@key.PublicKey</small></span></label>
                    }
                    <span class="field__hint">Only the public <span class="mono">nodekey:</span> value is sent to the server allowlist.</span>
                </fieldset>
            }
            <label class="field"><span class="field__label">Additional Tailcat client keys</span><textarea class="field__input mono" rows="3" data-testid="tailcat-allowed-clients" placeholder="nodekey:..." disabled="@_allowAnyClient" @bind="_allowedClients" @bind:event="oninput"></textarea><span class="field__hint">@(_allowAnyClient ? "Disabled while insecure mode is selected." : "Optional when a saved Tailcat identity is selected. Comma-separate additional nodekey: public keys.")</span></label>
            <label class="field"><span class="field__label">Lifetime (hours)</span><input class="field__input" type="number" min="1" max="24" data-testid="tailcat-lifetime" @bind="_hours" /></label>
            <label class="forward-option"><input type="checkbox" data-testid="tailcat-exit-node" @bind="_exitNode" /><span><strong>Exit node</strong><small>Allow approved Tailcat clients to route through this phone.</small></span></label>
            @if (_exitNode)
            {
                @* Security-reducing, so it does not get the same treatment as "Share a
                   folder" two rows below it. is-risky paints the box in the danger
                   colour once it is on, and forward-option--risky carries a matching
                   rail so the row reads as different before it is even read. *@
                <label class="forward-option forward-option--risky"><input type="checkbox" class="is-risky" data-testid="tailcat-insecure-exit-node" @bind="_allowAnyClient" /><span><strong>Insecure: allow any Tailcat client</strong><small>Anyone who learns this address can route traffic through your phone. Disables the client-key allowlist.</small></span></label>
                @if (_allowAnyClient)
                {
                    <div class="tailcat-danger-warning" role="alert" data-testid="tailcat-insecure-warning"><strong>Warning: this removes Tailcat client authentication.</strong><p>Anyone who obtains this Tailcat address can connect and route traffic through this phone. Other enabled services are also no longer protected by the Tailcat client-key allowlist.</p><label class="forward-option"><input type="checkbox" data-testid="tailcat-insecure-confirm" @bind="_insecureConfirmed" /><span><strong>I understand the risk</strong><small>Required before starting an insecure exit node.</small></span></label></div>
                }
            }
            <label class="forward-option"><input type="checkbox" data-testid="tailcat-shell" @bind="_shell" /><span><strong>Remote shell</strong><small>Expose a shell over the encrypted Tailcat tunnel.</small></span></label>
            @if (_shell)
            {
                <label class="forward-option"><input type="checkbox" data-testid="tailcat-insecure-shell" @bind="_useTailcatCredentialForShell" /><span><strong>Insecure shell: no SSH keys</strong><small>Use possession of the Tailcat tunnel credential instead of SSH authorized keys.</small></span></label>
                @if (_useTailcatCredentialForShell)
                {
                    <div class="tailcat-danger-warning" role="alert" data-testid="tailcat-insecure-shell-warning"><strong>Warning: the Tailcat address is the shell credential.</strong><p>The WireGuard tunnel remains encrypted. Anyone who obtains this Tailcat address can get a shell unless a Tailcat client-key allowlist also restricts access.</p><label class="forward-option"><input type="checkbox" data-testid="tailcat-insecure-shell-confirm" @bind="_insecureShellConfirmed" /><span><strong>I understand the risk</strong><small>Required before starting a shell without SSH authorized keys.</small></span></label></div>
                }
                else
                {
                    @if (_sshPublicKeys.Count > 0)
                    {
                        <fieldset class="field" data-testid="tailcat-saved-ssh-keys"><legend class="field__label">Saved SSH public keys</legend>@foreach (var credential in _sshPublicKeys){<label class="forward-option"><input type="checkbox" data-testid="tailcat-saved-ssh-key" checked="@_selectedSshKeyIds.Contains(credential.Id)" @onchange="e => SetSavedSshKey(credential.Id, e.Value is true)" /><span><strong>@credential.Label</strong><small class="mono">@credential.DisplayHint</small></span></label>}<span class="field__hint">Selected keys are added to authorized_keys. Private key material never leaves the vault.</span></fieldset>
                    }
                    <label class="field"><span class="field__label">Additional authorized SSH keys</span><textarea class="field__input mono" rows="3" data-testid="tailcat-authorized-ssh" placeholder="ssh-ed25519 AAAA..." @bind="_authorizedSsh" @bind:event="oninput"></textarea></label>
                }
            }
            <label class="forward-option"><input type="checkbox" data-testid="tailcat-files" @bind="_files" /><span><strong>Share a folder</strong><small>Expose one directory over Tailcat SFTP.</small></span></label>
            @if (_files)
            {
                <label class="field"><span class="field__label">Folder path</span><input class="field__input mono" data-testid="tailcat-share-path" @bind="_folder" @bind:event="oninput" /></label>
                <label class="field"><span class="field__label">Access</span><select class="field__input" data-testid="tailcat-file-mode" @bind="_fileMode"><option value="ro">Read only</option><option value="rw">Read / write</option><option value="wo">Upload only</option><option value="wo+">Upload + directories</option></select></label>
            }
            <label class="field"><span class="field__label">Additional services</span><textarea class="field__input mono" rows="2" data-testid="tailcat-serve-targets" placeholder="80,443,8000-8010" @bind="_serveTargets" @bind:event="oninput"></textarea><span class="field__hint">Comma- or line-separated Tailcat serve targets. Ports, ranges, and <span class="mono">all</span> are passed directly to Tailcat.</span></label>
            @if (ServeTargetList.Any(target => string.Equals(target, "all", StringComparison.OrdinalIgnoreCase)))
            {
                <p class="tailcat-danger-warning" role="alert" data-testid="tailcat-serve-all-warning"><strong>Serving all ports exposes every reachable local service through this Tailcat address.</strong></p>
            }

            <details class="tailcat-advanced" data-testid="tailcat-server-address-options">
                <summary>Address and DERP options</summary>
                <div class="tailcat-stack">
                    @if (_savedTailcatIdentities.Count > 0)
                    {
                        <label class="field"><span class="field__label">Server identity</span><select class="field__input" data-testid="tailcat-server-identity" @bind="_serverIdentityName"><option value="">Ephemeral — new address each start</option>@foreach (var name in _savedTailcatIdentities){<option value="@name">@name</option>}</select><span class="field__hint">A saved identity gives this phone a stable/reusable Tailcat address across restarts.</span></label>
                        @if (!string.IsNullOrWhiteSpace(_serverIdentityName)) { <div class="tailcat-danger-warning" role="note" data-testid="tailcat-persistent-identity-warning"><strong>Persistent address selected.</strong><p>Anyone who has received this identity's address may try it again on future starts.</p></div> }
                    }
                    <label class="forward-option"><input type="checkbox" data-testid="tailcat-full-address" @bind="_fullAddress" /><span><strong>Embed DERP details in address</strong><small>Publish a self-contained/full Tailcat address.</small></span></label>
                    <label class="forward-option"><input type="checkbox" data-testid="tailcat-use-psk" @bind="_usePresharedKey" /><span><strong>Embed WireGuard pre-shared key</strong><small>Recommended. Adds a PSK in addition to WireGuard public-key authentication.</small></span></label>
                    <label class="field"><span class="field__label">Custom DERP map URL</span><input class="field__input mono" data-testid="tailcat-server-derpmap" placeholder="https://…/derpmap/default" @bind="_derpMapUrl" @bind:event="oninput" /></label>
                </div>
            </details>
            @if (_exitNode) { <p class="note"><Icon Name="alert" /> Only authorize client keys you trust.</p> }
            @*
                CanStart is eight conditions wide. Dimming the button and leaving
                the user to work out which one they have missed is not a design;
                the unmet one is named here.
            *@
            @if (!_busy && StartBlockedBecause is { } blocked)
            {
                <p class="form__hint" data-testid="start-tailcat-server-hint">@blocked</p>
            }
            <button class="btn btn--primary btn--block" disabled="@(_busy || !CanStart)" data-testid="start-tailcat-server" @onclick="StartAsync">Start sharing</button>
        </article>
    }
</div>

@code {
    private sealed record SavedTailcatClientKey(string Name, string PublicKey);
    private string _allowedClients = "";
    private IReadOnlyList<SavedTailcatClientKey> _savedTailcatClientKeys = [];
    private readonly HashSet<string> _selectedTailcatClientNames = new(StringComparer.Ordinal);
    private int _hours = 8;
    /// <summary>
    /// Off by default. An exit node routes other devices' traffic through this
    /// phone -- its battery, its data allowance, its IP address -- which is not
    /// something to switch on for someone who only opened the panel to look.
    /// </summary>
    private bool _exitNode;
    private bool _allowAnyClient;
    private bool _insecureConfirmed;
    private bool _shell;
    private bool _useTailcatCredentialForShell;
    private bool _insecureShellConfirmed;
    private string _authorizedSsh = "";
    private IReadOnlyList<CredentialSummary> _sshPublicKeys = [];
    private readonly HashSet<Guid> _selectedSshKeyIds = [];
    private bool _files;
    private string _folder = "";
    private string _fileMode = "ro";
    private string _serveTargets = "";
    private IReadOnlyList<string> _savedTailcatIdentities = [];
    private string _serverIdentityName = "";
    private bool _fullAddress;
    private bool _usePresharedKey = true;
    private string _derpMapUrl = "";
    private bool _busy;
    private string? _error;
    private string? _notice;

    private IReadOnlyList<string> ServeTargetList => [.. _serveTargets.Split([',', '\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct(StringComparer.Ordinal)];
    /// <summary>
    /// The unmet condition keeping <c>Start sharing</c> disabled, worded for the
    /// person configuring it — or null when it is ready to start.
    /// </summary>
    /// <remarks>
    /// Kept in the same order as <see cref="CanStart"/>'s clauses so the two
    /// cannot disagree about whether starting is possible.
    /// </remarks>
    private string? StartBlockedBecause
    {
        get
        {
            if (!_allowAnyClient && !HasAllowedTailcatClients)
                return "Choose a saved Tailcat identity, or paste a client key, to say who may connect.";
            if (!_exitNode && !_shell && !_files && ServeTargetList.Count == 0)
                return "Turn on at least one service — exit node, remote shell, a shared folder, or a port.";
            if (_allowAnyClient && !(_exitNode && _insecureConfirmed))
                return "Insecure mode needs the exit node enabled and its warning confirmed.";
            if (_useTailcatCredentialForShell && !(_shell && _insecureShellConfirmed))
                return "Using the Tailcat address as the shell credential needs the remote shell enabled and confirmed.";
            if (_shell && !_useTailcatCredentialForShell && !HasAuthorizedSshKeys)
                return "A remote shell needs an authorized SSH key, or the Tailcat credential option.";
            if (_files && string.IsNullOrWhiteSpace(_folder))
                return "Choose which folder to share.";
            if (_hours is < 1 or > 24)
                return "Sharing can run for between 1 and 24 hours.";
            return null;
        }
    }

    private bool CanStart => (_allowAnyClient || HasAllowedTailcatClients) && (_exitNode || _shell || _files || ServeTargetList.Count > 0)
        && (!_allowAnyClient || (_exitNode && _insecureConfirmed))
        && (!_useTailcatCredentialForShell || (_shell && _insecureShellConfirmed))
        && (!_shell || _useTailcatCredentialForShell || HasAuthorizedSshKeys) && (!_files || !string.IsNullOrWhiteSpace(_folder))
        && _hours is >= 1 and <= 24;
    private bool HasAllowedTailcatClients => !string.IsNullOrWhiteSpace(_allowedClients) || _selectedTailcatClientNames.Count > 0;
    private bool HasAuthorizedSshKeys => !string.IsNullOrWhiteSpace(_authorizedSsh) || _selectedSshKeyIds.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        _sshPublicKeys = [.. (await Editor.GetCredentialsAsync()).Where(c => !string.IsNullOrWhiteSpace(c.PublicKey)).OrderBy(c => c.Label, StringComparer.OrdinalIgnoreCase)];
        _savedTailcatIdentities = [.. (await Hub.ListKeysAsync()).OrderBy(name => name, StringComparer.OrdinalIgnoreCase)];
        var clientKeys = new List<SavedTailcatClientKey>();
        foreach (var name in _savedTailcatIdentities)
        {
            try { var publicKey = await Hub.GetClientPublicKeyAsync(name); if (publicKey.StartsWith("nodekey:", StringComparison.Ordinal)) clientKeys.Add(new SavedTailcatClientKey(name, publicKey.Trim())); }
            catch { }
        }
        _savedTailcatClientKeys = clientKeys;
    }
    private void SetSavedTailcatClient(string name, bool selected) { if (selected) _selectedTailcatClientNames.Add(name); else _selectedTailcatClientNames.Remove(name); }
    private string AllowedTailcatClientKeys()
    {
        var saved = _savedTailcatClientKeys.Where(key => _selectedTailcatClientNames.Contains(key.Name)).Select(key => key.PublicKey);
        var manual = _allowedClients.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return string.Join(',', saved.Concat(manual).Distinct(StringComparer.Ordinal));
    }
    private void SetSavedSshKey(Guid id, bool selected) { if (selected) _selectedSshKeyIds.Add(id); else _selectedSshKeyIds.Remove(id); }
    private string AuthorizedSshKeys()
    {
        var saved = _sshPublicKeys.Where(c => _selectedSshKeyIds.Contains(c.Id)).Select(c => c.PublicKey!).Where(key => !string.IsNullOrWhiteSpace(key));
        IEnumerable<string> manual = string.IsNullOrWhiteSpace(_authorizedSsh) ? Array.Empty<string>() : [_authorizedSsh.Trim()];
        return string.Join(Environment.NewLine, saved.Concat(manual));
    }
    // Session-lifetime (wakelock) accounting for the Tailcat server lives in
    // TailcatServerSessionLifetimeCoordinator, driven by the hub's own
    // Snapshot.Server rather than this panel's Start/Stop clicks -- see that
    // type's remarks for why a click-driven release here missed spontaneous
    // deadline expiry.
    private async Task StartAsync()
    {
        _busy = true; _error = _notice = null;
        try
        {
            var privateKeyJson = string.IsNullOrWhiteSpace(_serverIdentityName) ? null : await IdentityStore.ExportAsync(_serverIdentityName);
            await Hub.StartServerAsync(new TailcatServeRequest(TimeSpan.FromHours(_hours), AllowedTailcatClientKeys(), _shell, AuthorizedSshKeys(), _files, _folder, _fileMode, _exitNode,
                AllowAnyClient: _allowAnyClient, UseTailcatCredentialForShell: _useTailcatCredentialForShell, FullAddress: _fullAddress, UsePresharedKey: _usePresharedKey,
                DerpMapUrl: Empty(_derpMapUrl), PrivateKeyJson: privateKeyJson, ServeTargets: ServeTargetList));
            _notice = "Tailcat sharing started.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
    private async Task StopAsync()
    {
        _busy = true; _error = _notice = null;
        try { await Hub.StopServerAsync(); _notice = "Tailcat sharing stopped."; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
    private static string? Empty(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
