@using MeowSSH.UI.Services
@inject ITailcatHubService Hub
@inject IHostEditor Editor
@inject IActiveSessionLifetime SessionLifetime

<div class="tailcat-stack">
    @if (_error is not null) { <p class="lock__error" role="alert">@_error</p> }
    @if (_notice is not null) { <p class="note" role="status">@_notice</p> }
    @if (Hub.Snapshot.Server is { } server)
    {
        <article class="tailcat-card" data-testid="tailcat-server-running">
            <h2>This phone is shared</h2>
            <label class="field"><span class="field__label">Tailcat address</span><input class="field__input mono" readonly value="@server.Address" data-testid="tailcat-server-address" /></label>
            <p>@(server.ExitNodeEnabled ? "Exit node · " : "")@(server.AllowsAnyClient ? "INSECURE: any Tailcat client · " : "")@(server.ShellEnabled ? (server.UseTailcatCredentialForShell ? "Shell (Tailcat credential only) · " : "Shell · ") : "")@(server.FilesEnabled ? $"Files ({server.FileMode})" : "")</p>
            <p class="field__hint">Expires @server.ExpiresAt.ToLocalTime().ToString("g").</p>
            <button class="btn btn--danger btn--block" disabled="@_busy" data-testid="stop-tailcat-server" @onclick="StopAsync">Stop sharing</button>
        </article>
    }
    else
    {
        <article class="tailcat-card">
            <h2>Share this phone</h2>
            <label class="field"><span class="field__label">Allowed Tailcat client keys</span><textarea class="field__input mono" rows="3" data-testid="tailcat-allowed-clients" placeholder="nodekey:..." disabled="@_allowAnyClient" @bind="_allowedClients"></textarea><span class="field__hint">@(_allowAnyClient ? "Disabled while insecure mode is selected." : "Required. Comma-separate trusted client public keys.")</span></label>
            <label class="field"><span class="field__label">Lifetime (hours)</span><input class="field__input" type="number" min="1" max="24" data-testid="tailcat-lifetime" @bind="_hours" /></label>
            <label class="forward-option"><input type="checkbox" data-testid="tailcat-exit-node" @bind="_exitNode" /><span><strong>Exit node</strong><small>Allow approved Tailcat clients to route through this phone.</small></span></label>
            @if (_exitNode)
            {
                <label class="forward-option"><input type="checkbox" data-testid="tailcat-insecure-exit-node" @bind="_allowAnyClient" /><span><strong>Insecure: allow any Tailcat client</strong><small>Disable the Tailcat client-key allowlist for this exit node.</small></span></label>
                @if (_allowAnyClient)
                {
                    <div class="tailcat-danger-warning" role="alert" data-testid="tailcat-insecure-warning">
                        <strong>Warning: this removes Tailcat client authentication.</strong>
                        <p>Anyone who obtains this Tailcat address can connect and route traffic through this phone. If file sharing is enabled, that service is also no longer protected by the Tailcat client-key allowlist.</p>
                        <label class="forward-option"><input type="checkbox" data-testid="tailcat-insecure-confirm" @bind="_insecureConfirmed" /><span><strong>I understand the risk</strong><small>Required before starting an insecure exit node.</small></span></label>
                    </div>
                }
            }
            <label class="forward-option"><input type="checkbox" data-testid="tailcat-shell" @bind="_shell" /><span><strong>Remote shell</strong><small>Expose a shell over the encrypted Tailcat tunnel.</small></span></label>
            @if (_shell)
            {
                <label class="forward-option"><input type="checkbox" data-testid="tailcat-insecure-shell" @bind="_useTailcatCredentialForShell" /><span><strong>Insecure shell: no SSH keys</strong><small>Use possession of the Tailcat tunnel credential instead of SSH authorized keys.</small></span></label>
                @if (_useTailcatCredentialForShell)
                {
                    <div class="tailcat-danger-warning" role="alert" data-testid="tailcat-insecure-shell-warning">
                        <strong>Warning: the Tailcat address is the shell credential.</strong>
                        <p>The WireGuard tunnel remains encrypted. Anyone who obtains this Tailcat address can get a shell unless a Tailcat client-key allowlist also restricts access. Keep the address secret and never publish it in DNS or another public location.</p>
                        <label class="forward-option"><input type="checkbox" data-testid="tailcat-insecure-shell-confirm" @bind="_insecureShellConfirmed" /><span><strong>I understand the risk</strong><small>Required before starting a shell without SSH authorized keys.</small></span></label>
                    </div>
                }
                else
                {
                    @if (_sshPublicKeys.Count > 0)
                    {
                        <fieldset class="field" data-testid="tailcat-saved-ssh-keys">
                            <legend class="field__label">Saved SSH public keys</legend>
                            @foreach (var credential in _sshPublicKeys)
                            {
                                <label class="forward-option">
                                    <input type="checkbox"
                                           data-testid="tailcat-saved-ssh-key"
                                           checked="@_selectedSshKeyIds.Contains(credential.Id)"
                                           @onchange="e => SetSavedSshKey(credential.Id, e.Value is true)" />
                                    <span><strong>@credential.Label</strong><small class="mono">@credential.DisplayHint</small></span>
                                </label>
                            }
                            <span class="field__hint">Selected keys are added to the shell's authorized_keys list. Private key material never leaves the vault.</span>
                        </fieldset>
                    }
                    <label class="field"><span class="field__label">Additional authorized SSH keys</span><textarea class="field__input mono" rows="3" data-testid="tailcat-authorized-ssh" placeholder="ssh-ed25519 AAAA..." @bind="_authorizedSsh"></textarea><span class="field__hint">Optional when at least one saved public key is selected.</span></label>
                }
            }
            <label class="forward-option"><input type="checkbox" data-testid="tailcat-files" @bind="_files" /><span><strong>Share a folder</strong><small>Expose one directory over Tailcat SFTP.</small></span></label>
            @if (_files)
            {
                <label class="field"><span class="field__label">Folder path</span><input class="field__input mono" data-testid="tailcat-share-path" @bind="_folder" /></label>
                <label class="field"><span class="field__label">Access</span><select class="field__input" data-testid="tailcat-file-mode" @bind="_fileMode"><option value="ro">Read only</option><option value="rw">Read / write</option><option value="wo">Upload only</option><option value="wo+">Upload + directories</option></select></label>
            }
            @if (_exitNode) { <p class="note"><Icon Name="alert" /> Only authorize client keys you trust.</p> }
            <button class="btn btn--primary btn--block" disabled="@(_busy || !CanStart)" data-testid="start-tailcat-server" @onclick="StartAsync">Start sharing</button>
        </article>
    }
</div>

@code {
    private string _allowedClients = "";
    private int _hours = 8;
    private bool _exitNode = true;
    private bool _allowAnyClient;
    private bool _insecureConfirmed;
    private bool _shell;
    private bool _useTailcatCredentialForShell;
    private bool _insecureShellConfirmed;
    private string _authorizedSsh = "";
    private IReadOnlyList<CredentialSummary> _sshPublicKeys = [];
    private readonly HashSet<Guid> _selectedSshKeyIds = [];
    private bool _files;
    private string _folder = "";
    private string _fileMode = "ro";
    private bool _busy;
    private string? _error;
    private string? _notice;

    private bool CanStart => (_allowAnyClient || !string.IsNullOrWhiteSpace(_allowedClients)) && (_exitNode || _shell || _files)
        && (!_allowAnyClient || (_exitNode && _insecureConfirmed))
        && (!_useTailcatCredentialForShell || (_shell && _insecureShellConfirmed))
        && (!_shell || _useTailcatCredentialForShell || HasAuthorizedSshKeys) && (!_files || !string.IsNullOrWhiteSpace(_folder))
        && _hours is >= 1 and <= 24;

    private bool HasAuthorizedSshKeys => !string.IsNullOrWhiteSpace(_authorizedSsh) || _selectedSshKeyIds.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        _sshPublicKeys = [.. (await Editor.GetCredentialsAsync())
            .Where(c => !string.IsNullOrWhiteSpace(c.PublicKey))
            .OrderBy(c => c.Label, StringComparer.OrdinalIgnoreCase)];
    }

    private void SetSavedSshKey(Guid id, bool selected)
    {
        if (selected) _selectedSshKeyIds.Add(id);
        else _selectedSshKeyIds.Remove(id);
    }

    private string AuthorizedSshKeys()
    {
        var saved = _sshPublicKeys
            .Where(c => _selectedSshKeyIds.Contains(c.Id))
            .Select(c => c.PublicKey!)
            .Where(key => !string.IsNullOrWhiteSpace(key));
        IEnumerable<string> manual = string.IsNullOrWhiteSpace(_authorizedSsh)
            ? Array.Empty<string>()
            : [_authorizedSsh.Trim()];
        return string.Join(Environment.NewLine, saved.Concat(manual));
    }

    private bool HasLongLivedTailcat()
    {
        var s = Hub.Snapshot;
        return s.Server is not null || s.Socks is not null || s.Forwards.Count > 0;
    }

    private async Task StartAsync()
    {
        _busy = true; _error = _notice = null;
        var wasActive = HasLongLivedTailcat();
        try
        {
            if (!wasActive) await SessionLifetime.StartAsync();
            try { await Hub.StartServerAsync(new TailcatServeRequest(TimeSpan.FromHours(_hours), _allowedClients, _shell, AuthorizedSshKeys(), _files, _folder, _fileMode, _exitNode, _allowAnyClient, _useTailcatCredentialForShell)); }
            catch { if (!wasActive) await SessionLifetime.StopAsync(); throw; }
            _notice = "Tailcat sharing started.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task StopAsync()
    {
        _busy = true; _error = _notice = null;
        try { await Hub.StopServerAsync(); if (!HasLongLivedTailcat()) await SessionLifetime.StopAsync(); _notice = "Tailcat sharing stopped."; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
