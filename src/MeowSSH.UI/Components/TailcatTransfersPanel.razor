@inject ITailcatHubService Hub

<div class="tailcat-stack">
    @if (_error is not null) { <p class="lock__error" role="alert">@_error</p> }
    @if (_notice is not null) { <p class="note" role="status">@_notice</p> }
    <article class="tailcat-card">
        <h2>Remote files</h2>
        <label class="field"><span class="field__label">Tailcat server</span><input class="field__input mono" data-testid="tailcat-files-address" placeholder="tc… or DNS name" @bind="_address" /></label>
        <label class="field"><span class="field__label">Remote path</span><input class="field__input mono" data-testid="tailcat-files-path" placeholder="/" @bind="_remotePath" /></label>
        <button class="btn btn--primary btn--block" disabled="@(_busy || string.IsNullOrWhiteSpace(_address))" data-testid="tailcat-list-files" @onclick="ListAsync">List files</button>
        @foreach (var entry in _entries)
        {
            <div class="tailcat-running-row" data-testid="tailcat-file-row">
                <span><strong>@(entry.IsDirectory ? "Directory" : "File") · @entry.Name</strong><small>@entry.Mode · @(entry.Size?.ToString("N0") ?? "—") bytes · @(entry.ModifiedAt?.ToString("g") ?? "—")</small></span>
            </div>
        }
    </article>

    <article class="tailcat-card">
        <h2>Copy files</h2>
        <fieldset class="field"><legend class="field__label">Direction</legend><div class="segmented"><button type="button" class="segmented__option @(_upload ? "segmented__option--on" : "")" @onclick="() => _upload = true">Upload</button><button type="button" class="segmented__option @(!_upload ? "segmented__option--on" : "")" @onclick="() => _upload = false">Download</button></div></fieldset>
        <label class="field"><span class="field__label">Local path</span><input class="field__input mono" data-testid="tailcat-copy-local" @bind="_localPath" /></label>
        <label class="field"><span class="field__label">Remote path</span><input class="field__input mono" data-testid="tailcat-copy-remote" @bind="_copyRemotePath" /></label>
        <label class="forward-option"><input type="checkbox" @bind="_recursive" /><span><strong>Recursive</strong><small>Copy directories recursively.</small></span></label>
        <button class="btn btn--primary btn--block" disabled="@(_busy || string.IsNullOrWhiteSpace(_address) || string.IsNullOrWhiteSpace(_localPath))" data-testid="tailcat-copy" @onclick="CopyAsync">@(_upload ? "Upload" : "Download")</button>
    </article>
</div>

@code {
    private string _address = "";
    private string _remotePath = "/";
    private IReadOnlyList<TailcatRemoteFile> _entries = [];
    private bool _upload = true;
    private string _localPath = "";
    private string _copyRemotePath = "/";
    private bool _recursive;
    private bool _busy;
    private string? _error;
    private string? _notice;

    private async Task ListAsync() => await RunAsync(async () => _entries = await Hub.ListRemoteFilesAsync(_address, _remotePath));

    private async Task CopyAsync() => await RunAsync(async () =>
    {
        if (_upload) await Hub.UploadAsync(_localPath, _address, _copyRemotePath, _recursive);
        else await Hub.DownloadAsync(_address, _copyRemotePath, _localPath, _recursive);
        _notice = _upload ? "Upload completed." : "Download completed.";
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true; _error = _notice = null;
        try { await action(); } catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
