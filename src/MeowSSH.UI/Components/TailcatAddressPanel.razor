@inject ITailcatHubService Hub
@inject IHostDirectory Hosts
@inject IHostEditor Editor
@inject IJSRuntime Js

<div class="tailcat-stack">
    @if (_error is not null) { <p class="lock__error" role="alert">@_error</p> }
    @if (_notice is not null) { <p class="note" role="status">@_notice</p> }

    <article class="tailcat-card" data-testid="tailcat-address-tools">
        <h2>Address builder</h2>
        @if (_savedPeers.Count > 0)
        {
            <label class="field">
                <span class="field__label">Saved Tailcat peer</span>
                <select class="field__input" data-testid="tailcat-address-saved-peer" @onchange="SelectPeer">
                    <option value="">Choose a saved host…</option>
                    @foreach (var peer in _savedPeers)
                    {
                        <option value="@peer.Id">@peer.Label</option>
                    }
                </select>
            </label>
        }
        <label class="field">
            <span class="field__label">Tailcat address or DNS name</span>
            <textarea class="field__input mono" rows="4" data-testid="tailcat-address-input"
                      placeholder="tc… or host.example.com"
                      @bind="_address" @bind:event="oninput"></textarea>
            <span class="field__hint">Treat Tailcat addresses as secrets: possession can grant access depending on the server configuration.</span>
        </label>
        <label class="field">
            <span class="field__label">Custom DERP map URL</span>
            <input class="field__input mono" data-testid="tailcat-address-derpmap"
                   placeholder="https://…/derpmap/default"
                   @bind="_derpMapUrl" @bind:event="oninput" />
            <span class="field__hint">Optional. Leave blank for Tailcat's default map. Useful with private/custom DERP infrastructure.</span>
        </label>
        <div class="form__row">
            <button class="btn btn--primary field--grow" disabled="@(_busy || string.IsNullOrWhiteSpace(_address))"
                    data-testid="tailcat-resolve-address" @onclick="ResolveAsync">
                @(_busy ? "Working…" : "Embed DERP details")
            </button>
            <button class="btn btn--ghost field--grow" disabled="@(_busy || string.IsNullOrWhiteSpace(_address))"
                    data-testid="tailcat-inspect-address" @onclick="InspectAsync">Inspect</button>
        </div>

        @if (_resolvedAddress is not null)
        {
            <label class="field">
                <span class="field__label">Self-contained address</span>
                <textarea class="field__input field__input--code mono" rows="5" readonly
                          data-testid="tailcat-resolved-address">@_resolvedAddress</textarea>
                <span class="field__hint">This expanded address embeds the relay information needed by the client, so it does not need a DERP-map lookup.</span>
            </label>
            <button class="btn btn--ghost btn--block" data-testid="tailcat-copy-resolved-address"
                    @onclick="() => CopyAsync(_resolvedAddress)"><Icon Name="copy" /> Copy address</button>
        }
    </article>

    @if (_details is { } details)
    {
        <article class="tailcat-card" data-testid="tailcat-address-details">
            <h2>Address contents</h2>
            <dl class="tailcat-diagnostics">
                <dt>Server key</dt><dd class="mono tailcat-break">@details.ServerPublicKey</dd>
                <dt>Discovery key</dt><dd class="mono tailcat-break">@(details.ServerDiscoPublicKey ?? "—")</dd>
                <dt>Pre-shared key</dt><dd>@(details.HasPresharedKey ? "Embedded" : "Not embedded")</dd>
                <dt>Region reference</dt><dd>@(details.RegionId == 0 ? "Embedded / none" : details.RegionId.ToString())</dd>
                <dt>Embedded regions</dt><dd>@details.EmbeddedRegions.Count</dd>
            </dl>
            @foreach (var region in details.EmbeddedRegions)
            {
                <div class="tailcat-running-row" data-testid="tailcat-address-region">
                    <span>
                        <strong>@(region.Name ?? region.Code ?? $"Region {region.RegionId}")</strong>
                        <small>@region.Nodes.Count relay node@(region.Nodes.Count == 1 ? "" : "s")</small>
                    </span>
                </div>
                @foreach (var node in region.Nodes)
                {
                    <div class="tailcat-running-row" data-testid="tailcat-address-node">
                        <span>
                            <strong class="mono">@(node.HostName ?? node.IPv4 ?? node.IPv6 ?? node.Name ?? "DERP node")</strong>
                            <small>DERP @(node.DerpPort == 0 ? 443 : node.DerpPort) · STUN @(node.StunPort == 0 ? 3478 : node.StunPort)@(node.CertName is null ? "" : $" · cert {node.CertName}")</small>
                        </span>
                    </div>
                }
            }
        </article>
    }

    <article class="tailcat-card">
        <h2>Save peer</h2>
        <label class="field">
            <span class="field__label">Name</span>
            <input class="field__input" data-testid="tailcat-peer-name" placeholder="Home server"
                   @bind="_peerName" @bind:event="oninput" />
        </label>
        <button class="btn btn--ghost btn--block"
                disabled="@(_busy || string.IsNullOrWhiteSpace(_peerName) || string.IsNullOrWhiteSpace(AddressToSave))"
                data-testid="tailcat-save-peer" @onclick="SavePeerAsync">Save as Tailcat host</button>
        <p class="field__hint">Saved peers live in the encrypted MeowSSH vault and become available in Shell, Transfers, Forwarding and Diagnostics.</p>
    </article>
</div>

@code {
    private IReadOnlyList<HostRecord> _savedPeers = [];
    private string _address = "";
    private string _derpMapUrl = "";
    private string _peerName = "";
    private string? _resolvedAddress;
    private TailcatAddressDetails? _details;
    private bool _busy;
    private string? _error;
    private string? _notice;

    private string AddressToSave => _resolvedAddress ?? _address;

    protected override async Task OnInitializedAsync() => await ReloadPeersAsync();

    private async Task ReloadPeersAsync()
    {
        _savedPeers = [.. (await Hosts.GetHostsAsync())
            .Select(status => status.Host)
            .Where(host => !host.IsDeleted && host.Protocol == HostProtocol.Ssh && host.Transport == SshTransport.Tailcat)
            .OrderBy(host => host.Label, StringComparer.OrdinalIgnoreCase)];
    }

    private void SelectPeer(ChangeEventArgs args)
    {
        if (!Guid.TryParse(args.Value?.ToString(), out var id)) return;
        var peer = _savedPeers.FirstOrDefault(host => host.Id == id);
        if (peer is null) return;
        _address = peer.Address;
        _peerName = peer.Label;
        _resolvedAddress = null;
        _details = null;
    }

    private async Task ResolveAsync() => await RunAsync(async () =>
    {
        _resolvedAddress = await Hub.ResolveAddressAsync(_address, Empty(_derpMapUrl));
        _details = null;
        _notice = "Expanded address ready. Keep it secret like the original address.";
    });

    private async Task InspectAsync() => await RunAsync(async () =>
    {
        _details = await Hub.InspectAddressAsync(_address, Empty(_derpMapUrl));
        _resolvedAddress = _details.ResolvedAddress;
    });

    private async Task SavePeerAsync() => await RunAsync(async () =>
    {
        await Editor.SaveHostAsync(new HostRecord
        {
            Id = Guid.NewGuid(),
            Label = _peerName.Trim(),
            Address = AddressToSave.Trim(),
            Protocol = HostProtocol.Ssh,
            Transport = SshTransport.Tailcat,
            Port = 22,
            AutoReconnect = true,
            Tags = ["tailcat"],
        });
        await ReloadPeersAsync();
        _notice = $"Saved {_peerName.Trim()}.";
    });

    private async Task CopyAsync(string text)
    {
        await using var clipboard = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/MeowSSH.UI/js/clipboard.js");
        await clipboard.InvokeAsync<bool>("copyText", text);
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = _notice = null;
        try { await action(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private static string? Empty(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
