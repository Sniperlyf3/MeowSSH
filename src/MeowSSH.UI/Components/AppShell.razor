@inject ICommandMonitoringService Monitoring

<div class="app">
    <header class="topbar">
        <h1 class="topbar__title">@CurrentTitle</h1>
        <div class="topbar__actions">
            @if (_activeTool is not null)
            {
                <button type="button" class="btn btn--ghost" data-testid="tools-back"
                        aria-label="Back to Tools"
                        @onclick="ShowToolsHub">Tools</button>
            }
            else if (!_showToolsHub)
            {
                @Actions
            }
        </div>
    </header>

    <main class="app__body" data-testid="app-body">
        @if (_showToolsHub)
        {
            <ToolsHubPage OnSelected="OpenTool" />
        }
        else if (_activeTool == "tailcat")
        {
            <TailcatHubPanel />
        }
        else if (_activeTool == "actions")
        {
            <ActionsPage OnNavigateToHosts="@(() => SelectTabAsync("hosts"))" />
        }
        else if (_activeTool == "monitoring")
        {
            <CommandMonitoringPage OnNavigateToHosts="@(() => SelectTabAsync("hosts"))" />
        }
        else if (_activeTool == "heartbeats")
        {
            <HeartbeatMonitorsPage />
        }
        else if (_activeTool == "health")
        {
            <HostHealthDashboardPage OnNavigateToHosts="@(() => SelectTabAsync("hosts"))" />
        }
        else if (_activeTool == "backup")
        {
            <EncryptedBackupPage />
        }
        else if (_activeTool == "transferqueue")
        {
            <TransferQueuePage />
        }
        else
        {
            @ChildContent
        }
    </main>

    <nav class="tabbar" aria-label="Main">
        @foreach (var tab in Tabs)
        {
            var active = tab.Id == CurrentTab;
            <button type="button"
                    class="tabbar__tab @(active ? "is-active" : "")"
                    aria-current="@(active ? "page" : null)"
                    data-testid="tab-@tab.Id"
                    @onclick="() => SelectTabAsync(tab.Id)">
                <Icon Name="@tab.Icon" />
                @tab.Label
            </button>
        }
    </nav>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string ActiveTab { get; set; } = "hosts";
    [Parameter] public EventCallback<string> OnTabSelected { get; set; }

    private bool _showToolsHub;
    private string? _activeTool;

    private string CurrentTitle => _activeTool switch
    {
        "tailcat" => "Tailcat",
        "actions" => "Actions",
        "monitoring" => "Monitoring",
        "health" => "Host Health",
        "heartbeats" => "Heartbeats",
        "backup" => "Backup",
        "transferqueue" => "Transfer Queue",
        _ when _showToolsHub => "Tools",
        _ => Title,
    };

    private string CurrentTab => _showToolsHub || _activeTool is not null ? "tools" : ActiveTab;

    protected override Task OnInitializedAsync() => Monitoring.InitializeAsync();

    private async Task SelectTabAsync(string tab)
    {
        if (tab == "tools")
        {
            ShowToolsHub();
            return;
        }

        _showToolsHub = false;
        _activeTool = null;
        await OnTabSelected.InvokeAsync(tab);
    }

    private void ShowToolsHub()
    {
        _activeTool = null;
        _showToolsHub = true;
    }

    private void OpenTool(string tool)
    {
        _showToolsHub = false;
        _activeTool = tool;
    }

    private sealed record Tab(string Id, string Label, string Icon);

    private static readonly Tab[] Tabs =
    [
        new("hosts", "Hosts", "terminal"),
        new("files", "Files", "folder"),
        new("tools", "Tools", "tools"),
        new("keys", "Keys", "key"),
        new("settings", "Settings", "settings"),
    ];
}
