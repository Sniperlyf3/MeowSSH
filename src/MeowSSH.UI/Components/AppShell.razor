@inject ICommandMonitoringService Monitoring

<div class="app">
    <header class="topbar">
        <h1 class="topbar__title">@CurrentTitle</h1>
        <div class="topbar__actions">@((_showTailcat || _showActions || _showMonitoring || _showHealth || _showBackup) ? null : Actions)</div>
    </header>

    <main class="app__body" data-testid="app-body">
        @if (_showTailcat)
        {
            <TailcatHubPanel />
        }
        else if (_showActions)
        {
            <ActionsPage />
        }
        else if (_showMonitoring)
        {
            <CommandMonitoringPage />
        }
        else if (_showHealth)
        {
            <HostHealthDashboardPage />
        }
        else if (_showBackup)
        {
            <EncryptedBackupPage />
        }
        else
        {
            @ChildContent
        }
    </main>

    <nav class="tabbar" aria-label="Main">
        @foreach (var tab in Tabs)
        {
            var active = tab.Id == CurrentTab;
            <button type="button"
                    class="tabbar__tab @(active ? "is-active" : "")"
                    aria-current="@(active ? "page" : null)"
                    data-testid="tab-@tab.Id"
                    @onclick="() => SelectTabAsync(tab.Id)">
                <Icon Name="@tab.Icon" />
                @tab.Label
            </button>
        }
    </nav>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string ActiveTab { get; set; } = "hosts";
    [Parameter] public EventCallback<string> OnTabSelected { get; set; }

    private bool _showTailcat;
    private bool _showActions;
    private bool _showMonitoring;
    private bool _showHealth;
    private bool _showBackup;
    private string CurrentTitle => _showTailcat ? "Tailcat" : _showActions ? "Actions" : _showMonitoring ? "Monitoring" : _showHealth ? "Host Health" : _showBackup ? "Backup" : Title;
    private string CurrentTab => _showTailcat ? "tailcat" : _showActions ? "actions" : _showMonitoring ? "monitoring" : _showHealth ? "health" : _showBackup ? "backup" : ActiveTab;

    protected override Task OnInitializedAsync() => Monitoring.InitializeAsync();

    private async Task SelectTabAsync(string tab)
    {
        if (tab == "tailcat")
        {
            ShowInternal(tailcat: true);
            return;
        }
        if (tab == "actions")
        {
            ShowInternal(actions: true);
            return;
        }
        if (tab == "monitoring")
        {
            ShowInternal(monitoring: true);
            return;
        }
        if (tab == "health")
        {
            ShowInternal(health: true);
            return;
        }
        if (tab == "backup")
        {
            ShowInternal(backup: true);
            return;
        }

        ShowInternal();
        await OnTabSelected.InvokeAsync(tab);
    }

    private void ShowInternal(
        bool tailcat = false,
        bool actions = false,
        bool monitoring = false,
        bool health = false,
        bool backup = false)
    {
        _showTailcat = tailcat;
        _showActions = actions;
        _showMonitoring = monitoring;
        _showHealth = health;
        _showBackup = backup;
    }

    private sealed record Tab(string Id, string Label, string Icon);

    private static readonly Tab[] Tabs =
    [
        new("hosts", "Hosts", "terminal"),
        new("files", "Files", "folder"),
        new("actions", "Actions", "terminal"),
        new("monitoring", "Monitor", "alert"),
        new("health", "Health", "alert"),
        new("tailcat", "Tailcat", "network"),
        new("backup", "Backup", "shield"),
        new("keys", "Keys", "key"),
        new("settings", "Settings", "settings"),
    ];
}
