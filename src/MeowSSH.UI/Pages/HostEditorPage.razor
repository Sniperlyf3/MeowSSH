@inject IHostEditor Editor
@inject IHostDirectory Hosts
@inject ISerialDeviceService SerialDevices
@inject IEntitlementService Entitlements

<AppShell Title="@(IsNew ? "New connection" : "Edit connection")" ActiveTab="hosts">
    <Actions>
        <button type="button" class="btn btn--icon" aria-label="Cancel"
                data-testid="cancel-host" @onclick="OnCancelled">
            <Icon Name="close" />
        </button>
    </Actions>

    <ChildContent>
        <div class="form host-editor" data-testid="host-editor">
            <label class="field">
                <span class="field__label">Name</span>
                <input class="field__input" type="text" data-testid="host-label"
                       placeholder="build-01" autocomplete="off" spellcheck="false"
                       @bind="_label" @bind:event="oninput" />
                <span class="field__hint">What you will call this connection in the list.</span>
            </label>

            <label class="field">
                <span class="field__label">Protocol</span>
                <select class="field__input" data-testid="host-protocol"
                        value="@_protocol" @onchange="OnProtocolChanged">
                    @foreach (var option in Protocols)
                    {
                        <option value="@option.Value">@option.Label</option>
                    }
                </select>
                <span class="field__hint">@ProtocolHint</span>
            </label>

            @if (_protocol == HostProtocol.Ssh)
            {
                <label class="field">
                    <span class="field__label">Connection method</span>
                    <select class="field__input" data-testid="host-transport"
                            value="@_transport" @onchange="OnTransportChanged">
                        @foreach (var option in Transports)
                        {
                            <option value="@option.Value">@option.Label</option>
                        }
                    </select>
                    <span class="field__hint">@TransportHint</span>
                </label>
            }

            @if (_protocol == HostProtocol.Serial)
            {
                <label class="field">
                    <span class="field__label">USB serial device</span>
                    <select class="field__input" data-testid="serial-device" @bind="_address">
                        <option value="">Select a connected device</option>
                        @if (!string.IsNullOrWhiteSpace(_address) && !_serialDevices.Any(d => d.Id == _address))
                        {
                            <option value="@_address">Saved device (currently unavailable)</option>
                        }
                        @foreach (var device in _serialDevices)
                        {
                            <option value="@device.Id">@device.Label</option>
                        }
                    </select>
                    <button type="button" class="btn btn--ghost" data-testid="refresh-serial-devices"
                            @onclick="RefreshSerialDevicesAsync">Refresh devices</button>
                </label>

                <div class="form__row">
                    <label class="field field--grow">
                        <span class="field__label">Baud rate</span>
                        <input class="field__input mono" type="number" min="1" data-testid="serial-baud"
                               @bind="_serialBaudRate" />
                    </label>
                    <label class="field field--narrow">
                        <span class="field__label">Data bits</span>
                        <select class="field__input" data-testid="serial-data-bits" @bind="_serialDataBits">
                            <option value="5">5</option><option value="6">6</option><option value="7">7</option><option value="8">8</option>
                        </select>
                    </label>
                </div>
                <div class="form__row">
                    <label class="field field--grow">
                        <span class="field__label">Parity</span>
                        <select class="field__input" data-testid="serial-parity" @bind="_serialParity">
                            @foreach (var value in Enum.GetValues<SerialParity>())
                            {
                                <option value="@value">@value</option>
                            }
                        </select>
                    </label>
                    <label class="field field--grow">
                        <span class="field__label">Stop bits</span>
                        <select class="field__input" data-testid="serial-stop-bits" @bind="_serialStopBits">
                            <option value="@SerialStopBits.One">1</option>
                            <option value="@SerialStopBits.OnePointFive">1.5</option>
                            <option value="@SerialStopBits.Two">2</option>
                        </select>
                    </label>
                </div>
            }
            else if (_protocol != HostProtocol.Local)
            {
                <label class="field">
                    <span class="field__label">@AddressLabel</span>
                    <input class="field__input mono" type="text" data-testid="host-address"
                           placeholder="@AddressPlaceholder" autocomplete="off"
                           autocapitalize="none" spellcheck="false"
                           @bind="_address" @bind:event="oninput" />
                </label>

                @if (_protocol is HostProtocol.Ssh or HostProtocol.Mosh or HostProtocol.Telnet)
                {
                    <div class="form__row">
                        @if (_protocol is HostProtocol.Ssh or HostProtocol.Mosh && _transport != SshTransport.Tailcat)
                        {
                            <label class="field field--grow">
                                <span class="field__label">Username</span>
                                <input class="field__input mono" type="text" data-testid="host-username"
                                       placeholder="deploy" autocomplete="off"
                                       autocapitalize="none" spellcheck="false"
                                       @bind="_username" @bind:event="oninput" />
                            </label>
                        }
                        @if (!(_protocol == HostProtocol.Ssh && _transport == SshTransport.Tailcat))
                        {
                            <label class="field field--narrow">
                                <span class="field__label">@(_protocol == HostProtocol.Mosh ? "SSH port" : "Port")</span>
                                <input class="field__input mono" type="number" inputmode="numeric"
                                       min="1" max="65535" data-testid="host-port"
                                       @bind="_port" @bind:event="oninput" />
                            </label>
                        }
                    </div>
                }
            }

            @if (_protocol == HostProtocol.Telnet)
            {
                <p class="note" data-testid="telnet-warning">
                    <Icon Name="alert" />
                    Telnet is unencrypted. Usernames, passwords and terminal traffic can be read or changed by anyone able to intercept the connection.
                </p>
            }

            @if (UsesSshCredentials)
            {
                <label class="field">
                    <span class="field__label">Sign in with</span>
                    <select class="field__input" data-testid="host-credential" @bind="_credentialId">
                        <option value="">Ask me each time</option>
                        @foreach (var credential in _credentials)
                        {
                            <option value="@credential.Id">@credential.Label — @credential.DisplayHint</option>
                        }
                    </select>
                    <span class="field__hint">
                        @(_credentials.Count == 0
                            ? "No saved keys or passwords yet. Add one on the Keys tab."
                            : "Stored in the vault and unsealed only while connecting.")
                    </span>
                </label>
            }
            else if (_protocol == HostProtocol.Ssh && _transport == SshTransport.TailscaleSsh)
            {
                <p class="note" data-testid="tailscale-note">
                    <Icon Name="shield" />
                    Tailscale SSH authenticates with your tailnet identity. Tailscale must be connected on this device.
                </p>
            }

            <details class="host-editor__section" data-testid="host-organisation" open="@HasOrganisationSettings">
                <summary>
                    <span>
                        <strong>Organisation</strong>
                        <small>Group, tags, favorite and terminal theme</small>
                    </span>
                    <Icon Name="chevron" />
                </summary>
                <div class="host-editor__section-body">
                    <label class="field">
                        <span class="field__label">Group</span>
                        <input class="field__input" type="text" data-testid="host-group"
                               placeholder="Production" autocomplete="off" spellcheck="false"
                               @bind="_group" @bind:event="oninput" />
                        <span class="field__hint">Optional. Hosts in the same group are kept together in the host list.</span>
                    </label>

                    <label class="field">
                        <span class="field__label">Tags</span>
                        <input class="field__input" type="text" data-testid="host-tags"
                               placeholder="prod, eu-west, database" autocomplete="off" spellcheck="false"
                               @bind="_tags" @bind:event="oninput" />
                        <span class="field__hint">Comma-separated tags are searchable from the Hosts screen.</span>
                    </label>

                    <label class="forward-option">
                        <input type="checkbox" data-testid="host-favorite" @bind="_isFavorite" />
                        <span>
                            <strong>Favorite</strong>
                            <small>Keep this host in a Favorites section near the top of the list.</small>
                        </span>
                    </label>

                    @if (_protocol != HostProtocol.Local)
                    {
                        var themesUnlocked = Entitlements.Has(PremiumFeature.PremiumCustomization);
                        <label class="field">
                            <span class="field__label">Terminal theme <span class="action-pro-badge">PRO</span></span>
                            <select class="field__input" data-testid="host-terminal-theme"
                                    disabled="@(!themesUnlocked)" @bind="_terminalTheme">
                                <option value="">App theme</option>
                                @foreach (var option in TerminalThemeCatalog.All)
                                {
                                    <option value="@option.Id">@option.Name</option>
                                }
                                <option value="@TerminalThemeCatalog.CustomId">Custom</option>
                            </select>
                            <span class="field__hint" data-testid="host-terminal-theme-hint">@(themesUnlocked
                                ? "Sessions to this host always open in this theme — try Production Red for live systems."
                                : "A per-host theme is part of MeowSSH Pro. Sessions use the app theme.")</span>
                        </label>
                    }
                </div>
            </details>

            @if (_protocol != HostProtocol.Local)
            {
                <details class="host-editor__section" data-testid="host-advanced" open="@HasAdvancedSettings">
                    <summary>
                        <span>
                            <strong>Advanced connection</strong>
                            <small>Jump host, proxy and reconnect behavior</small>
                        </span>
                        <Icon Name="chevron" />
                    </summary>
                    <div class="host-editor__section-body">
                        @if (_protocol == HostProtocol.Ssh)
                        {
                            <label class="field">
                                <span class="field__label">Jump host</span>
                                <select class="field__input" data-testid="jump-host" @bind="_jumpHostId">
                                    <option value="">Direct connection</option>
                                    @foreach (var jump in _jumpHosts)
                                    {
                                        <option value="@jump.Id">@jump.Label — @jump.DisplayAddress</option>
                                    }
                                </select>
                                <span class="field__hint">Optional. Connect through another saved SSH host first.</span>
                            </label>

                            <label class="forward-option">
                                <input type="checkbox" data-testid="forward-agent" @bind="_forwardAgent" />
                                <span>
                                    <strong>Forward SSH agent</strong>
                                    <small>Lets the remote session request signatures without sending the private key to the server.</small>
                                </span>
                            </label>
                        }

                        @if (SupportsProxy)
                        {
                            <label class="field">
                                <span class="field__label">Upstream proxy</span>
                                <input class="field__input mono" type="text" data-testid="ssh-proxy-url"
                                       placeholder="socks5://127.0.0.1:1080" autocomplete="off"
                                       autocapitalize="none" spellcheck="false"
                                       @bind="_proxyUrl" @bind:event="oninput" />
                                <span class="field__hint">Optional. Route the first SSH hop through a SOCKS5 or HTTP CONNECT proxy.</span>
                                @if (!ProxyIsValid)
                                {
                                    <span class="field__error" data-testid="ssh-proxy-validation">Use a socks5:// or http:// proxy URL.</span>
                                }
                            </label>
                        }

                        <label class="forward-option">
                            <input type="checkbox" data-testid="auto-reconnect" @bind="_autoReconnect" />
                            <span>
                                <strong>Automatically reconnect</strong>
                                <small>Retries unexpected disconnects with exponential backoff. Authentication and host-key failures are not retried.</small>
                            </span>
                        </label>
                    </div>
                </details>
            }

            @if (_error is not null)
            {
                <p class="lock__error" role="alert" data-testid="host-error">@_error</p>
            }

            @*
                A dimmed primary button with nothing beside it is a dead end: the
                user can see the thing they want and has no way to learn what
                unlocks it. Whatever is missing is named here, above the button,
                so the answer is on screen rather than guessed at.
            *@
            @if (!_busy && BlockingRequirement is { } requirement)
            {
                <p class="form__hint" data-testid="save-host-hint">@requirement</p>
            }

            <div class="form__actions">
                <button type="button" class="btn btn--primary btn--block"
                        disabled="@(_busy || !IsComplete)" data-testid="save-host"
                        aria-describedby="@(BlockingRequirement is null ? null : "save-host-hint")"
                        @onclick="SaveAsync">
                    @(_busy ? "Saving…" : "Save connection")
                </button>

                @if (!IsNew)
                {
                    <button type="button" class="btn btn--danger btn--block"
                            disabled="@_busy" data-testid="delete-host" @onclick="DeleteAsync">
                        <Icon Name="trash" /> Delete connection
                    </button>
                }
            </div>
        </div>
    </ChildContent>
</AppShell>

@code {
    private string _label = "";
    private string _group = "";
    private string _tags = "";
    private bool _isFavorite;
    private string _terminalTheme = "";
    private string _address = "";
    private string _username = "";
    private int _port = 22;
    private string _credentialId = "";
    private string _jumpHostId = "";
    private string _proxyUrl = "";
    private HostProtocol _protocol = HostProtocol.Ssh;
    private SshTransport _transport = SshTransport.Tcp;
    private bool _autoReconnect = true;
    private bool _forwardAgent;
    private int _serialBaudRate = 115200;
    private int _serialDataBits = 8;
    private SerialParity _serialParity = SerialParity.None;
    private SerialStopBits _serialStopBits = SerialStopBits.One;
    private IReadOnlyList<CredentialSummary> _credentials = [];
    private IReadOnlyList<HostRecord> _jumpHosts = [];
    private IReadOnlyList<SerialDeviceInfo> _serialDevices = [];
    private string? _error;
    private bool _busy;

    [Parameter] public HostRecord? Host { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    private bool IsNew => Host is null;
    private bool HasOrganisationSettings => !string.IsNullOrWhiteSpace(_group) || !string.IsNullOrWhiteSpace(_tags) || _isFavorite
        || !string.IsNullOrEmpty(_terminalTheme);
    private bool HasAdvancedSettings => !string.IsNullOrWhiteSpace(_jumpHostId) || !string.IsNullOrWhiteSpace(_proxyUrl) || _forwardAgent || !_autoReconnect;

    private static (HostProtocol Value, string Label)[] Protocols =>
    [
        (HostProtocol.Ssh, "SSH"),
        (HostProtocol.Mosh, "Mosh"),
        (HostProtocol.Telnet, "Telnet"),
        (HostProtocol.Serial, "Serial"),
        (HostProtocol.Local, "Local"),
    ];

    private static (SshTransport Value, string Label)[] Transports =>
    [
        (SshTransport.Tcp, "SSH"),
        (SshTransport.Tailcat, "Tailcat"),
        (SshTransport.TailscaleSsh, "Tailscale SSH"),
    ];

    private string ProtocolHint => _protocol switch
    {
        HostProtocol.Mosh => "Roaming terminal over UDP, bootstrapped through SSH. The remote host must have mosh-server installed.",
        HostProtocol.Telnet => "Legacy unencrypted terminal protocol.",
        HostProtocol.Serial => "Direct USB serial console using Android USB Host.",
        HostProtocol.Local => "A real local PTY running fully offline inside MeowSSH's app sandbox.",
        _ => "Secure Shell with terminal, SFTP, jump hosts and port forwarding.",
    };

    private string TransportHint => _transport switch
    {
        SshTransport.Tailcat => "Reach the machine with a Tailcat address without opening an inbound port.",
        SshTransport.TailscaleSsh => "Reach the machine across your tailnet using Tailscale SSH identity.",
        _ => "Connect to an ordinary SSH server over TCP.",
    };

    private string AddressLabel => _transport == SshTransport.Tailcat && _protocol == HostProtocol.Ssh
        ? "Tailcat address"
        : "Hostname or IP";

    private string AddressPlaceholder => _protocol switch
    {
        HostProtocol.Telnet => "router.local",
        HostProtocol.Mosh => "shell.example.com",
        _ when _transport == SshTransport.Tailcat => "tc…",
        _ when _transport == SshTransport.TailscaleSsh => "100.84.12.7",
        _ => "build.example.com",
    };

    private bool UsesSshCredentials =>
        _protocol == HostProtocol.Mosh
        || (_protocol == HostProtocol.Ssh && _transport != SshTransport.TailscaleSsh);

    private bool SupportsProxy =>
        _protocol == HostProtocol.Mosh
        || (_protocol == HostProtocol.Ssh && _transport == SshTransport.Tcp);

    private bool ProxyIsValid
    {
        get
        {
            if (!SupportsProxy || string.IsNullOrWhiteSpace(_proxyUrl)) return true;
            if (!Uri.TryCreate(_proxyUrl.Trim(), UriKind.Absolute, out var uri)) return false;
            return uri.Scheme.Equals("socks5", StringComparison.OrdinalIgnoreCase)
                || uri.Scheme.Equals("http", StringComparison.OrdinalIgnoreCase);
        }
    }

    /// <summary>
    /// The one thing still standing between this form and a save, worded for the
    /// person filling it in — or null when nothing is.
    /// </summary>
    /// <remarks>
    /// Ordered the way the form is read, so the hint names the field nearest the
    /// top that still needs attention rather than whichever check happens to run
    /// first.
    /// </remarks>
    private string? BlockingRequirement
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_label)) return "Give this connection a name to save it.";
            if (_protocol == HostProtocol.Local) return null;

            if (_protocol == HostProtocol.Serial)
            {
                if (string.IsNullOrWhiteSpace(_address)) return "Choose a serial device to save this connection.";
                if (_serialBaudRate <= 0) return "Set a baud rate above zero.";
                if (_serialDataBits is < 5 or > 8) return "Data bits must be between 5 and 8.";
            }
            else
            {
                if (string.IsNullOrWhiteSpace(_address)) return "Add a hostname or address to save this connection.";
                if (_port is <= 0 or > 65535) return "Port must be between 1 and 65535.";
            }

            if (!ProxyIsValid) return "The proxy address must start with socks5:// or http://.";
            return null;
        }
    }

    private bool IsComplete =>
        !string.IsNullOrWhiteSpace(_label)
        && ProxyIsValid
        && (_protocol == HostProtocol.Local
            || (_protocol == HostProtocol.Serial
                ? !string.IsNullOrWhiteSpace(_address) && _serialBaudRate > 0 && _serialDataBits is >= 5 and <= 8
                : !string.IsNullOrWhiteSpace(_address) && _port is > 0 and <= 65535));

    protected override async Task OnInitializedAsync()
    {
        if (Host is { } host)
        {
            _label = host.Label;
            _group = host.Group ?? "";
            _tags = string.Join(", ", host.Tags);
            _isFavorite = host.IsFavorite;
            _terminalTheme = host.TerminalTheme ?? "";
            _address = host.Address;
            _username = host.Username ?? "";
            _port = host.Port;
            _protocol = host.Protocol;
            _transport = host.Transport;
            _autoReconnect = host.AutoReconnect;
            _forwardAgent = host.ForwardAgent;
            _proxyUrl = host.ProxyUrl ?? "";
            _jumpHostId = host.JumpHostId?.ToString() ?? "";
            _serialBaudRate = host.SerialBaudRate;
            _serialDataBits = host.SerialDataBits;
            _serialParity = host.SerialParity;
            _serialStopBits = host.SerialStopBits;
            _credentialId = host.CredentialId?.ToString() ?? "";
        }

        _credentials = [.. (await Editor.GetCredentialsAsync()).Where(c => c.Kind != CredentialKind.PublicKey)];
        var statuses = await Hosts.GetHostsAsync();
        _jumpHosts = [.. statuses
            .Select(status => status.Host)
            .Where(host => !host.IsDeleted && host.Protocol == HostProtocol.Ssh && host.Id != Host?.Id)
            .OrderBy(host => host.Label, StringComparer.OrdinalIgnoreCase)];
        await RefreshSerialDevicesAsync();
    }

    private void OnProtocolChanged(ChangeEventArgs args)
    {
        if (Enum.TryParse<HostProtocol>(args.Value?.ToString(), out var protocol))
            SetProtocol(protocol);
    }

    private void OnTransportChanged(ChangeEventArgs args)
    {
        if (Enum.TryParse<SshTransport>(args.Value?.ToString(), out var transport))
            SetTransport(transport);
    }

    private void SetProtocol(HostProtocol protocol)
    {
        if (_protocol == protocol) return;
        if (protocol == HostProtocol.Telnet && _port == 22) _port = 23;
        else if (_protocol == HostProtocol.Telnet && _port == 23 && protocol is HostProtocol.Ssh or HostProtocol.Mosh) _port = 22;
        _protocol = protocol;
        if (protocol == HostProtocol.Local)
        {
            _address = "";
            _username = "";
            _credentialId = "";
            _jumpHostId = "";
            _forwardAgent = false;
            _autoReconnect = false;
        }
        else if (protocol == HostProtocol.Telnet)
        {
            _username = "";
            _credentialId = "";
            _jumpHostId = "";
            _forwardAgent = false;
        }
        else if (protocol == HostProtocol.Serial)
        {
            _username = "";
            _credentialId = "";
            _jumpHostId = "";
            _forwardAgent = false;
        }
        else if (protocol != HostProtocol.Ssh)
        {
            _jumpHostId = "";
            _forwardAgent = false;
        }

        if (protocol != HostProtocol.Local && !_autoReconnect)
            _autoReconnect = true;
    }

    private void SetTransport(SshTransport transport)
    {
        _transport = transport;
        if (transport == SshTransport.Tailcat) _username = "";
    }

    private async Task RefreshSerialDevicesAsync()
    {
        try { _serialDevices = await SerialDevices.ListDevicesAsync(); }
        catch { _serialDevices = []; }
    }

    private IReadOnlyList<string> ParsedTags =>
        [.. _tags
            .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)];

    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await Editor.SaveHostAsync(new HostRecord
            {
                Id = Host?.Id ?? Guid.NewGuid(),
                Label = _label.Trim(),
                Group = string.IsNullOrWhiteSpace(_group) ? null : _group.Trim(),
                IsFavorite = _isFavorite,
                // Kept even without Pro (the picker is just disabled): saving an
                // unrelated edit after a lapse must not erase the host's theme.
                TerminalTheme = string.IsNullOrEmpty(_terminalTheme) ? null : _terminalTheme,
                Address = _protocol == HostProtocol.Local ? "" : _address.Trim(),
                Port = _port,
                Username = string.IsNullOrWhiteSpace(_username) ? null : _username.Trim(),
                Protocol = _protocol,
                Transport = _protocol == HostProtocol.Mosh ? SshTransport.Tcp : _transport,
                AutoReconnect = _protocol != HostProtocol.Local && _autoReconnect,
                ProxyUrl = SupportsProxy && !string.IsNullOrWhiteSpace(_proxyUrl) ? _proxyUrl.Trim() : null,
                ForwardAgent = _protocol == HostProtocol.Ssh && _forwardAgent,
                SerialBaudRate = _serialBaudRate,
                SerialDataBits = _serialDataBits,
                SerialParity = _serialParity,
                SerialStopBits = _serialStopBits,
                Tags = ParsedTags,
                JumpHostId = _protocol == HostProtocol.Ssh && Guid.TryParse(_jumpHostId, out var jumpId) ? jumpId : null,
                CredentialId = UsesSshCredentials && Guid.TryParse(_credentialId, out var id) ? id : null,
                LastConnectedAt = Host?.LastConnectedAt,
            });
            await OnSaved.InvokeAsync();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally { _busy = false; }
    }

    private async Task DeleteAsync()
    {
        _busy = true;
        try
        {
            await Editor.DeleteHostAsync(Host!.Id);
            await OnSaved.InvokeAsync();
        }
        finally { _busy = false; }
    }
}
