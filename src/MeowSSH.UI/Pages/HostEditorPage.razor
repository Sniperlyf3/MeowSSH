@inject IHostEditor Editor
@inject ISerialDeviceService SerialDevices

<AppShell Title="@(IsNew ? "New connection" : "Edit connection")" ActiveTab="hosts">
    <Actions>
        <button type="button" class="btn btn--icon" aria-label="Cancel"
                data-testid="cancel-host" @onclick="OnCancelled">
            <Icon Name="close" />
        </button>
    </Actions>

    <ChildContent>
        <div class="form" data-testid="host-editor">
            <label class="field">
                <span class="field__label">Name</span>
                <input class="field__input" type="text" data-testid="host-label"
                       placeholder="build-01" autocomplete="off" spellcheck="false"
                       @bind="_label" @bind:event="oninput" />
                <span class="field__hint">What you will call this connection in the list.</span>
            </label>

            <fieldset class="field">
                <legend class="field__label">Protocol</legend>
                <div class="segmented" role="radiogroup" aria-label="Protocol">
                    @foreach (var option in Protocols)
                    {
                        <button type="button"
                                class="segmented__option @(_protocol == option.Value ? "segmented__option--on" : "")"
                                role="radio"
                                aria-checked="@(_protocol == option.Value ? "true" : "false")"
                                data-testid="@($"protocol-{option.Value}")"
                                @onclick="() => SetProtocol(option.Value)">
                            @option.Label
                        </button>
                    }
                </div>
                <span class="field__hint">@ProtocolHint</span>
            </fieldset>

            @if (_protocol == HostProtocol.Ssh)
            {
                <fieldset class="field">
                    <legend class="field__label">How to reach it</legend>
                    <div class="segmented" role="radiogroup" aria-label="Transport">
                        @foreach (var option in Transports)
                        {
                            <button type="button"
                                    class="segmented__option @(_transport == option.Value ? "segmented__option--on" : "")"
                                    role="radio"
                                    aria-checked="@(_transport == option.Value ? "true" : "false")"
                                    data-testid="@($"transport-{option.Value}")"
                                    @onclick="() => SetTransport(option.Value)">
                                @option.Label
                            </button>
                        }
                    </div>
                    <span class="field__hint">@TransportHint</span>
                </fieldset>
            }

            @if (_protocol == HostProtocol.Serial)
            {
                <label class="field">
                    <span class="field__label">USB serial device</span>
                    <select class="field__input" data-testid="serial-device" @bind="_address">
                        <option value="">Select a connected device</option>
                        @if (!string.IsNullOrWhiteSpace(_address) && !_serialDevices.Any(d => d.Id == _address))
                        {
                            <option value="@_address">Saved device (currently unavailable)</option>
                        }
                        @foreach (var device in _serialDevices)
                        {
                            <option value="@device.Id">@device.Label</option>
                        }
                    </select>
                    <button type="button" class="btn btn--ghost" data-testid="refresh-serial-devices"
                            @onclick="RefreshSerialDevicesAsync">Refresh devices</button>
                </label>

                <div class="form__row">
                    <label class="field field--grow">
                        <span class="field__label">Baud rate</span>
                        <input class="field__input mono" type="number" min="1" data-testid="serial-baud"
                               @bind="_serialBaudRate" />
                    </label>
                    <label class="field field--narrow">
                        <span class="field__label">Data bits</span>
                        <select class="field__input" data-testid="serial-data-bits" @bind="_serialDataBits">
                            <option value="5">5</option><option value="6">6</option><option value="7">7</option><option value="8">8</option>
                        </select>
                    </label>
                </div>
                <div class="form__row">
                    <label class="field field--grow">
                        <span class="field__label">Parity</span>
                        <select class="field__input" data-testid="serial-parity" @bind="_serialParity">
                            @foreach (var value in Enum.GetValues<SerialParity>())
                            {
                                <option value="@value">@value</option>
                            }
                        </select>
                    </label>
                    <label class="field field--grow">
                        <span class="field__label">Stop bits</span>
                        <select class="field__input" data-testid="serial-stop-bits" @bind="_serialStopBits">
                            <option value="@SerialStopBits.One">1</option>
                            <option value="@SerialStopBits.OnePointFive">1.5</option>
                            <option value="@SerialStopBits.Two">2</option>
                        </select>
                    </label>
                </div>
            }
            else if (_protocol != HostProtocol.Local)
            {
                <label class="field">
                    <span class="field__label">@AddressLabel</span>
                    <input class="field__input mono" type="text" data-testid="host-address"
                           placeholder="@AddressPlaceholder" autocomplete="off"
                           autocapitalize="none" spellcheck="false"
                           @bind="_address" @bind:event="oninput" />
                </label>

                @if (_protocol is HostProtocol.Ssh or HostProtocol.Mosh or HostProtocol.Telnet)
                {
                    <div class="form__row">
                        @if (_protocol is HostProtocol.Ssh or HostProtocol.Mosh && _transport != SshTransport.Tailcat)
                        {
                            <label class="field field--grow">
                                <span class="field__label">Username</span>
                                <input class="field__input mono" type="text" data-testid="host-username"
                                       placeholder="deploy" autocomplete="off"
                                       autocapitalize="none" spellcheck="false"
                                       @bind="_username" @bind:event="oninput" />
                            </label>
                        }
                        <label class="field field--narrow">
                            <span class="field__label">@(_protocol == HostProtocol.Mosh ? "SSH port" : "Port")</span>
                            <input class="field__input mono" type="number" inputmode="numeric"
                                   min="1" max="65535" data-testid="host-port"
                                   @bind="_port" @bind:event="oninput" />
                        </label>
                    </div>
                }
            }

            @if (_protocol == HostProtocol.Telnet)
            {
                <p class="note" data-testid="telnet-warning">
                    <Icon Name="alert" />
                    Telnet is unencrypted. Usernames, passwords and terminal traffic can be read or changed by anyone able to intercept the connection.
                </p>
            }

            @if (UsesSshCredentials)
            {
                <label class="field">
                    <span class="field__label">Sign in with</span>
                    <select class="field__input" data-testid="host-credential" @bind="_credentialId">
                        <option value="">Ask me each time</option>
                        @foreach (var credential in _credentials)
                        {
                            <option value="@credential.Id">@credential.Label — @credential.DisplayHint</option>
                        }
                    </select>
                    <span class="field__hint">
                        @(_credentials.Count == 0
                            ? "No saved keys or passwords yet. Add one on the Keys tab."
                            : "Stored in the vault and unsealed only while connecting.")
                    </span>
                </label>
            }
            else if (_protocol == HostProtocol.Ssh && _transport == SshTransport.TailscaleSsh)
            {
                <p class="note" data-testid="tailscale-note">
                    <Icon Name="shield" />
                    Tailscale SSH authenticates with your tailnet identity. Tailscale must be connected on this device.
                </p>
            }

            @if (_protocol != HostProtocol.Local)
            {
                <label class="forward-option">
                    <input type="checkbox" data-testid="auto-reconnect" @bind="_autoReconnect" />
                    <span>
                        <strong>Automatically reconnect</strong>
                        <small>Retries unexpected disconnects with exponential backoff. Authentication and host-key failures are never retried automatically.</small>
                    </span>
                </label>
            }

            @if (_error is not null)
            {
                <p class="lock__error" role="alert" data-testid="host-error">@_error</p>
            }

            <div class="form__actions">
                <button type="button" class="btn btn--primary btn--block"
                        disabled="@(_busy || !IsComplete)" data-testid="save-host" @onclick="SaveAsync">
                    @(_busy ? "Saving…" : "Save connection")
                </button>

                @if (!IsNew)
                {
                    <button type="button" class="btn btn--danger btn--block"
                            disabled="@_busy" data-testid="delete-host" @onclick="DeleteAsync">
                        <Icon Name="trash" /> Delete connection
                    </button>
                }
            </div>
        </div>
    </ChildContent>
</AppShell>

@code {
    private string _label = "";
    private string _address = "";
    private string _username = "";
    private int _port = 22;
    private string _credentialId = "";
    private HostProtocol _protocol = HostProtocol.Ssh;
    private SshTransport _transport = SshTransport.Tcp;
    private bool _autoReconnect = true;
    private int _serialBaudRate = 115200;
    private int _serialDataBits = 8;
    private SerialParity _serialParity = SerialParity.None;
    private SerialStopBits _serialStopBits = SerialStopBits.One;
    private IReadOnlyList<CredentialSummary> _credentials = [];
    private IReadOnlyList<SerialDeviceInfo> _serialDevices = [];
    private string? _error;
    private bool _busy;

    [Parameter] public HostRecord? Host { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    private bool IsNew => Host is null;

    private static (HostProtocol Value, string Label)[] Protocols =>
    [
        (HostProtocol.Ssh, "SSH"),
        (HostProtocol.Mosh, "Mosh"),
        (HostProtocol.Telnet, "Telnet"),
        (HostProtocol.Serial, "Serial"),
        (HostProtocol.Local, "Local"),
    ];

    private static (SshTransport Value, string Label)[] Transports =>
    [
        (SshTransport.Tcp, "SSH"),
        (SshTransport.Tailcat, "tailcat"),
        (SshTransport.TailscaleSsh, "Tailscale"),
    ];

    private string ProtocolHint => _protocol switch
    {
        HostProtocol.Mosh => "Roaming terminal over UDP, bootstrapped through SSH. The remote host must have mosh-server installed.",
        HostProtocol.Telnet => "Legacy unencrypted terminal protocol.",
        HostProtocol.Serial => "Direct USB serial console using Android USB Host.",
        HostProtocol.Local => "A real local PTY served by Meowshell and connected through an ephemeral tailcat session.",
        _ => "Secure Shell with terminal, SFTP and port forwarding.",
    };

    private string TransportHint => _transport switch
    {
        SshTransport.Tailcat => "A tailcat address reaches the machine without an open inbound port.",
        SshTransport.TailscaleSsh => "Reached across your tailnet using Tailscale SSH identity.",
        _ => "An ordinary SSH server reached over TCP.",
    };

    private string AddressLabel => _transport == SshTransport.Tailcat && _protocol == HostProtocol.Ssh
        ? "tailcat address"
        : "Hostname or IP";

    private string AddressPlaceholder => _protocol switch
    {
        HostProtocol.Telnet => "router.local",
        HostProtocol.Mosh => "shell.example.com",
        _ when _transport == SshTransport.Tailcat => "tc…",
        _ when _transport == SshTransport.TailscaleSsh => "100.84.12.7",
        _ => "build.example.com",
    };

    private bool UsesSshCredentials =>
        _protocol == HostProtocol.Mosh
        || (_protocol == HostProtocol.Ssh && _transport != SshTransport.TailscaleSsh);

    private bool IsComplete =>
        !string.IsNullOrWhiteSpace(_label)
        && (_protocol == HostProtocol.Local
            || (_protocol == HostProtocol.Serial
                ? !string.IsNullOrWhiteSpace(_address) && _serialBaudRate > 0 && _serialDataBits is >= 5 and <= 8
                : !string.IsNullOrWhiteSpace(_address) && _port is > 0 and <= 65535));

    protected override async Task OnInitializedAsync()
    {
        if (Host is { } host)
        {
            _label = host.Label;
            _address = host.Address;
            _username = host.Username ?? "";
            _port = host.Port;
            _protocol = host.Protocol;
            _transport = host.Transport;
            _autoReconnect = host.AutoReconnect;
            _serialBaudRate = host.SerialBaudRate;
            _serialDataBits = host.SerialDataBits;
            _serialParity = host.SerialParity;
            _serialStopBits = host.SerialStopBits;
            _credentialId = host.CredentialId?.ToString() ?? "";
        }

        _credentials = await Editor.GetCredentialsAsync();
        await RefreshSerialDevicesAsync();
    }

    private void SetProtocol(HostProtocol protocol)
    {
        if (_protocol == protocol) return;
        if (protocol == HostProtocol.Telnet && _port == 22) _port = 23;
        else if (_protocol == HostProtocol.Telnet && _port == 23 && protocol is HostProtocol.Ssh or HostProtocol.Mosh) _port = 22;
        _protocol = protocol;
        if (protocol == HostProtocol.Local)
        {
            _address = "";
            _username = "";
            _credentialId = "";
            _autoReconnect = false;
        }
        else if (protocol == HostProtocol.Telnet)
        {
            _username = "";
            _credentialId = "";
        }
        else if (protocol == HostProtocol.Serial)
        {
            _username = "";
            _credentialId = "";
        }
        else if (!_autoReconnect)
        {
            _autoReconnect = true;
        }
    }

    private void SetTransport(SshTransport transport)
    {
        _transport = transport;
        if (transport == SshTransport.Tailcat) _username = "";
    }

    private async Task RefreshSerialDevicesAsync()
    {
        try { _serialDevices = await SerialDevices.ListDevicesAsync(); }
        catch { _serialDevices = []; }
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await Editor.SaveHostAsync(new HostRecord
            {
                Id = Host?.Id ?? Guid.NewGuid(),
                Label = _label.Trim(),
                Address = _protocol == HostProtocol.Local ? "" : _address.Trim(),
                Port = _port,
                Username = string.IsNullOrWhiteSpace(_username) ? null : _username.Trim(),
                Protocol = _protocol,
                Transport = _protocol == HostProtocol.Mosh ? SshTransport.Tcp : _transport,
                AutoReconnect = _protocol != HostProtocol.Local && _autoReconnect,
                SerialBaudRate = _serialBaudRate,
                SerialDataBits = _serialDataBits,
                SerialParity = _serialParity,
                SerialStopBits = _serialStopBits,
                Tags = Host?.Tags ?? [],
                JumpHostId = Host?.JumpHostId,
                CredentialId = UsesSshCredentials && Guid.TryParse(_credentialId, out var id) ? id : null,
                LastConnectedAt = Host?.LastConnectedAt,
            });
            await OnSaved.InvokeAsync();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally { _busy = false; }
    }

    private async Task DeleteAsync()
    {
        _busy = true;
        try
        {
            await Editor.DeleteHostAsync(Host!.Id);
            await OnSaved.InvokeAsync();
        }
        finally { _busy = false; }
    }
}
