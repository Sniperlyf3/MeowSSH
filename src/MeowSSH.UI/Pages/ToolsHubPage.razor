<section class="tools-hub" data-testid="tools-hub">
    <div class="tools-hub__intro">
        <h2>Tools</h2>
        <p>Automation, monitoring, networking and backup tools live here so the main navigation stays focused.</p>
    </div>

    <section class="tools-hub__section" aria-labelledby="tools-operations-title">
        <h3 class="section-label" id="tools-operations-title">Automation & operations</h3>
        <div class="tools-hub__list">
            <button type="button" class="setting-card" data-testid="open-tool-actions" @onclick="OpenActions">
                <span class="setting-card__copy">
                    <span class="setting-card__title">Actions</span>
                    <span class="setting-card__body">Save commands and run them against one or more SSH hosts.</span>
                </span>
                <Icon Name="chevron" />
            </button>

            <button type="button" class="setting-card" data-testid="open-tool-monitoring" @onclick="OpenMonitoring">
                <span class="setting-card__copy">
                    <span class="setting-card__title">Monitoring</span>
                    <span class="setting-card__body">Watch command checks and surface operational changes.</span>
                </span>
                <Icon Name="chevron" />
            </button>

            <button type="button" class="setting-card" data-testid="open-tool-health" @onclick="OpenHealth">
                <span class="setting-card__copy">
                    <span class="setting-card__title">Host health</span>
                    <span class="setting-card__body">Review saved-host health and status in one place.</span>
                </span>
                <Icon Name="chevron" />
            </button>
        </div>
    </section>

    <section class="tools-hub__section" aria-labelledby="tools-network-title">
        <h3 class="section-label" id="tools-network-title">Network & data</h3>
        <div class="tools-hub__list">
            <button type="button" class="setting-card" data-testid="open-tool-tailcat" @onclick="OpenTailcat">
                <span class="setting-card__copy">
                    <span class="setting-card__title">Tailcat</span>
                    <span class="setting-card__body">Private networking, devices, keys, transfers and diagnostics.</span>
                </span>
                <Icon Name="chevron" />
            </button>

            <button type="button" class="setting-card" data-testid="open-tool-backup" @onclick="OpenBackup">
                <span class="setting-card__copy">
                    <span class="setting-card__title">Encrypted backup</span>
                    <span class="setting-card__body">Export or restore encrypted MeowSSH data.</span>
                </span>
                <Icon Name="chevron" />
            </button>
        </div>
    </section>
</section>

@code {
    [Parameter] public EventCallback<string> OnSelected { get; set; }

    private Task OpenActions() => OnSelected.InvokeAsync("actions");
    private Task OpenMonitoring() => OnSelected.InvokeAsync("monitoring");
    private Task OpenHealth() => OnSelected.InvokeAsync("health");
    private Task OpenTailcat() => OnSelected.InvokeAsync("tailcat");
    private Task OpenBackup() => OnSelected.InvokeAsync("backup");
}
