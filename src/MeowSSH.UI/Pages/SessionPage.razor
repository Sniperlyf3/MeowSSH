@using MeowSSH.Core.Ssh
@implements IAsyncDisposable
@inject TerminalBroadcastCoordinator Broadcast

<div class="session" data-testid="session">
    <header class="topbar">
        <button type="button" class="btn btn--icon" aria-label="Back to hosts"
                data-testid="session-back" @onclick="OnBack">
            <Icon Name="back" />
        </button>

        <span class="session__title">
            <span class="session__host">@Host.Label</span>
            <span class="session__address">@Host.DisplayAddress</span>
        </span>

        @if (SupportsFiles)
        {
            <button type="button" class="btn btn--icon" aria-label="Browse files"
                    data-testid="session-files" disabled="@(!IsConnected)" @onclick="OpenFilesAsync">
                <Icon Name="folder" />
            </button>
        }
        @if (PathStatus is not null && IsConnected)
        {
            <span data-testid="session-path-status"
                  title="Live Tailcat path. This is connection diagnostics, not relay billing.">
                <StatusBadge Label="@PathStatus.Label"
                             Variant="@(PathStatus.Direct ? "ok" : "neutral")"
                             ShowDot="true" />
            </span>
        }
        <StatusBadge Label="@(IsReconnecting ? "Reconnecting" : IsConnected ? "Connected" : "Disconnected")"
                     Variant="@(IsConnected ? "ok" : IsReconnecting ? "warn" : "danger")"
                     ShowDot="true" />
    </header>

    @if (RelayHealth is not null)
    {
        <div class="notice notice--warn" role="status" data-testid="session-relay-health">
            <Icon Name="alert" />
            <div>
                <p class="notice__title">Managed relay limited</p>
                <p class="notice__body" data-testid="session-relay-health-text">@RelayHealth</p>
                <p class="notice__body">
                    Direct connections and self-hosted relays are not affected. Check your
                    allowance under Tools &rarr; Tailcat &rarr; Managed relay usage.
                </p>
            </div>
        </div>
    }

    @if (_broadcastShell is not null)
    {
        <BroadcastTerminalControl SessionId="_broadcastShell.RegistrationId" />
        <TerminalView Shell="_broadcastShell" OnWriteFailed="OnWriteFailed" />
    }

    @if (!IsConnected)
    {
        <div class="sheet @(IsReconnecting ? "" : "sheet--danger")" role="alert" data-testid="session-disconnected">
            <p class="sheet__title">@(IsReconnecting ? "Reconnecting" : "Session disconnected")</p>
            <p class="sheet__body">@EffectiveDisconnectMessage</p>
            <button type="button" class="btn btn--primary btn--block"
                    data-testid="session-reconnect"
                    @onclick="ReconnectAsync">
                @(IsReconnecting ? "Reconnect now" : "Reconnect")
            </button>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public HostRecord Host { get; set; } = default!;
    [Parameter, EditorRequired] public ITerminalSession Shell { get; set; } = default!;
    [Parameter] public bool SupportsFiles { get; set; }
    [Parameter] public bool IsConnected { get; set; } = true;
    [Parameter] public bool IsReconnecting { get; set; }
    [Parameter] public SshPathStatus? PathStatus { get; set; }
    [Parameter] public string? RelayHealth { get; set; }
    [Parameter] public string DisconnectMessage { get; set; } = "The terminal session is no longer connected.";
    [Parameter] public EventCallback OnReconnect { get; set; }
    [Parameter] public EventCallback<Exception> OnWriteFailed { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }
    [Parameter] public EventCallback OnOpenFiles { get; set; }

    private ITerminalSession? _sourceShell;
    private BroadcastTerminalSession? _broadcastShell;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_sourceShell, Shell) && _broadcastShell is not null) return;
        if (_broadcastShell is not null) _ = _broadcastShell.DisposeAsync();
        _sourceShell = Shell;
        _broadcastShell = new BroadcastTerminalSession(Host.Label, Shell, Broadcast);
    }

    private string EffectiveDisconnectMessage =>
        DisconnectMessage is "_sessionStatus" or "session.Status"
            ? "The terminal session is no longer connected."
            : DisconnectMessage;

    private Task OnBack() => OnClosed.InvokeAsync();
    private Task ReconnectAsync() => OnReconnect.InvokeAsync();
    private Task OpenFilesAsync() => OnOpenFiles.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        if (_broadcastShell is not null) await _broadcastShell.DisposeAsync();
    }
}
