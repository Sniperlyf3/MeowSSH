@inject IHostDirectory Directory
@implements IDisposable

<AppShell Title="Hosts" ActiveTab="hosts" OnTabSelected="OnTabSelected">
    <Actions>
        <button type="button" class="btn btn--icon" aria-label="Search hosts" data-testid="search"
                @onclick="ToggleSearch">
            <Icon Name="search" />
        </button>
        <button type="button" class="btn btn--icon" aria-label="Add host" data-testid="add-host"
                @onclick="OnAddHost">
            <Icon Name="plus" />
        </button>
    </Actions>

    <ChildContent>
        @if (_searchVisible)
        {
            <div class="form__row" data-testid="host-search-controls">
                <label class="field field--grow">
                    <span class="field__label">Search hosts</span>
                    <input class="field__input" type="search" data-testid="host-search"
                           placeholder="Name, address, group, tag…" autocomplete="off"
                           @bind="_query" @bind:event="oninput" />
                </label>
                <label class="field field--grow">
                    <span class="field__label">Sort by</span>
                    <select class="field__input" data-testid="host-sort" @bind="_sort">
                        <option value="name">Name</option>
                        <option value="recent">Recently used</option>
                    </select>
                </label>
            </div>
        }

        @if (OpenSessionCount > 0)
        {
            <button type="button" class="btn btn--ghost btn--block session-resume"
                    data-testid="resume-sessions" @onclick="OnOpenSessions">
                <Icon Name="terminal" />
                @(OpenSessionCount == 1 ? "Return to open session" : $"Return to {OpenSessionCount} open sessions")
            </button>
        }

        @if (_hosts is null)
        {
            <p class="visually-hidden" role="status">Loading hosts</p>
        }
        else if (_hosts.Count == 0)
        {
            <div class="empty" data-testid="empty-state">
                <span class="empty__glyph"><Icon Name="terminal" /></span>
                <p class="empty__title">No hosts yet</p>
                <p class="empty__body">
                    Add a server you connect to over SSH, or paste a tailcat address to reach
                    a machine that has no open port at all.
                </p>
                <button type="button" class="btn btn--primary" data-testid="add-first-host"
                        @onclick="OnAddHost">
                    <Icon Name="plus" /> Add your first host
                </button>
            </div>
        }
        else if (FilteredHosts.Count == 0)
        {
            <div class="empty" data-testid="host-search-empty">
                <span class="empty__glyph"><Icon Name="search" /></span>
                <p class="empty__title">No matching hosts</p>
                <p class="empty__body">Try a different name, address, group or tag.</p>
            </div>
        }
        else
        {
            @foreach (var group in Grouped(FilteredHosts))
            {
                <h2 class="section-label">
                    @group.Key
                    <span class="section-label__count">@group.Count()</span>
                </h2>
                <div class="host-list" data-testid="host-list">
                    @foreach (var status in group)
                    {
                        <HostRow Status="status" OnSelected="Connect" OnEdit="OnEditHost" />
                    }
                </div>
            }
        }
    </ChildContent>
</AppShell>

@code {
    private IReadOnlyList<HostStatus>? _hosts;
    private bool _searchVisible;
    private string _query = "";
    private string _sort = "name";

    [Parameter] public EventCallback<HostRecord> OnHostSelected { get; set; }
    [Parameter] public EventCallback OnAddHost { get; set; }
    [Parameter] public EventCallback<HostRecord> OnEditHost { get; set; }
    [Parameter] public EventCallback<string> OnTabSelected { get; set; }
    [Parameter] public int OpenSessionCount { get; set; }
    [Parameter] public EventCallback OnOpenSessions { get; set; }

    private IReadOnlyList<HostStatus> FilteredHosts => _hosts is null
        ? []
        : [.. _hosts.Where(MatchesQuery)];

    protected override async Task OnInitializedAsync()
    {
        Directory.Changed += OnDirectoryChanged;
        await LoadAsync();
    }

    private async Task LoadAsync() => _hosts = await Directory.GetHostsAsync();

    private void OnDirectoryChanged(object? sender, EventArgs e) =>
        _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    private Task Connect(HostRecord host) => OnHostSelected.InvokeAsync(host);

    private void ToggleSearch()
    {
        _searchVisible = !_searchVisible;
        if (!_searchVisible)
        {
            _query = "";
            _sort = "name";
        }
    }

    private bool MatchesQuery(HostStatus status)
    {
        if (string.IsNullOrWhiteSpace(_query)) return true;
        var query = _query.Trim();
        var host = status.Host;
        return host.Label.Contains(query, StringComparison.OrdinalIgnoreCase)
            || host.Address.Contains(query, StringComparison.OrdinalIgnoreCase)
            || (host.Username?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)
            || (host.Group?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)
            || host.Tags.Any(tag => tag.Contains(query, StringComparison.OrdinalIgnoreCase));
    }

    private IEnumerable<IGrouping<string, HostStatus>> Grouped(IReadOnlyList<HostStatus> hosts)
    {
        var ordered = hosts
            .OrderBy(h => h.State == ConnectionState.Connected ? 0 : 1)
            .ThenBy(h => h.State == ConnectionState.Connected ? 0 : h.Host.IsFavorite ? 0 : 1);

        ordered = _sort == "recent"
            ? ordered.ThenByDescending(h => h.Host.LastConnectedAt ?? DateTimeOffset.MinValue)
                .ThenBy(h => h.Host.Label, StringComparer.OrdinalIgnoreCase)
            : ordered.ThenBy(h => h.Host.Label, StringComparer.OrdinalIgnoreCase);

        return ordered
            .GroupBy(h => GroupLabel(h))
            .OrderBy(g => GroupRank(g.Key))
            .ThenBy(g => g.Key, StringComparer.OrdinalIgnoreCase);
    }

    private static string GroupLabel(HostStatus status)
    {
        if (status.State == ConnectionState.Connected) return "Active sessions";
        if (status.Host.IsFavorite) return "Favorites";
        return string.IsNullOrWhiteSpace(status.Host.Group) ? "All hosts" : status.Host.Group.Trim();
    }

    private static int GroupRank(string label) => label switch
    {
        "Active sessions" => 0,
        "Favorites" => 1,
        "All hosts" => 3,
        _ => 2,
    };

    public void Dispose() => Directory.Changed -= OnDirectoryChanged;
}
