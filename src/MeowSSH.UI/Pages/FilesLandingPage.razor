@inject IHostDirectory Directory
@inject ICredentialResolver Credentials
@inject ISshEngine Ssh
@inject ISshPrompts Prompts
@inject IActiveSessionLifetime SessionLifetime
@implements IAsyncDisposable

@if (_advancedHost is not null && _advancedSftp is not null)
{
    <AdvancedSftpPage Host="_advancedHost" Sftp="_advancedSftp" OnClosed="CloseAdvancedAsync" />
}
else
{
<AppShell Title="Files" ActiveTab="files" OnTabSelected="OnTabSelected">
    <ChildContent>
        @if (_advancedBusy)
        {
            <div class="sheet" role="status" data-testid="advanced-sftp-connecting">
                <p class="sheet__title">Opening Advanced SFTP…</p>
                <p class="sheet__body">Connecting securely to @_advancedTargetLabel.</p>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_advancedError))
        {
            <div class="notice notice--danger" role="alert" data-testid="advanced-sftp-connect-error">
                <Icon Name="alert" />
                <div>
                    <p class="notice__title">Could not open Advanced SFTP</p>
                    <p class="notice__body">@_advancedError</p>
                </div>
            </div>
        }

        @if (_hosts is null)
        {
            <p class="visually-hidden" role="status">Loading hosts</p>
        }
        else if (_hosts.Count == 0)
        {
            <div class="empty" data-testid="files-hosts-empty">
                <span class="empty__glyph"><Icon Name="folder" /></span>
                <p class="empty__title">No hosts yet</p>
                <p class="empty__body">Add a host first, then come back here to browse it over SFTP.</p>
            </div>
        }
        else
        {
            @*
                One entry point to the advanced tools, not one per host.

                Each row used to carry its own "More" disclosure containing an
                identical "Advanced SFTP" button: six hosts meant six identical
                buttons and six half-height grey bands, which roughly doubled the
                length of the list and read as an unfinished component. The tool
                is the same tool whichever host it runs against, so it is offered
                once and asks which host afterwards -- the list is already right
                here to answer with.
            *@
            <h2 class="section-label">@(_advancedPicking ? "Advanced tools: choose a host" : "Choose a host")</h2>
            <p class="files-landing__hint">
                @(_advancedPicking
                    ? "Pick the host to run remote search, bookmarks and recursive transfers against."
                    : "Tap a host to browse its files.")
            </p>

            @if (_advancedPicking)
            {
                <button type="button" class="btn btn--ghost btn--block" data-testid="advanced-sftp-cancel"
                        @onclick="() => _advancedPicking = false">
                    Cancel
                </button>
            }
            else if (_hosts.Any(h => h.Host.Protocol == HostProtocol.Ssh))
            {
                <button type="button" class="setting-card" data-testid="advanced-sftp-open"
                        disabled="@_advancedBusy" @onclick="() => _advancedPicking = true">
                    <span class="setting-card__copy">
                        <span class="setting-card__title">Advanced SFTP <span class="tier-badge">Pro</span></span>
                        <span class="setting-card__body">Remote search, bookmarks, recursive downloads and recursive delete.</span>
                    </span>
                    <span class="setting-card__value">Open</span>
                </button>
            }

            <div class="host-list" data-testid="files-host-list">
                @foreach (var status in _hosts)
                {
                    @* While picking, a host that cannot run the advanced tools is
                       not offered at all, rather than shown and then refused. *@
                    @if (!_advancedPicking || status.Host.Protocol == HostProtocol.Ssh)
                    {
                        <HostRow Status="status" OnSelected="ChooseHostAsync" />
                    }
                }
            </div>
        }
    </ChildContent>
</AppShell>
}

@code {
    private IReadOnlyList<HostStatus>? _hosts;
    private HostRecord? _advancedHost;
    private ISshConnection? _advancedConnection;
    private ISftpSession? _advancedSftp;
    private bool _advancedBusy;
    /// <summary>The host list is standing in as the picker for the advanced tools.</summary>
    private bool _advancedPicking;
    private string? _advancedError;
    private string? _advancedTargetLabel;
    private bool _lifetimeStarted;

    [Parameter] public EventCallback<HostRecord> OnHostSelected { get; set; }
    [Parameter] public EventCallback<string> OnTabSelected { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Directory.Changed += OnDirectoryChanged;
        _hosts = await Directory.GetHostsAsync();
    }

    /// <summary>
    /// What tapping a host row means right now: browse it, or run the advanced
    /// tools against it.
    /// </summary>
    /// <remarks>
    /// One handler rather than swapping the row's callback, because a
    /// target-typed conditional cannot be converted to an
    /// <see cref="EventCallback"/> and the branch belongs with the state that
    /// decides it anyway.
    /// </remarks>
    private Task ChooseHostAsync(HostRecord host) =>
        _advancedPicking ? OpenAdvancedAsync(host) : OnHostSelected.InvokeAsync(host);

    private async Task OpenAdvancedAsync(HostRecord host)
    {
        if (_advancedBusy || host.Protocol != HostProtocol.Ssh) return;
        _advancedPicking = false;
        _advancedBusy = true;
        _advancedError = null;
        _advancedTargetLabel = host.Label;
        ISshConnection? connection = null;
        ISftpSession? sftp = null;
        try
        {
            await SessionLifetime.StartAsync();
            _lifetimeStarted = true;
            using var credentials = await Credentials.ResolveAsync(host);
            var target = !string.IsNullOrWhiteSpace(credentials.Username)
                ? host with { Username = credentials.Username }
                : host;
            var credentialPrompts = new CredentialSshPrompts(Prompts, credentials);
            connection = await Ssh.ConnectAsync(target, credentials, credentialPrompts);
            sftp = await connection.OpenSftpAsync();

            _advancedHost = target;
            _advancedConnection = connection;
            _advancedSftp = sftp;
            connection = null;
            sftp = null;
        }
        catch (Exception exception) when (exception is SshException or IOException or InvalidOperationException or ObjectDisposedException)
        {
            _advancedError = exception.Message;
            if (_lifetimeStarted)
            {
                await SessionLifetime.StopAsync();
                _lifetimeStarted = false;
            }
        }
        finally
        {
            if (sftp is not null) await sftp.DisposeAsync();
            if (connection is not null) await connection.DisposeAsync();
            _advancedBusy = false;
            _advancedTargetLabel = null;
        }
    }

    private async Task CloseAdvancedAsync()
    {
        var sftp = _advancedSftp;
        var connection = _advancedConnection;
        _advancedSftp = null;
        _advancedConnection = null;
        _advancedHost = null;
        if (sftp is not null) await sftp.DisposeAsync();
        if (connection is not null) await connection.DisposeAsync();
        if (_lifetimeStarted)
        {
            await SessionLifetime.StopAsync();
            _lifetimeStarted = false;
        }
    }

    private void OnDirectoryChanged(object? sender, EventArgs e) =>
        _ = InvokeAsync(async () =>
        {
            _hosts = await Directory.GetHostsAsync();
            StateHasChanged();
        });

    public async ValueTask DisposeAsync()
    {
        Directory.Changed -= OnDirectoryChanged;
        await CloseAdvancedAsync();
    }
}
