@implements IAsyncDisposable
@inject IJSRuntime Js
@inject IEntitlementService Entitlements

<div class="appearance-page" data-testid="appearance-settings-page">
    <header class="topbar appearance-page__topbar">
        <button type="button" class="btn btn--icon" aria-label="Back to settings"
                data-testid="appearance-back" @onclick="OnClosed">
            <Icon Name="back" />
        </button>
        <span class="session__title">
            <span class="session__host">Appearance</span>
            <span class="session__address">Terminal theme & display</span>
        </span>
    </header>

    <section class="settings appearance-page__content">
        <div class="settings__section">
            <h2 class="section-label">Theme</h2>
            <p class="appearance-page__intro">Choose a terminal look with a live visual preview. Changes apply immediately to open and future sessions.</p>

            @if (_premiumPaused)
            {
                <p class="setting-card__body" role="status" data-testid="appearance-theme-paused">
                    Your saved @TerminalThemeCatalog.NameOf(_theme) theme needs MeowSSH Pro, so terminals use Meow Dark for now. It comes back as soon as Pro is active again.
                </p>
            }

            <div class="theme-grid" role="radiogroup" aria-label="Terminal theme" data-testid="theme-grid">
                @foreach (var option in TerminalThemeCatalog.All)
                {
                    var selected = string.Equals(_theme, option.Id, StringComparison.Ordinal);
                    var locked = option.IsPremium && !_premium;
                    <button type="button"
                            class="theme-card @(selected ? "is-selected" : "") @(locked ? "is-locked" : "")"
                            role="radio" aria-checked="@(selected ? "true" : "false")"
                            title="@(locked ? "Requires MeowSSH Pro" : null)"
                            data-testid="theme-@option.Id"
                            @onclick="() => SelectThemeAsync(option.Id)">
                        <span class="theme-preview" style="background:@option.Background;color:@option.Foreground">
                            <span class="theme-preview__dots" aria-hidden="true">
                                <span style="background:@option.Red"></span>
                                <span style="background:@option.Yellow"></span>
                                <span style="background:@option.Green"></span>
                            </span>
                            <span class="theme-preview__line"><span style="color:@option.Green">deploy</span><span style="color:@option.Foreground">@@server</span><span style="color:@option.Blue">:~</span>$ ssh prod</span>
                            <span class="theme-preview__line muted">Connected to production</span>
                            <span class="theme-preview__line"><span style="color:@option.Cyan">$</span> tail -f app.log <span class="theme-preview__cursor" style="background:@option.Cursor"></span></span>
                        </span>
                        <span class="theme-card__footer">
                            <span>
                                <strong>@option.Name @if (option.IsPremium) { <span class="action-pro-badge">PRO</span> }</strong>
                                <small>@option.Description</small>
                            </span>
                            <span class="theme-card__check" aria-hidden="true">@(selected ? "✓" : "")</span>
                        </span>
                    </button>
                }

                @{
                    var customSelected = string.Equals(_theme, TerminalThemeCatalog.CustomId, StringComparison.Ordinal);
                }
                <button type="button"
                        class="theme-card @(customSelected ? "is-selected" : "") @(_premium ? "" : "is-locked")"
                        role="radio" aria-checked="@(customSelected ? "true" : "false")"
                        title="@(_premium ? null : "Requires MeowSSH Pro")"
                        data-testid="theme-custom"
                        @onclick="() => SelectThemeAsync(TerminalThemeCatalog.CustomId)">
                    <span class="theme-preview" style="background:@_custom.Background;color:@_custom.Foreground">
                        <span class="theme-preview__line">Your colours</span>
                        <span class="theme-preview__line muted">on the @TerminalThemeCatalog.NameOf(_custom.Base) palette</span>
                        <span class="theme-preview__line">$ <span class="theme-preview__cursor" style="background:@_custom.Cursor"></span></span>
                    </span>
                    <span class="theme-card__footer">
                        <span>
                            <strong>Custom <span class="action-pro-badge">PRO</span></strong>
                            <small>Pick your own background, text and cursor colours.</small>
                        </span>
                        <span class="theme-card__check" aria-hidden="true">@(customSelected ? "✓" : "")</span>
                    </span>
                </button>
            </div>

            @if (_proHint)
            {
                <p class="setting-card__body" role="status" data-testid="appearance-pro-hint">
                    Premium themes, custom colours and per-host themes are part of MeowSSH Pro.
                </p>
            }
        </div>

        @if (_premium && string.Equals(_theme, TerminalThemeCatalog.CustomId, StringComparison.Ordinal))
        {
            <div class="settings__section" data-testid="custom-theme-editor">
                <h2 class="section-label">Custom theme</h2>
                <label class="setting-card" for="custom-theme-base">
                    <span class="setting-card__copy">
                        <span class="setting-card__title">Base palette</span>
                        <span class="setting-card__body">The 16 terminal colours programs use for output.</span>
                    </span>
                    <select id="custom-theme-base" class="field__input settings__select" data-testid="custom-theme-base"
                            value="@_custom.Base" @onchange="e => UpdateCustomAsync(_custom with { Base = e.Value?.ToString() ?? TerminalThemeCatalog.DefaultId })">
                        @foreach (var option in TerminalThemeCatalog.All)
                        {
                            <option value="@option.Id">@option.Name</option>
                        }
                    </select>
                </label>
                <label class="setting-card" for="custom-theme-background">
                    <span class="setting-card__copy"><span class="setting-card__title">Background</span></span>
                    <input id="custom-theme-background" type="color" class="settings__color" data-testid="custom-theme-background"
                           value="@_custom.Background" @onchange="e => UpdateCustomAsync(_custom with { Background = e.Value?.ToString() ?? _custom.Background })" />
                </label>
                <label class="setting-card" for="custom-theme-foreground">
                    <span class="setting-card__copy"><span class="setting-card__title">Text</span></span>
                    <input id="custom-theme-foreground" type="color" class="settings__color" data-testid="custom-theme-foreground"
                           value="@_custom.Foreground" @onchange="e => UpdateCustomAsync(_custom with { Foreground = e.Value?.ToString() ?? _custom.Foreground })" />
                </label>
                <label class="setting-card" for="custom-theme-cursor">
                    <span class="setting-card__copy"><span class="setting-card__title">Cursor</span></span>
                    <input id="custom-theme-cursor" type="color" class="settings__color" data-testid="custom-theme-cursor"
                           value="@_custom.Cursor" @onchange="e => UpdateCustomAsync(_custom with { Cursor = e.Value?.ToString() ?? _custom.Cursor })" />
                </label>
            </div>
        }

        <div class="settings__section">
            <h2 class="section-label">Text</h2>
            <label class="setting-card" for="terminal-zoom">
                <span class="setting-card__copy">
                    <span class="setting-card__title">Text size</span>
                    <span class="setting-card__body">Scale terminal text without changing Android display settings.</span>
                </span>
                <span class="setting-card__value mono" data-testid="terminal-zoom-value">@_zoom%</span>
            </label>
            <input id="terminal-zoom" class="range" type="range"
                   min="80" max="160" step="10" value="@_zoom"
                   data-testid="terminal-zoom" @oninput="OnZoomChangedAsync" />
            <div class="settings__range-labels" aria-hidden="true">
                <span>80%</span><span>160%</span>
            </div>
        </div>

        <div class="settings__section">
            <h2 class="section-label">Cursor & history</h2>
            <label class="setting-card" for="terminal-cursor-style">
                <span class="setting-card__copy">
                    <span class="setting-card__title">Cursor style</span>
                    <span class="setting-card__body">Choose a block, vertical bar, or underline cursor.</span>
                </span>
                <select id="terminal-cursor-style" class="field__input settings__select"
                        data-testid="terminal-cursor-style" value="@_cursorStyle" @onchange="OnCursorStyleChangedAsync">
                    <option value="block">Block</option>
                    <option value="bar">Bar</option>
                    <option value="underline">Underline</option>
                </select>
            </label>

            <label class="setting-card setting-card--toggle" for="terminal-cursor-blink">
                <span class="setting-card__copy">
                    <span class="setting-card__title">Blinking cursor</span>
                    <span class="setting-card__body">Disable this if you prefer a completely static terminal.</span>
                </span>
                <input id="terminal-cursor-blink" type="checkbox" class="settings__toggle"
                       data-testid="terminal-cursor-blink"
                       @bind="_cursorBlink" @bind:after="OnCursorBlinkChangedAsync" />
            </label>

            <label class="setting-card" for="terminal-scrollback">
                <span class="setting-card__copy">
                    <span class="setting-card__title">Scrollback</span>
                    <span class="setting-card__body">More lines preserve more terminal history but consume more memory.</span>
                </span>
                <select id="terminal-scrollback" class="field__input settings__select"
                        data-testid="terminal-scrollback" value="@_scrollback" @onchange="OnScrollbackChangedAsync">
                    <option value="1000">1,000 lines</option>
                    <option value="5000">5,000 lines</option>
                    <option value="10000">10,000 lines</option>
                    <option value="20000">20,000 lines</option>
                    <option value="50000">50,000 lines</option>
                </select>
            </label>
        </div>

        <div class="settings__section">
            <h2 class="section-label">Reset</h2>
            <button type="button" class="btn btn--ghost btn--block"
                    data-testid="terminal-settings-reset" @onclick="ResetAsync">
                Restore default appearance
            </button>
        </div>
    </section>
</div>

@code {
    private const int DefaultZoom = 100;
    private const string DefaultTheme = "meow-dark";
    private const string DefaultCursorStyle = "block";
    private const int DefaultScrollback = 5000;

    private IJSObjectReference? _module;
    private int _zoom = DefaultZoom;
    private string _theme = DefaultTheme;
    private string _cursorStyle = DefaultCursorStyle;
    private bool _cursorBlink = true;
    private int _scrollback = DefaultScrollback;
    private bool _premium;
    private bool _premiumPaused;
    private bool _proHint;
    private CustomTheme _custom = new(DefaultTheme, "#0b0e13", "#e7ebf2", "#ff8a5b");

    [Parameter] public EventCallback OnClosed { get; set; }

    private sealed record CustomTheme(string Base, string Background, string Foreground, string Cursor);

    private sealed class TerminalPreferences
    {
        public int Zoom { get; set; } = DefaultZoom;
        public string Theme { get; set; } = DefaultTheme;
        public string EffectiveTheme { get; set; } = DefaultTheme;
        public string CursorStyle { get; set; } = DefaultCursorStyle;
        public bool CursorBlink { get; set; } = true;
        public int Scrollback { get; set; } = DefaultScrollback;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _premium = Entitlements.Has(PremiumFeature.PremiumCustomization);
        try
        {
            _module = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/MeowSSH.UI/js/terminal.js");
            await _module.InvokeVoidAsync("setPremiumAllowed", _premium);
            _custom = await _module.InvokeAsync<CustomTheme>("getCustomTheme");
            Apply(await _module.InvokeAsync<TerminalPreferences>("getPreferences"));
        }
        catch
        {
            Apply(new TerminalPreferences());
        }
        StateHasChanged();
    }

    private void Apply(TerminalPreferences preferences)
    {
        _zoom = preferences.Zoom;
        _theme = preferences.Theme;
        _premiumPaused = !string.Equals(preferences.Theme, preferences.EffectiveTheme, StringComparison.Ordinal);
        _cursorStyle = preferences.CursorStyle;
        _cursorBlink = preferences.CursorBlink;
        _scrollback = preferences.Scrollback;
    }

    private async Task SetAsync(string name, object value)
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("setPreference", name, value);
    }

    private async Task SelectThemeAsync(string theme)
    {
        // Not just a hidden button: a non-Pro tap must not store the choice.
        if (TerminalThemeCatalog.IsPremium(theme) && !_premium)
        {
            _proHint = true;
            return;
        }
        _proHint = false;
        _theme = theme;
        _premiumPaused = false;
        await SetAsync("theme", theme);
    }

    private async Task UpdateCustomAsync(CustomTheme theme)
    {
        if (!_premium || _module is null) return;
        try
        {
            await _module.InvokeVoidAsync("setCustomTheme", theme);
            _custom = theme;
        }
        catch (JSException)
        {
            // terminal.js refused a value (not #rrggbb); keep the last good theme.
        }
    }

    private async Task OnZoomChangedAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var value)) return;
        _zoom = Math.Clamp(value, 80, 160);
        await SetAsync("zoom", _zoom);
    }

    private async Task OnCursorStyleChangedAsync(ChangeEventArgs e)
    {
        _cursorStyle = e.Value?.ToString() ?? DefaultCursorStyle;
        await SetAsync("cursorStyle", _cursorStyle);
    }

    private Task OnCursorBlinkChangedAsync() => SetAsync("cursorBlink", _cursorBlink);

    private async Task OnScrollbackChangedAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var value)) return;
        _scrollback = Math.Clamp(value, 1000, 50000);
        await SetAsync("scrollback", _scrollback);
    }

    private async Task ResetAsync()
    {
        if (_module is null) return;
        Apply(await _module.InvokeAsync<TerminalPreferences>("resetPreferences"));
        _custom = await _module.InvokeAsync<CustomTheme>("getCustomTheme");
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try { await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
