@using MeowSSH.Core.Diagnostics
@inject IPendingDiagnosticReportStore PendingReports
@inject ILocalFileTransferService LocalFiles
@inject DiagnosticsInstallIdentity InstallIdentity
@inject IDiagnosticReportUploadService ReportUploader

<AppShell Title="Privacy & diagnostics" ActiveTab="settings">
    <Actions>
        <button type="button" class="btn btn--icon" aria-label="Back to Settings"
                data-testid="privacy-diagnostics-back" @onclick="OnClosed">
            <Icon Name="back" />
        </button>
    </Actions>
    <ChildContent>
        <section class="settings" data-testid="privacy-diagnostics-page">
            <div class="settings__section">
                <h2 class="section-label">Report a problem</h2>
                <p class="setting-card__body">
                    Describe what happened. MeowSSH can create a local report you can review and share with support,
                    or, if you attach anonymized crash diagnostics below, send just that diagnostic data directly.
                    Nothing is uploaded automatically -- both actions require you to press a button below.
                </p>

                <label class="field">
                    <span class="field__label">What went wrong?</span>
                    <textarea class="field__input" rows="5" maxlength="4096"
                              data-testid="bug-description" @bind="_description" @bind:event="oninput"
                              placeholder="Tell us what happened and where you were in the app."></textarea>
                </label>

                <details class="setting-card diagnostic-extra" data-testid="bug-report-more-details">
                    <summary>More details</summary>
                    <div class="diagnostic-extra__body">
                        <label class="field">
                            <span class="field__label">What did you expect?</span>
                            <textarea class="field__input" rows="3" maxlength="2048"
                                      data-testid="bug-expected" @bind="_expected" @bind:event="oninput"></textarea>
                        </label>
                        <label class="field">
                            <span class="field__label">Steps to reproduce</span>
                            <textarea class="field__input" rows="4" maxlength="4096"
                                      data-testid="bug-steps" @bind="_steps" @bind:event="oninput"></textarea>
                        </label>
                    </div>
                </details>

                @if (_pendingReport is not null)
                {
                    <label class="setting-card setting-card--toggle" for="attach-diagnostics">
                        <span class="setting-card__copy">
                            <span class="setting-card__title">Attach anonymized crash diagnostics</span>
                            <span class="setting-card__body">Off by default. Includes sanitized stack traces, app version and recent high-level app actions only.</span>
                        </span>
                        <input id="attach-diagnostics" type="checkbox" class="settings__toggle"
                               data-testid="attach-bug-diagnostics" @bind="_attachDiagnostics" />
                    </label>

                    @if (_attachDiagnostics)
                    {
                        <details class="setting-card diagnostic-extra" data-testid="bug-diagnostic-review">
                            <summary>Review attached diagnostics</summary>
                            <div class="diagnostic-extra__body">
                                <p class="setting-card__body">
                                    Not included: terminal contents, commands, host names, addresses, usernames, file names, passwords, keys, or account identifiers.
                                </p>
                                <dl class="diagnostic-review__metadata">
                                    <div><dt>App</dt><dd class="mono">@_pendingReport.AppVersion</dd></div>
                                    <div><dt>Platform</dt><dd>@_pendingReport.Platform</dd></div>
                                    <div><dt>Captured</dt><dd>@_pendingReport.CapturedAtUtc.ToLocalTime().ToString("g")</dd></div>
                                </dl>
                                @foreach (var exception in _pendingReport.Exceptions)
                                {
                                    <div class="diagnostic-review__exception">
                                        <strong class="mono">@exception.Type</strong>
                                        @if (!string.IsNullOrWhiteSpace(exception.Message))
                                        {
                                            <pre>@exception.Message</pre>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(exception.StackTrace))
                                        {
                                            <pre>@exception.StackTrace</pre>
                                        }
                                    </div>
                                }
                                @if (_pendingReport.Breadcrumbs.Count > 0)
                                {
                                    <div>
                                        <strong>Recent app actions</strong>
                                        <ul>
                                            @foreach (var breadcrumb in _pendingReport.Breadcrumbs)
                                            {
                                                <li>@breadcrumb.Kind</li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        </details>

                        <button type="button" class="btn btn--ghost btn--block"
                                data-testid="send-diagnostics" disabled="@_busy"
                                @onclick="SendDiagnosticsAsync">
                            @(_busy ? "Sending…" : "Send anonymized crash report")
                        </button>
                    }
                }
                else
                {
                    <div class="setting-card" data-testid="no-pending-diagnostics">
                        <span class="setting-card__copy">
                            <span class="setting-card__title">No crash diagnostics waiting</span>
                            <span class="setting-card__body">A normal bug report can still be exported without diagnostic data.</span>
                        </span>
                    </div>
                }

                @*
                    The card above says a report can still be exported without
                    diagnostic data, and the button below was disabled anyway —
                    the page told the user the action was available and then
                    refused it. The real precondition is a description, so say so.
                *@
                @if (!_busy && string.IsNullOrWhiteSpace(_description))
                {
                    <p class="form__hint" data-testid="export-bug-report-hint">
                        Describe what went wrong above to export a report.
                    </p>
                }

                <button type="button" class="btn btn--primary btn--block"
                        data-testid="export-bug-report" disabled="@(_busy || string.IsNullOrWhiteSpace(_description))"
                        @onclick="ExportAsync">
                    @(_busy ? "Preparing…" : "Export report")
                </button>

                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <p class="setting-card__body" role="status" data-testid="bug-report-message">@_message</p>
                }
            </div>

            <div class="settings__section">
                <h2 class="section-label">Privacy</h2>
                <div class="setting-card">
                    <span class="setting-card__copy">
                        <span class="setting-card__title">Diagnostics stay local until you choose otherwise</span>
                        <span class="setting-card__body">Crash capture and report preparation do not silently submit analytics or diagnostic data.</span>
                    </span>
                </div>

                @*
                    Off by default, matching every other diagnostics default on this
                    page. The id this enables is random and per-install (see
                    DiagnosticsInstallIdentity) -- never derived from this device or
                    the signed-in account -- and it only ever rides along inside a
                    report the person themselves chooses to export or send above.
                    This setting exists so that, if a report leaves the device --
                    exported and shared manually, or sent with the button above --
                    whoever receives it can tell it apart from reports from other
                    installs, and so the person can turn that off with one visible
                    switch. Turning it off does not stop "Send anonymized crash
                    report" from working; it only stops that report from carrying an
                    id (installId is passed as null to DiagnosticReportUploadService).
                *@
                <label class="setting-card setting-card--toggle" for="send-diagnostics-id">
                    <span class="setting-card__copy">
                        <span class="setting-card__title">Include an anonymous install id in exported or sent reports</span>
                        <span class="setting-card__body">Off by default. A random id, not derived from this device or your account, so support can tell reports from one install apart. Never sent on its own -- only ever included in a report you export or send above.</span>
                    </span>
                    <input id="send-diagnostics-id" type="checkbox" class="settings__toggle"
                           data-testid="send-diagnostics-toggle" checked="@_sendDiagnosticsEnabled"
                           disabled="@_busy" @onchange="OnSendDiagnosticsToggledAsync" />
                </label>

                @if (_sendDiagnosticsEnabled)
                {
                    <button type="button" class="btn btn--ghost btn--block"
                            data-testid="reset-diagnostics-id" disabled="@_busy" @onclick="ResetDiagnosticsIdAsync">
                        Reset diagnostics identifier
                    </button>
                }

                @if (_pendingReport is not null)
                {
                    <button type="button" class="btn btn--ghost btn--block"
                            data-testid="discard-pending-diagnostics" disabled="@_busy" @onclick="DiscardPendingAsync">
                        Discard saved crash diagnostics
                    </button>
                }
            </div>
        </section>
    </ChildContent>
</AppShell>

@code {
    [Parameter] public EventCallback OnClosed { get; set; }

    private DiagnosticReportSnapshot? _pendingReport;
    private string _description = string.Empty;
    private string _expected = string.Empty;
    private string _steps = string.Empty;
    private bool _attachDiagnostics;
    private bool _sendDiagnosticsEnabled;
    private bool _busy;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        _pendingReport = await PendingReports.LoadAsync();
        _sendDiagnosticsEnabled = await InstallIdentity.IsEnabledAsync();
    }

    private async Task OnSendDiagnosticsToggledAsync(ChangeEventArgs args)
    {
        if (_busy) return;
        var enabled = args.Value is bool value && value;
        _busy = true;
        try
        {
            // SetEnabledAsync clears the stored id itself when turning off, so a
            // person who disables this and re-enables it later gets a fresh,
            // unrelated id rather than picking the old one back up.
            await InstallIdentity.SetEnabledAsync(enabled);
            _sendDiagnosticsEnabled = enabled;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ResetDiagnosticsIdAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await InstallIdentity.ResetIdAsync();
            _message = "Diagnostics identifier reset. The next report will use a new, unrelated id.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ExportAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_description)) return;
        _busy = true;
        _message = null;
        string? temporary = null;
        try
        {
            var installId = _attachDiagnostics ? await InstallIdentity.GetIdForReportAsync() : null;
            var text = BugReportExportBuilder.Build(
                _description,
                _expected,
                _steps,
                _attachDiagnostics ? _pendingReport : null,
                installId);
            var name = $"meowssh-bug-report-{DateTime.UtcNow:yyyyMMdd-HHmmss}.txt";
            temporary = LocalFiles.CreateTemporaryPath(name);
            await File.WriteAllTextAsync(temporary, text);
            var destination = await LocalFiles.PublishDownloadAsync(temporary, name);
            _message = $"Bug report exported to {destination}";
        }
        catch (Exception exception) when (exception is ArgumentException or IOException or UnauthorizedAccessException)
        {
            _message = exception.Message;
        }
        finally
        {
            if (temporary is not null) LocalFiles.DeleteTemporaryFile(temporary);
            _busy = false;
        }
    }

    private async Task SendDiagnosticsAsync()
    {
        // Mirrors ExportAsync's own guard shape, plus _pendingReport is null: there
        // is nothing to send, unlike export, which can still produce a text file
        // with just the typed description and no diagnostics attached.
        if (_busy || _pendingReport is null || !_attachDiagnostics) return;
        _busy = true;
        _message = null;
        try
        {
            var installId = await InstallIdentity.GetIdForReportAsync();
            var sent = await ReportUploader.TryUploadAsync(_pendingReport, installId);
            _message = sent
                ? "Diagnostics sent. Thank you for helping improve MeowSSH."
                : "Couldn't send diagnostics right now. Check your connection and try again, or export a report instead.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DiscardPendingAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await PendingReports.ClearAsync();
            _pendingReport = null;
            _attachDiagnostics = false;
            _message = "Saved crash diagnostics discarded.";
        }
        finally
        {
            _busy = false;
        }
    }
}
