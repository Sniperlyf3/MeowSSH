@using System.Text
@implements IAsyncDisposable
@inject IHostEditor Editor
@inject ISshHardwareKeyStore HardwareKeys
@inject IJSRuntime Js

<AppShell Title="Keys" ActiveTab="keys" OnTabSelected="OnTabSelected">
    @*
        No header Actions here on purpose -- audit B1. This header used to carry
        a "+" (aria-label "Add credential") unconditionally, so an empty vault
        showed it next to the empty state's own "Add credential" button, both
        calling StartAdding. A non-empty vault has the same duplication against
        the list header's own "+ Add" (below, data-testid="add-credential-list").
        Each state already owns exactly one entry point to StartAdding: the
        empty state while there is nothing saved, the list header once there is.
    *@
    <ChildContent>
        <section class="keys-page" data-testid="keys-page">
            @if (_adding)
            {
                <div class="keys-editor">
                    @if (_creationFlow is null)
                    {
                        <div class="keys-editor__intro">
                            <span class="keys-editor__glyph" aria-hidden="true"><Icon Name="key" /></span>
                            <span>
                                <strong>Add credential</strong>
                                <small>Choose what you want to add. Each path only shows the fields it needs.</small>
                            </span>
                        </div>

                        <div class="credential-flow-picker" data-testid="credential-flow-picker">
                            <button type="button" class="credential-flow" data-testid="flow-generate-key"
                                    @onclick="() => ChooseFlowAsync(CredentialCreationFlow.GeneratePrivateKey)">
                                <span class="credential-flow__icon"><Icon Name="key" /></span>
                                <span><strong>Generate SSH key</strong><small>Create a new RSA key pair locally and copy its public key to your server.</small></span>
                                <Icon Name="chevron-right" />
                            </button>
                            <button type="button" class="credential-flow" data-testid="flow-import-key"
                                    @onclick="() => ChooseFlowAsync(CredentialCreationFlow.ImportPrivateKey)">
                                <span class="credential-flow__icon"><Icon Name="download" /></span>
                                <span><strong>Import private key</strong><small>Paste an existing private key and optional passphrase into the encrypted vault.</small></span>
                                <Icon Name="chevron-right" />
                            </button>
                            <button type="button" class="credential-flow" data-testid="flow-device-key"
                                    @onclick="() => ChooseFlowAsync(CredentialCreationFlow.HardwareKey)">
                                <span class="credential-flow__icon"><Icon Name="shield" /></span>
                                <span><strong>Device key</strong><small>Generate a non-exportable P-256 key inside Android Keystore.</small></span>
                                <Icon Name="chevron-right" />
                            </button>
                            <button type="button" class="credential-flow" data-testid="flow-public-key"
                                    @onclick="() => ChooseFlowAsync(CredentialCreationFlow.PublicKey)">
                                <span class="credential-flow__icon"><Icon Name="key" /></span>
                                <span><strong>Public key only</strong><small>Save an authorization-only key for Tailcat allowlists; no private key is stored.</small></span>
                                <Icon Name="chevron-right" />
                            </button>
                            <button type="button" class="credential-flow" data-testid="flow-password"
                                    @onclick="() => ChooseFlowAsync(CredentialCreationFlow.Password)">
                                <span class="credential-flow__icon"><Icon Name="lock" /></span>
                                <span><strong>Password</strong><small>Save a reusable username/password credential in the encrypted vault.</small></span>
                                <Icon Name="chevron-right" />
                            </button>
                        </div>

                        <button type="button" class="btn btn--ghost btn--block" data-testid="cancel-credential"
                                @onclick="CancelAsync">Cancel</button>
                    }
                    else
                    {
                        <div class="keys-editor__intro">
                            <span class="keys-editor__glyph" aria-hidden="true"><Icon Name="@FlowIcon" /></span>
                            <span>
                                <strong>@FlowTitle</strong>
                                <small>@FlowDescription</small>
                            </span>
                        </div>

                        <button type="button" class="keys-editor__change-type" data-testid="change-credential-type"
                                disabled="@_busy" @onclick="BackToFlowPickerAsync">
                            <Icon Name="back" /> Choose another type
                        </button>

                        <div class="form" data-testid="credential-editor">
                            <label class="field">
                                <span class="field__label">Name</span>
                                <input class="field__input" type="text" data-testid="credential-label"
                                       placeholder="deploy key" autocomplete="off"
                                       @bind="_label" @bind:event="oninput" />
                            </label>

                            <label class="field">
                                <span class="field__label">Username</span>
                                <input class="field__input mono" type="text" data-testid="credential-username"
                                       placeholder="deploy" autocomplete="off" autocapitalize="none" spellcheck="false"
                                       @bind="_username" @bind:event="oninput" />
                                <span class="field__hint">Optional. Used when a host does not name its own.</span>
                            </label>

                            @if (_creationFlow == CredentialCreationFlow.GeneratePrivateKey)
                            {
                                <button type="button" class="btn btn--primary btn--block"
                                        data-testid="generate-ssh-key" @onclick="GenerateSshKey">
                                    <Icon Name="key" /> @(string.IsNullOrWhiteSpace(_secret) ? "Generate key pair" : "Generate replacement key")
                                </button>
                                <span class="field__hint">Generates a 3072-bit RSA key pair locally. The private key goes directly into your encrypted vault.</span>

                                @if (!string.IsNullOrWhiteSpace(_publicKey))
                                {
                                    <div class="keys-generated" data-testid="generated-key-ready">
                                        <span class="keys-generated__status"><Icon Name="shield" /> Private key ready and kept local</span>
                                        <label class="field">
                                            <span class="field__label">Public key</span>
                                            <textarea class="field__input field__input--code mono" rows="4"
                                                      data-testid="generated-public-key" readonly>@_publicKey</textarea>
                                            <button type="button" class="btn btn--ghost"
                                                    data-testid="copy-generated-public-key"
                                                    @onclick="() => CopyPublicKeyAsync(_publicKey)">Copy public key</button>
                                            <span class="field__hint">Add this public key to the server's authorized_keys file.</span>
                                        </label>
                                    </div>
                                }
                            }
                            else if (_creationFlow == CredentialCreationFlow.ImportPrivateKey)
                            {
                                <label class="field">
                                    <span class="field__label">Private key</span>
                                    <textarea class="field__input field__input--code mono" rows="7"
                                              data-testid="credential-secret"
                                              placeholder="-----BEGIN OPENSSH PRIVATE KEY-----"
                                              autocomplete="off" autocapitalize="none" spellcheck="false"
                                              @bind="_secret" @bind:event="oninput"></textarea>
                                    <span class="field__hint">Pasted as-is and sealed inside the vault when you save.</span>
                                </label>
                                <label class="field">
                                    <span class="field__label">Key passphrase</span>
                                    <input class="field__input mono" type="password" data-testid="credential-passphrase"
                                           autocomplete="off" @bind="_passphrase" @bind:event="oninput" />
                                    <span class="field__hint">Leave blank if the key has none.</span>
                                </label>
                            }
                            else if (_creationFlow == CredentialCreationFlow.HardwareKey)
                            {
                                <div class="keys-security-note" role="note" data-testid="hardware-key-explanation">
                                    <span class="keys-security-note__icon" aria-hidden="true"><Icon Name="shield" /></span>
                                    <span>
                                        <strong>Non-exportable device key</strong>
                                        <small>Android generates the P-256 private key inside Android Keystore. MeowSSH can ask it to sign, but cannot read or export the private key.</small>
                                    </span>
                                </div>
                                <button type="button" class="btn btn--primary btn--block"
                                        disabled="@_busy" data-testid="generate-hardware-key"
                                        @onclick="GenerateHardwareKeyAsync">
                                    <Icon Name="shield" /> @(_pendingHardwareKey is null ? "Generate device key" : "Replace generated key")
                                </button>
                                @if (_pendingHardwareKey is { } generated)
                                {
                                    <p class="note" data-testid="generated-hardware-key-status">
                                        <Icon Name="shield" /> @BackingLabel(generated)
                                    </p>
                                    <label class="field">
                                        <span class="field__label">Public key</span>
                                        <textarea class="field__input field__input--code mono" rows="4"
                                                  data-testid="generated-hardware-public-key" readonly>@generated.PublicKey</textarea>
                                        <button type="button" class="btn btn--ghost"
                                                data-testid="copy-generated-public-key"
                                                @onclick="() => CopyPublicKeyAsync(generated.PublicKey)">Copy public key</button>
                                        <span class="field__hint">Add this public key to the server. Only the public half is copyable.</span>
                                    </label>
                                }
                                @if (_hardwareError is not null)
                                {
                                    <p class="lock__error" role="alert" data-testid="hardware-key-error">@_hardwareError</p>
                                }
                            }
                            else if (_creationFlow == CredentialCreationFlow.PublicKey)
                            {
                                <label class="field">
                                    <span class="field__label">Public key</span>
                                    <textarea class="field__input field__input--code mono" rows="5"
                                              data-testid="credential-public-key"
                                              placeholder="ssh-ed25519 AAAA... user@host"
                                              autocomplete="off" autocapitalize="none" spellcheck="false"
                                              @bind="_publicKey" @bind:event="oninput"></textarea>
                                    <span class="field__hint">Authorization-only key. Useful for Tailcat shell allowlists; no private key is stored.</span>
                                </label>
                            }
                            else if (_creationFlow == CredentialCreationFlow.Password)
                            {
                                <label class="field">
                                    <span class="field__label">Password</span>
                                    <div class="field__with-action">
                                        <input class="field__input mono" data-testid="credential-secret"
                                               type="@(_revealed ? "text" : "password")"
                                               autocomplete="off" autocapitalize="none" spellcheck="false"
                                               @bind="_secret" @bind:event="oninput" />
                                        <button type="button" class="btn btn--icon"
                                                aria-label="@(_revealed ? "Hide password" : "Show password")"
                                                data-testid="reveal-secret" @onclick="() => _revealed = !_revealed">
                                            <Icon Name="@(_revealed ? "eye-off" : "eye")" />
                                        </button>
                                    </div>
                                </label>
                            }

                            <div class="form__actions">
                                <button type="button" class="btn btn--primary btn--block"
                                        disabled="@(_busy || !IsComplete)" data-testid="save-credential"
                                        @onclick="SaveAsync">@(_busy ? "Saving…" : "Save to vault")</button>
                                <button type="button" class="btn btn--ghost btn--block"
                                        disabled="@_busy" data-testid="cancel-credential" @onclick="CancelAsync">Cancel</button>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (_credentials.Count == 0)
            {
                <div class="empty keys-empty" data-testid="keys-empty">
                    <span class="empty__glyph"><Icon Name="key" /></span>
                    <p class="empty__title">No saved credentials</p>
                    <p class="empty__body">Generate or import a key, add a device key, or save a password once and reuse it across hosts.</p>
                    <button type="button" class="btn btn--primary" data-testid="add-credential" @onclick="StartAdding"><Icon Name="plus" /> Add your first credential</button>
                </div>
            }
            else
            {
                <div class="keys-header">
                    <div>
                        <h2>Saved credentials</h2>
                        <p>@_credentials.Count credential@(_credentials.Count == 1 ? "" : "s") in this vault</p>
                    </div>
                    <button type="button" class="btn btn--ghost keys-header__add" data-testid="add-credential-list" @onclick="StartAdding">
                        <Icon Name="plus" /> Add
                    </button>
                </div>

                <div class="credential-list" data-testid="credential-list">
                    @foreach (var credential in _credentials)
                    {
                        <article class="credential-card" data-testid="credential-row">
                            <span class="credential-card__icon" aria-hidden="true">
                                <Icon Name="@(credential.Kind == CredentialKind.Password ? "lock" : credential.Kind == CredentialKind.HardwareKey ? "shield" : "key")" />
                            </span>
                            <span class="credential-card__body">
                                <span class="credential-card__title-row">
                                    <strong class="credential-card__title">@credential.Label</strong>
                                    <span class="credential-card__kind">@CredentialKindLabel(credential.Kind)</span>
                                </span>
                                <span class="credential-card__hint mono">@credential.DisplayHint</span>
                                @if (credential.Kind == CredentialKind.HardwareKey)
                                {
                                    <span class="credential-card__hint" data-testid="hardware-key-status">@SavedHardwareStatus(credential)</span>
                                }
                            </span>

                            <details class="credential-card__manage" data-testid="manage-credential">
                                <summary>Manage</summary>
                                <div class="credential-card__manage-actions">
                                    @if (!string.IsNullOrWhiteSpace(credential.PublicKey))
                                    {
                                        <button type="button" class="btn btn--ghost"
                                                data-testid="show-public-key"
                                                @onclick="() => TogglePublicKey(credential.Id)">
                                            <Icon Name="key" /> @(_expandedPublicKeyId == credential.Id ? "Hide public key" : "Show public key")
                                        </button>
                                        <button type="button" class="btn btn--ghost"
                                                data-testid="copy-public-key"
                                                @onclick="() => CopyPublicKeyAsync(credential.PublicKey!)">
                                            <Icon Name="copy" /> Copy public key
                                        </button>
                                    }
                                    <button type="button" class="btn btn--danger"
                                            data-testid="delete-credential"
                                            @onclick="() => DeleteAsync(credential)">
                                        <Icon Name="trash" /> Delete credential
                                    </button>
                                </div>
                            </details>

                            @if (_expandedPublicKeyId == credential.Id && !string.IsNullOrWhiteSpace(credential.PublicKey))
                            {
                                <textarea class="field__input field__input--code mono credential-card__public-key"
                                          rows="4" readonly data-testid="public-key-value">@credential.PublicKey</textarea>
                            }
                        </article>
                    }
                </div>

                <div class="keys-security-note" role="note" data-testid="keys-delete-note">
                    <span class="keys-security-note__icon" aria-hidden="true"><Icon Name="shield" /></span>
                    <span>
                        <strong>Credential material stays local.</strong>
                        <small>Deleting a credential from Manage wipes its vault material immediately. Device-key deletion also removes the Android Keystore key from this device.</small>
                    </span>
                </div>
            }
        </section>
    </ChildContent>
</AppShell>

@code {
    private enum CredentialCreationFlow
    {
        GeneratePrivateKey,
        ImportPrivateKey,
        HardwareKey,
        PublicKey,
        Password,
    }

    private IReadOnlyList<CredentialSummary> _credentials = [];
    private readonly Dictionary<Guid, SshHardwareKeyInfo?> _hardwareInfo = [];
    private bool _adding;
    private bool _busy;
    private bool _revealed;
    private string _label = "";
    private string _username = "";
    private string _secret = "";
    private string _passphrase = "";
    private string _publicKey = "";
    private string? _hardwareError;
    private Guid? _expandedPublicKeyId;
    private Guid? _pendingHardwareCredentialId;
    private SshHardwareKeyInfo? _pendingHardwareKey;
    private CredentialCreationFlow? _creationFlow;
    private CredentialKind _kind = CredentialKind.PrivateKey;

    [Parameter] public EventCallback<string> OnTabSelected { get; set; }

    private string FlowTitle => _creationFlow switch
    {
        CredentialCreationFlow.GeneratePrivateKey => "Generate SSH key",
        CredentialCreationFlow.ImportPrivateKey => "Import private key",
        CredentialCreationFlow.HardwareKey => "Device key",
        CredentialCreationFlow.PublicKey => "Public key only",
        CredentialCreationFlow.Password => "Password",
        _ => "Add credential",
    };

    private string FlowDescription => _creationFlow switch
    {
        CredentialCreationFlow.GeneratePrivateKey => "Create a key pair locally without exposing the private key in the editor.",
        CredentialCreationFlow.ImportPrivateKey => "Store an existing private key in your encrypted vault.",
        CredentialCreationFlow.HardwareKey => "Create a non-exportable key backed by Android Keystore.",
        CredentialCreationFlow.PublicKey => "Store an authorization-only public key without private material.",
        CredentialCreationFlow.Password => "Store reusable username/password authentication.",
        _ => "Stored encrypted in your vault and reusable across hosts.",
    };

    private string FlowIcon => _creationFlow switch
    {
        CredentialCreationFlow.HardwareKey => "shield",
        CredentialCreationFlow.Password => "lock",
        _ => "key",
    };

    private bool IsComplete => _creationFlow is not null && !string.IsNullOrWhiteSpace(_label) && (_kind switch
    {
        CredentialKind.PublicKey => !string.IsNullOrWhiteSpace(_publicKey),
        CredentialKind.HardwareKey => _pendingHardwareKey is not null,
        _ => _secret.Length > 0,
    });

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _credentials = await Editor.GetCredentialsAsync();
        _hardwareInfo.Clear();
        foreach (var credential in _credentials.Where(c => c.Kind == CredentialKind.HardwareKey))
        {
            SshHardwareKeyInfo? info = null;
            if (!string.IsNullOrWhiteSpace(credential.HardwareKeyId))
            {
                try { info = await HardwareKeys.GetInfoAsync(credential.HardwareKeyId); }
                catch { }
            }
            _hardwareInfo[credential.Id] = info;
        }
    }

    private void StartAdding()
    {
        _adding = true;
        _creationFlow = null;
        ResetDraft();
    }

    private void ResetDraft()
    {
        _label = _username = _secret = _passphrase = _publicKey = "";
        _kind = CredentialKind.PrivateKey;
        _revealed = false;
        _hardwareError = null;
        _pendingHardwareCredentialId = null;
        _pendingHardwareKey = null;
    }

    private void FinishAdding()
    {
        _adding = false;
        _creationFlow = null;
        _secret = _passphrase = _publicKey = "";
        _hardwareError = null;
        _pendingHardwareCredentialId = null;
        _pendingHardwareKey = null;
    }

    private async Task ChooseFlowAsync(CredentialCreationFlow flow)
    {
        if (_pendingHardwareKey is not null) await DeletePendingHardwareKeyAsync();
        _creationFlow = flow;
        _kind = flow switch
        {
            CredentialCreationFlow.HardwareKey => CredentialKind.HardwareKey,
            CredentialCreationFlow.PublicKey => CredentialKind.PublicKey,
            CredentialCreationFlow.Password => CredentialKind.Password,
            _ => CredentialKind.PrivateKey,
        };
        _secret = _passphrase = _publicKey = "";
        _revealed = false;
        _hardwareError = null;
    }

    private async Task BackToFlowPickerAsync()
    {
        if (_pendingHardwareKey is not null) await DeletePendingHardwareKeyAsync();
        _creationFlow = null;
        _secret = _passphrase = _publicKey = "";
        _hardwareError = null;
    }

    private async Task GenerateHardwareKeyAsync()
    {
        _busy = true;
        _hardwareError = null;
        try
        {
            if (_pendingHardwareKey is not null) await DeletePendingHardwareKeyAsync();
            var credentialId = Guid.NewGuid();
            var keyId = credentialId.ToString("N");
            _pendingHardwareCredentialId = credentialId;
            try
            {
                _pendingHardwareKey = await HardwareKeys.GenerateP256Async(keyId);
                _publicKey = _pendingHardwareKey.PublicKey;
            }
            catch
            {
                try { await HardwareKeys.DeleteAsync(keyId); } catch { }
                _pendingHardwareCredentialId = null;
                throw;
            }
        }
        catch (Exception ex)
        {
            _hardwareError = ex.Message;
        }
        finally { _busy = false; }
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            var id = _kind == CredentialKind.HardwareKey
                ? _pendingHardwareCredentialId ?? throw new InvalidOperationException("Generate the device key before saving.")
                : Guid.NewGuid();

            await Editor.SaveCredentialAsync(new CredentialRecord
            {
                Id = id,
                Label = _label.Trim(),
                Kind = _kind,
                Username = string.IsNullOrWhiteSpace(_username) ? null : _username.Trim(),
                Secret = _kind switch
                {
                    CredentialKind.PublicKey => [],
                    CredentialKind.HardwareKey => Encoding.UTF8.GetBytes(_pendingHardwareKey!.KeyId),
                    _ => Encoding.UTF8.GetBytes(_secret),
                },
                Passphrase = _creationFlow == CredentialCreationFlow.ImportPrivateKey && _passphrase.Length > 0
                    ? Encoding.UTF8.GetBytes(_passphrase)
                    : null,
                PublicKey = (_kind is CredentialKind.PrivateKey or CredentialKind.PublicKey or CredentialKind.HardwareKey)
                    && !string.IsNullOrWhiteSpace(_publicKey) ? _publicKey.Trim() : null,
            });

            _pendingHardwareKey = null;
            _pendingHardwareCredentialId = null;
            FinishAdding();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            if (_kind == CredentialKind.HardwareKey) _hardwareError = ex.Message;
            else throw;
        }
        finally { _busy = false; }
    }

    private async Task CancelAsync()
    {
        await DeletePendingHardwareKeyAsync();
        FinishAdding();
    }

    private async Task DeletePendingHardwareKeyAsync()
    {
        if (_pendingHardwareKey is not { } pending) return;
        try { await HardwareKeys.DeleteAsync(pending.KeyId); }
        finally
        {
            _pendingHardwareKey = null;
            _pendingHardwareCredentialId = null;
            _publicKey = "";
        }
    }

    private static string CredentialKindLabel(CredentialKind kind) => kind switch
    {
        CredentialKind.Password => "Password",
        CredentialKind.PublicKey => "Public key",
        CredentialKind.HardwareKey => "Device key",
        _ => "Private key",
    };

    private static string BackingLabel(SshHardwareKeyInfo info) => info.StrongBoxBacked
        ? "StrongBox-backed · private key cannot be exported"
        : info.HardwareBacked
            ? "Hardware-backed · private key cannot be exported"
            : "Android Keystore · private key cannot be exported";

    private string SavedHardwareStatus(CredentialSummary credential)
    {
        if (!_hardwareInfo.TryGetValue(credential.Id, out var info) || info is null)
            return "Unavailable on this device — this non-exportable private key cannot be restored. Generate a replacement key and update the server.";
        return BackingLabel(info);
    }

    private void GenerateSshKey()
    {
        var generated = SshKeyGenerator.GenerateRsa(string.IsNullOrWhiteSpace(_label) ? "meowssh" : _label.Trim());
        _secret = generated.PrivateKey;
        _publicKey = generated.PublicKey;
        _passphrase = "";
    }

    private void TogglePublicKey(Guid credentialId) =>
        _expandedPublicKeyId = _expandedPublicKeyId == credentialId ? null : credentialId;

    private async Task CopyPublicKeyAsync(string publicKey)
    {
        await using var clipboard = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/MeowSSH.UI/js/clipboard.js");
        await clipboard.InvokeAsync<bool>("copyText", publicKey);
    }

    private async Task DeleteAsync(CredentialSummary credential)
    {
        await Editor.DeleteCredentialAsync(credential.Id);
        if (credential.Kind == CredentialKind.HardwareKey && !string.IsNullOrWhiteSpace(credential.HardwareKeyId))
            await HardwareKeys.DeleteAsync(credential.HardwareKeyId);
        if (_expandedPublicKeyId == credential.Id) _expandedPublicKeyId = null;
        await ReloadAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_pendingHardwareKey is not null) await DeletePendingHardwareKeyAsync();
    }
}
