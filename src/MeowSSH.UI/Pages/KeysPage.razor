@using System.Text
@inject IHostEditor Editor
@inject IJSRuntime Js

<AppShell Title="Keys" ActiveTab="keys" OnTabSelected="OnTabSelected">
    <Actions>
        @if (!_adding)
        {
            <button type="button" class="btn btn--icon" aria-label="Add key"
                    data-testid="add-credential" @onclick="StartAdding">
                <Icon Name="plus" />
            </button>
        }
    </Actions>

    <ChildContent>
        <section class="keys-page" data-testid="keys-page">
            @if (_adding)
            {
                <div class="keys-editor">
                    <div class="keys-editor__intro">
                        <span class="keys-editor__glyph" aria-hidden="true"><Icon Name="key" /></span>
                        <span>
                            <strong>Add credential</strong>
                            <small>Stored encrypted in your vault and reusable across hosts.</small>
                        </span>
                    </div>

                    <div class="form" data-testid="credential-editor">
                        <label class="field">
                            <span class="field__label">Name</span>
                            <input class="field__input" type="text" data-testid="credential-label"
                                   placeholder="deploy key" autocomplete="off"
                                   @bind="_label" @bind:event="oninput" />
                        </label>

                        <fieldset class="field">
                            <legend class="field__label">Kind</legend>
                            <div class="segmented" role="radiogroup" aria-label="Credential kind">
                                <button type="button"
                                        class="segmented__option @(_kind == CredentialKind.PrivateKey ? "segmented__option--on" : "")"
                                        role="radio" aria-checked="@(_kind == CredentialKind.PrivateKey ? "true" : "false")"
                                        data-testid="kind-key" @onclick="() => _kind = CredentialKind.PrivateKey">Private key</button>
                                <button type="button"
                                        class="segmented__option @(_kind == CredentialKind.PublicKey ? "segmented__option--on" : "")"
                                        role="radio" aria-checked="@(_kind == CredentialKind.PublicKey ? "true" : "false")"
                                        data-testid="kind-public-key" @onclick="() => _kind = CredentialKind.PublicKey">Public key</button>
                                <button type="button"
                                        class="segmented__option @(_kind == CredentialKind.Password ? "segmented__option--on" : "")"
                                        role="radio" aria-checked="@(_kind == CredentialKind.Password ? "true" : "false")"
                                        data-testid="kind-password" @onclick="() => _kind = CredentialKind.Password">Password</button>
                            </div>
                        </fieldset>

                        <label class="field">
                            <span class="field__label">Username</span>
                            <input class="field__input mono" type="text" data-testid="credential-username"
                                   placeholder="deploy" autocomplete="off" autocapitalize="none" spellcheck="false"
                                   @bind="_username" @bind:event="oninput" />
                            <span class="field__hint">Optional. Used when a host does not name its own.</span>
                        </label>

                        @if (_kind == CredentialKind.PrivateKey)
                        {
                            <button type="button" class="btn btn--ghost btn--block"
                                    data-testid="generate-ssh-key" @onclick="GenerateSshKey">
                                <Icon Name="key" /> Generate SSH key
                            </button>
                            <span class="field__hint">Generates a 3072-bit RSA key pair locally. The private key is stored in the vault; the public key can be copied for authorized_keys.</span>

                            <label class="field">
                                <span class="field__label">Private key</span>
                                <textarea class="field__input field__input--code mono" rows="6"
                                          data-testid="credential-secret"
                                          placeholder="-----BEGIN OPENSSH PRIVATE KEY-----"
                                          autocomplete="off" autocapitalize="none" spellcheck="false"
                                          @bind="_secret" @bind:event="oninput"></textarea>
                                <span class="field__hint">Pasted as-is and sealed immediately inside the vault.</span>
                            </label>

                            @if (!string.IsNullOrWhiteSpace(_publicKey))
                            {
                                <label class="field">
                                    <span class="field__label">Public key</span>
                                    <textarea class="field__input field__input--code mono" rows="4"
                                              data-testid="generated-public-key" readonly>@_publicKey</textarea>
                                    <button type="button" class="btn btn--ghost"
                                            data-testid="copy-generated-public-key"
                                            @onclick="() => CopyPublicKeyAsync(_publicKey)">Copy public key</button>
                                </label>
                            }

                            <label class="field">
                                <span class="field__label">Key passphrase</span>
                                <input class="field__input mono" type="password" data-testid="credential-passphrase"
                                       autocomplete="off" @bind="_passphrase" @bind:event="oninput" />
                                <span class="field__hint">Leave blank if the key has none.</span>
                            </label>
                        }
                        else if (_kind == CredentialKind.PublicKey)
                        {
                            <label class="field">
                                <span class="field__label">Public key</span>
                                <textarea class="field__input field__input--code mono" rows="5"
                                          data-testid="credential-public-key"
                                          placeholder="ssh-ed25519 AAAA... user@host"
                                          autocomplete="off" autocapitalize="none" spellcheck="false"
                                          @bind="_publicKey" @bind:event="oninput"></textarea>
                                <span class="field__hint">Authorization-only key. Useful for Tailcat shell allowlists; no private key is stored.</span>
                            </label>
                        }
                        else
                        {
                            <label class="field">
                                <span class="field__label">Password</span>
                                <div class="field__with-action">
                                    <input class="field__input mono" data-testid="credential-secret"
                                           type="@(_revealed ? "text" : "password")"
                                           autocomplete="off" autocapitalize="none" spellcheck="false"
                                           @bind="_secret" @bind:event="oninput" />
                                    <button type="button" class="btn btn--icon"
                                            aria-label="@(_revealed ? "Hide password" : "Show password")"
                                            data-testid="reveal-secret" @onclick="() => _revealed = !_revealed">
                                        <Icon Name="@(_revealed ? "eye-off" : "eye")" />
                                    </button>
                                </div>
                            </label>
                        }

                        <div class="form__actions">
                            <button type="button" class="btn btn--primary btn--block"
                                    disabled="@(_busy || !IsComplete)" data-testid="save-credential"
                                    @onclick="SaveAsync">@(_busy ? "Saving…" : "Save to vault")</button>
                            <button type="button" class="btn btn--ghost btn--block"
                                    data-testid="cancel-credential" @onclick="StopAdding">Cancel</button>
                        </div>
                    </div>
                </div>
            }
            else if (_credentials.Count == 0)
            {
                <div class="empty keys-empty" data-testid="keys-empty">
                    <span class="empty__glyph"><Icon Name="key" /></span>
                    <p class="empty__title">No saved credentials</p>
                    <p class="empty__body">Save a private key or password once, then reuse it across any number of hosts. Secrets stay encrypted in the vault.</p>
                    <button type="button" class="btn btn--primary" @onclick="StartAdding"><Icon Name="plus" /> Add credential</button>
                </div>
            }
            else
            {
                <div class="keys-header">
                    <div>
                        <h2>Saved credentials</h2>
                        <p>@_credentials.Count credential@(_credentials.Count == 1 ? "" : "s") in this vault</p>
                    </div>
                    <button type="button" class="btn btn--ghost keys-header__add" @onclick="StartAdding">
                        <Icon Name="plus" /> Add
                    </button>
                </div>

                <div class="credential-list" data-testid="credential-list">
                    @foreach (var credential in _credentials)
                    {
                        <article class="credential-card" data-testid="credential-row">
                            <span class="credential-card__icon" aria-hidden="true">
                                <Icon Name="@(credential.Kind == CredentialKind.Password ? "lock" : "key")" />
                            </span>
                            <span class="credential-card__body">
                                <span class="credential-card__title-row">
                                    <strong class="credential-card__title">@credential.Label</strong>
                                    <span class="credential-card__kind">@CredentialKindLabel(credential.Kind)</span>
                                </span>
                                <span class="credential-card__hint mono">@credential.DisplayHint</span>
                            </span>
                            <span class="credential-card__actions">
                                @if (!string.IsNullOrWhiteSpace(credential.PublicKey))
                                {
                                    <button type="button" class="btn btn--icon"
                                            aria-label="@($"Show public key for {credential.Label}")"
                                            data-testid="show-public-key"
                                            @onclick="() => TogglePublicKey(credential.Id)">
                                        <Icon Name="key" />
                                    </button>
                                    <button type="button" class="btn btn--icon"
                                            aria-label="@($"Copy public key for {credential.Label}")"
                                            data-testid="copy-public-key"
                                            @onclick="() => CopyPublicKeyAsync(credential.PublicKey!)">
                                        <Icon Name="copy" />
                                    </button>
                                }
                                <button type="button" class="btn btn--icon credential-card__delete"
                                        aria-label="@($"Delete {credential.Label}")"
                                        data-testid="delete-credential"
                                        @onclick="() => DeleteAsync(credential)">
                                    <Icon Name="trash" />
                                </button>
                            </span>
                            @if (_expandedPublicKeyId == credential.Id && !string.IsNullOrWhiteSpace(credential.PublicKey))
                            {
                                <textarea class="field__input field__input--code mono credential-card__public-key"
                                          rows="4" readonly data-testid="public-key-value">@credential.PublicKey</textarea>
                            }
                        </article>
                    }
                </div>

                <div class="keys-security-note" role="note" data-testid="keys-delete-note">
                    <span class="keys-security-note__icon" aria-hidden="true"><Icon Name="shield" /></span>
                    <span>
                        <strong>Deletion is immediate.</strong>
                        <small>Deleting a credential wipes its secret from the vault file straight away and detaches it from hosts that used it.</small>
                    </span>
                </div>
            }
        </section>
    </ChildContent>
</AppShell>

@code {
    private IReadOnlyList<CredentialSummary> _credentials = [];
    private bool _adding;
    private bool _busy;
    private bool _revealed;
    private string _label = "";
    private string _username = "";
    private string _secret = "";
    private string _passphrase = "";
    private string _publicKey = "";
    private Guid? _expandedPublicKeyId;
    private CredentialKind _kind = CredentialKind.PrivateKey;

    [Parameter] public EventCallback<string> OnTabSelected { get; set; }

    private bool IsComplete => !string.IsNullOrWhiteSpace(_label)
        && (_kind == CredentialKind.PublicKey ? !string.IsNullOrWhiteSpace(_publicKey) : _secret.Length > 0);

    protected override Task OnInitializedAsync() => ReloadAsync();
    private async Task ReloadAsync() => _credentials = await Editor.GetCredentialsAsync();

    private void StartAdding()
    {
        _adding = true;
        _label = _username = _secret = _passphrase = _publicKey = "";
        _kind = CredentialKind.PrivateKey;
        _revealed = false;
    }

    private void StopAdding()
    {
        _adding = false;
        _secret = _passphrase = _publicKey = "";
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            await Editor.SaveCredentialAsync(new CredentialRecord
            {
                Id = Guid.NewGuid(),
                Label = _label.Trim(),
                Kind = _kind,
                Username = string.IsNullOrWhiteSpace(_username) ? null : _username.Trim(),
                Secret = _kind == CredentialKind.PublicKey ? [] : Encoding.UTF8.GetBytes(_secret),
                Passphrase = _kind == CredentialKind.PrivateKey && _passphrase.Length > 0 ? Encoding.UTF8.GetBytes(_passphrase) : null,
                PublicKey = (_kind is CredentialKind.PrivateKey or CredentialKind.PublicKey) && !string.IsNullOrWhiteSpace(_publicKey)
                    ? _publicKey.Trim()
                    : null,
            });

            StopAdding();
            await ReloadAsync();
        }
        finally { _busy = false; }
    }

    private static string CredentialKindLabel(CredentialKind kind) => kind switch
    {
        CredentialKind.Password => "Password",
        CredentialKind.PublicKey => "Public key",
        _ => "Private key",
    };

    private void GenerateSshKey()
    {
        var generated = SshKeyGenerator.GenerateRsa(string.IsNullOrWhiteSpace(_label) ? "meowssh" : _label.Trim());
        _secret = generated.PrivateKey;
        _publicKey = generated.PublicKey;
        _passphrase = "";
    }

    private void TogglePublicKey(Guid credentialId) =>
        _expandedPublicKeyId = _expandedPublicKeyId == credentialId ? null : credentialId;

    private async Task CopyPublicKeyAsync(string publicKey)
    {
        await using var clipboard = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/MeowSSH.UI/js/clipboard.js");
        await clipboard.InvokeAsync<bool>("copyText", publicKey);
    }

    private async Task DeleteAsync(CredentialSummary credential)
    {
        await Editor.DeleteCredentialAsync(credential.Id);
        await ReloadAsync();
    }
}
