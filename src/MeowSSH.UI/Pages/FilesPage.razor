@using System.Text
@using MeowSSH.Core.Ssh
@using MeowSSH.UI.Services
@inject ILocalFileTransferService LocalFiles
@implements IDisposable

<div class="files" data-testid="files">
    <header class="topbar">
        <button type="button" class="btn btn--icon" aria-label="Back to hosts"
                data-testid="files-back" @onclick="OnClose">
            <Icon Name="back" />
        </button>

        <span class="session__title">
            <span class="session__host">Files</span>
            <span class="session__address">@Host.Label</span>
        </span>

        <button type="button" class="btn btn--icon" aria-label="Upload file"
                data-testid="upload-file" @onclick="UploadAsync">
            <Icon Name="upload" />
        </button>
        <button type="button" class="btn btn--icon" aria-label="Show hidden files"
                aria-pressed="@(_showHidden ? "true" : "false")"
                data-testid="toggle-hidden" @onclick="ToggleHidden">
            <Icon Name="@(_showHidden ? "eye" : "eye-off")" />
        </button>
        <button type="button" class="btn btn--icon" aria-label="New folder"
                data-testid="new-folder" @onclick="StartNewFolder">
            <Icon Name="folder-plus" />
        </button>
    </header>

    <nav class="crumbs" aria-label="Path" data-testid="crumbs">
        @foreach (var (label, path) in RemotePath.Breadcrumbs(_path))
        {
            <button type="button" class="crumbs__crumb @(path == _path ? "is-current" : "")"
                    aria-current="@(path == _path ? "location" : null)"
                    data-testid="crumb" @onclick="() => NavigateAsync(path)">@label</button>
        }
    </nav>

    <div class="files__body">
        @if (_error is not null)
        {
            <div class="notice notice--danger" role="alert" data-testid="files-error">
                <Icon Name="alert" />
                <div>
                    <p class="notice__title">@_error.Title</p>
                    <p class="notice__body">@_error.Body</p>
                </div>
            </div>
            @if (RemotePath.ParentOf(_path) is { } up)
            {
                <button type="button" class="btn btn--ghost btn--block"
                        data-testid="go-up" @onclick="() => NavigateAsync(up)">
                    Go up to @RemotePath.NameOf(up)
                </button>
            }
        }
        else if (_entries is null)
        {
            <p class="files__status" role="status" data-testid="files-loading">Loading…</p>
        }
        else if (_newFolder is not null)
        {
            <div class="stack" data-testid="new-folder-form">
                <label class="field">
                    <span class="field__label">Folder name</span>
                    <input class="field__input" type="text" autocomplete="off" spellcheck="false"
                           data-testid="new-folder-name" @bind="_newFolder" @bind:event="oninput" />
                </label>
                <button type="button" class="btn btn--primary btn--block"
                        disabled="@(string.IsNullOrWhiteSpace(_newFolder))"
                        data-testid="create-folder" @onclick="CreateFolderAsync">Create</button>
                <button type="button" class="btn btn--ghost btn--block"
                        @onclick="() => _newFolder = null">Cancel</button>
            </div>
        }
        else if (Visible.Count == 0)
        {
            <div class="empty" data-testid="files-empty">
                <span class="empty__glyph"><Icon Name="folder" /></span>
                <p class="empty__title">Nothing here</p>
                <p class="empty__body">
                    @(_entries.Count == 0
                        ? "This folder is empty."
                        : "Every item here is hidden. Use the eye button to show them.")
                </p>
            </div>
        }
        else
        {
            <ul class="filelist" data-testid="filelist">
                @foreach (var entry in Visible)
                {
                    <li class="fileitem-row">
                        <button type="button" class="fileitem" data-testid="file-entry"
                                data-file-name="@entry.Name"
                                @onclick="() => ActivateAsync(entry)">
                            <span class="fileitem__icon @(entry.IsDirectory ? "is-dir" : "")" aria-hidden="true">
                                <Icon Name="@(entry.IsDirectory ? "folder" : "file")" />
                            </span>
                            <span class="fileitem__detail">
                                <span class="fileitem__name">
                                    @entry.Name@(entry.IsSymlink ? " →" : "")
                                </span>
                                <span class="fileitem__meta">
                                    <span class="mono">@entry.PermissionString</span>
                                    @if (!entry.IsDirectory)
                                    {
                                        <span>@entry.DisplaySize</span>
                                    }
                                    <span>@Relative(entry.ModifiedAt)</span>
                                </span>
                            </span>
                            @if (entry.IsDirectory)
                            {
                                <span class="fileitem__chevron" aria-hidden="true"><Icon Name="chevron" /></span>
                            }
                        </button>
                        <button type="button" class="fileitem__menu btn btn--icon"
                                aria-label="Actions for @entry.Name"
                                data-testid="file-actions" data-file-name="@entry.Name"
                                @onclick="() => ShowActions(entry)">
                            <Icon Name="more" />
                        </button>
                    </li>
                }
            </ul>
        }
    </div>
</div>

@if (_transferStatus is not null)
{
    <div class="sheet" role="status" data-testid="transfer-status">
        <p class="sheet__title">@_transferStatus</p>
        @if (_transferFraction is not null)
        {
            <progress class="transfer-progress" max="1" value="@_transferFraction.Value"></progress>
            <p class="sheet__body">@($"{_transferFraction.Value:P0}")</p>
        }
    </div>
}

@if (_notice is not null)
{
    <div class="sheet" role="status" data-testid="file-notice">
        <p class="sheet__title">@_notice</p>
        <button type="button" class="btn btn--primary btn--block" @onclick="() => _notice = null">OK</button>
    </div>
}

@if (_selected is { } selected)
{
    <div class="sheet" role="dialog" aria-label="File actions" data-testid="file-actions-sheet">
        <p class="sheet__title">@selected.Name</p>
        <p class="sheet__body mono">@selected.PermissionString · @ModeText(selected.Mode)</p>
        <div class="form__actions">
            @if (!selected.IsDirectory)
            {
                <button type="button" class="btn btn--primary btn--block"
                        data-testid="view-text" @onclick="() => OpenTextAsync(selected)">View as text</button>
                <button type="button" class="btn btn--ghost btn--block"
                        data-testid="download-file" @onclick="() => DownloadAsync(selected)">
                    <Icon Name="download" /> Download
                </button>
            }
            <button type="button" class="btn btn--ghost btn--block"
                    data-testid="rename-file" @onclick="() => StartRename(selected)">
                Rename
            </button>
            <button type="button" class="btn btn--ghost btn--block"
                    data-testid="move-file" @onclick="() => StartMove(selected)">
                Move
            </button>
            <button type="button" class="btn btn--ghost btn--block"
                    data-testid="change-permissions" @onclick="() => StartPermissions(selected)">
                Change permissions
            </button>
            <button type="button" class="btn btn--danger btn--block"
                    data-testid="delete-file" @onclick="() => ConfirmDelete(selected)">
                <Icon Name="trash" /> Delete
            </button>
            <button type="button" class="btn btn--ghost btn--block" @onclick="() => _selected = null">Cancel</button>
        </div>
    </div>
}

@if (_renameTarget is { } renameTarget)
{
    <div class="sheet" role="dialog" aria-label="Rename file" data-testid="rename-sheet">
        <p class="sheet__title">Rename @renameTarget.Name</p>
        <label class="field">
            <span class="field__label">New name</span>
            <input class="field__input" type="text" autocomplete="off" spellcheck="false"
                   data-testid="rename-name" @bind="_renameText" @bind:event="oninput" />
        </label>
        @if (_renameError is not null)
        {
            <p class="field__error" role="alert" data-testid="rename-error">@_renameError</p>
        }
        <div class="form__actions">
            <button type="button" class="btn btn--primary btn--block"
                    data-testid="confirm-rename" @onclick="RenameAsync">Rename</button>
            <button type="button" class="btn btn--ghost btn--block" @onclick="CancelRename">Cancel</button>
        </div>
    </div>
}

@if (_moveTarget is { } moveTarget)
{
    <div class="sheet" role="dialog" aria-label="Move file" data-testid="move-sheet">
        <p class="sheet__title">Move @moveTarget.Name</p>
        <p class="sheet__body">Enter an absolute destination folder. The item keeps its current name.</p>
        <label class="field">
            <span class="field__label">Destination folder</span>
            <input class="field__input mono" type="text" autocomplete="off" spellcheck="false"
                   data-testid="move-destination" @bind="_moveDestination" @bind:event="oninput" />
        </label>
        @if (_moveError is not null)
        {
            <p class="field__error" role="alert" data-testid="move-error">@_moveError</p>
        }
        <div class="form__actions">
            <button type="button" class="btn btn--primary btn--block"
                    data-testid="confirm-move" @onclick="MoveAsync">Move</button>
            <button type="button" class="btn btn--ghost btn--block" @onclick="CancelMove">Cancel</button>
        </div>
    </div>
}

@if (_deleteTarget is { } deleteTarget)
{
    <div class="sheet sheet--danger" role="alertdialog" data-testid="delete-confirm">
        <p class="sheet__title">Delete @deleteTarget.Name?</p>
        <p class="sheet__body">
            @(deleteTarget.IsDirectory
                ? "Only an empty directory can be deleted. This cannot be undone."
                : "This file will be removed from the server. This cannot be undone.")
        </p>
        <div class="form__actions">
            <button type="button" class="btn btn--danger btn--block"
                    data-testid="confirm-delete" @onclick="DeleteAsync">Delete</button>
            <button type="button" class="btn btn--ghost btn--block" @onclick="() => _deleteTarget = null">Cancel</button>
        </div>
    </div>
}

@if (_permissionsTarget is { } permissionsTarget)
{
    <div class="sheet" role="dialog" data-testid="permissions-sheet">
        <p class="sheet__title">Permissions for @permissionsTarget.Name</p>
        <p class="sheet__body">Enter an octal mode such as 0644 or 0755.</p>
        <label class="field">
            <span class="field__label">Mode</span>
            <input class="field__input mono" inputmode="numeric" maxlength="4"
                   data-testid="permission-mode" @bind="_permissionText" @bind:event="oninput" />
        </label>
        @if (_permissionError is not null)
        {
            <p class="field__error" role="alert">@_permissionError</p>
        }
        <div class="form__actions">
            <button type="button" class="btn btn--primary btn--block"
                    data-testid="save-permissions" @onclick="SavePermissionsAsync">Apply</button>
            <button type="button" class="btn btn--ghost btn--block" @onclick="CancelPermissions">Cancel</button>
        </div>
    </div>
}

@if (_textTarget is { } textTarget)
{
    <div class="text-viewer" role="dialog" aria-label="Text file" data-testid="text-viewer">
        <header class="topbar">
            <button type="button" class="btn btn--icon" aria-label="Close text viewer" @onclick="CloseTextViewer">
                <Icon Name="back" />
            </button>
            <span class="session__title">
                <span class="session__host">@textTarget.Name</span>
                <span class="session__address mono">@textTarget.Path</span>
            </span>
            <button type="button" class="btn btn--primary" data-testid="save-text"
                    disabled="@(_textContent == _textOriginal || _textSaving)" @onclick="SaveTextAsync">
                Save
            </button>
        </header>
        <textarea class="text-editor mono" data-testid="text-content"
                  autocomplete="off" autocorrect="off" autocapitalize="none" spellcheck="false"
                  @bind="_textContent" @bind:event="oninput"></textarea>
    </div>
}

@code {
    private const long MaxTextBytes = 1_500_000;

    private string _path = "/";
    private IReadOnlyList<RemoteFile>? _entries;
    private ErrorNotice? _error;
    private bool _showHidden;
    private string? _newFolder;
    private RemoteFile? _selected;
    private RemoteFile? _renameTarget;
    private string _renameText = "";
    private string? _renameError;
    private RemoteFile? _moveTarget;
    private string _moveDestination = "";
    private string? _moveError;
    private RemoteFile? _deleteTarget;
    private RemoteFile? _permissionsTarget;
    private string _permissionText = "";
    private string? _permissionError;
    private RemoteFile? _textTarget;
    private string _textContent = "";
    private string _textOriginal = "";
    private bool _textSaving;
    private string? _transferStatus;
    private double? _transferFraction;
    private string? _notice;

    [Parameter, EditorRequired] public HostRecord Host { get; set; } = default!;
    [Parameter, EditorRequired] public ISftpSession Sftp { get; set; } = default!;
    [Parameter] public EventCallback OnClosed { get; set; }

    private sealed record ErrorNotice(string Title, string Body);

    private IReadOnlyList<RemoteFile> Visible =>
        _entries is null
            ? []
            : [.. _entries
                .Where(e => _showHidden || !e.IsHidden)
                .OrderBy(e => e.IsDirectory ? 0 : 1)
                .ThenBy(e => e.Name, StringComparer.OrdinalIgnoreCase)];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _path = await Sftp.ResolveAsync(".");
        }
        catch (SshException)
        {
            _path = "/";
        }
        await LoadAsync();
    }

    private async Task NavigateAsync(string path)
    {
        _path = path;
        _newFolder = null;
        _selected = null;
        CancelRename();
        CancelMove();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _entries = null;
        _error = null;
        try
        {
            _entries = await Sftp.ListAsync(_path);
        }
        catch (SshException ex)
        {
            _error = ex.Failure switch
            {
                SshFailure.NotFound => new("Folder not found", $"{_path} no longer exists on this host."),
                SshFailure.PermissionDenied => new("Not allowed", $"{Host.Username ?? "This account"} cannot read {_path}."),
                SshFailure.ConnectionLost => new("Connection lost", "The connection to this host dropped."),
                _ => new("Could not open folder", ex.Message),
            };
        }
    }

    private Task ActivateAsync(RemoteFile entry)
    {
        if (entry.IsDirectory) return NavigateAsync(entry.Path);
        ShowActions(entry);
        return Task.CompletedTask;
    }

    private void ShowActions(RemoteFile entry)
    {
        _selected = entry;
        _error = null;
    }

    private void StartRename(RemoteFile entry)
    {
        _selected = null;
        _renameTarget = entry;
        _renameText = entry.Name;
        _renameError = null;
    }

    private void CancelRename()
    {
        _renameTarget = null;
        _renameText = "";
        _renameError = null;
    }

    private async Task RenameAsync()
    {
        if (_renameTarget is null) return;
        var name = _renameText.Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            _renameError = "Enter a file or folder name.";
            return;
        }
        if (name is "." or ".." || name.Contains('/') || name.Contains('\\'))
        {
            _renameError = "Use a single file or folder name without path separators.";
            return;
        }
        if (string.Equals(name, _renameTarget.Name, StringComparison.Ordinal))
        {
            CancelRename();
            return;
        }

        try
        {
            await Sftp.RenameAsync(_renameTarget.Path, RemotePath.Join(_path, name));
            CancelRename();
            await LoadAsync();
        }
        catch (SshException ex)
        {
            _renameError = ex.Message;
        }
    }

    private void StartMove(RemoteFile entry)
    {
        _selected = null;
        _moveTarget = entry;
        _moveDestination = _path;
        _moveError = null;
    }

    private void CancelMove()
    {
        _moveTarget = null;
        _moveDestination = "";
        _moveError = null;
    }

    private async Task MoveAsync()
    {
        if (_moveTarget is null) return;

        var destination = _moveDestination.Trim().TrimEnd('/');
        if (destination.Length == 0) destination = "/";
        if (!destination.StartsWith('/', StringComparison.Ordinal))
        {
            _moveError = "Use an absolute destination folder beginning with /.";
            return;
        }

        var sourceParent = RemotePath.ParentOf(_moveTarget.Path) ?? "/";
        if (string.Equals(destination, sourceParent, StringComparison.Ordinal))
        {
            _moveError = "Choose a different destination folder.";
            return;
        }

        if (_moveTarget.IsDirectory &&
            (string.Equals(destination, _moveTarget.Path, StringComparison.Ordinal) ||
             destination.StartsWith(_moveTarget.Path + "/", StringComparison.Ordinal)))
        {
            _moveError = "A folder cannot be moved into itself or one of its descendants.";
            return;
        }

        try
        {
            if (destination != "/")
            {
                var destinationEntry = await Sftp.StatAsync(destination);
                if (!destinationEntry.IsDirectory || destinationEntry.IsSymlink)
                {
                    _moveError = "The destination must be a real directory.";
                    return;
                }
            }

            await Sftp.RenameAsync(_moveTarget.Path, RemotePath.Join(destination, _moveTarget.Name));
            CancelMove();
            await LoadAsync();
        }
        catch (SshException ex)
        {
            _moveError = ex.Message;
        }
    }

    private void ConfirmDelete(RemoteFile entry)
    {
        _selected = null;
        _deleteTarget = entry;
    }

    private async Task DeleteAsync()
    {
        if (_deleteTarget is null) return;
        var target = _deleteTarget;
        _deleteTarget = null;
        try
        {
            await Sftp.DeleteAsync(target);
            await LoadAsync();
        }
        catch (SshException ex)
        {
            _error = new("Could not delete", ex.Message);
        }
    }

    private void StartPermissions(RemoteFile entry)
    {
        _selected = null;
        _permissionsTarget = entry;
        _permissionText = ModeText(entry.Mode);
        _permissionError = null;
    }

    private void CancelPermissions()
    {
        _permissionsTarget = null;
        _permissionError = null;
    }

    private async Task SavePermissionsAsync()
    {
        if (_permissionsTarget is null) return;
        var modeText = _permissionText.Trim();
        if (modeText.Length is < 3 or > 4 || modeText.Any(c => c is < '0' or > '7'))
        {
            _permissionError = "Use 3 or 4 octal digits (0–7), for example 644 or 0755.";
            return;
        }

        var mode = Convert.ToUInt32(modeText, 8);
        try
        {
            await Sftp.SetPermissionsAsync(_permissionsTarget.Path, mode);
            _permissionsTarget = null;
            _permissionError = null;
            await LoadAsync();
        }
        catch (SshException ex)
        {
            _permissionError = ex.Message;
        }
    }

    private async Task UploadAsync()
    {
        LocalFileSelection? picked = null;
        try
        {
            picked = await LocalFiles.PickFileAsync();
            if (picked is null) return;

            BeginTransfer($"Uploading {picked.Name}");
            await Sftp.UploadAsync(
                picked.TemporaryPath,
                RemotePath.Join(_path, picked.Name),
                TransferProgressReporter());
            EndTransfer();
            await LoadAsync();
        }
        catch (Exception ex) when (ex is SshException or IOException or UnauthorizedAccessException)
        {
            EndTransfer();
            _error = new("Upload failed", ex.Message);
        }
        finally
        {
            if (picked is not null) LocalFiles.DeleteTemporaryFile(picked.TemporaryPath);
        }
    }

    private async Task DownloadAsync(RemoteFile entry)
    {
        _selected = null;
        var temporaryPath = LocalFiles.CreateTemporaryPath(entry.Name);
        try
        {
            BeginTransfer($"Downloading {entry.Name}");
            await Sftp.DownloadAsync(entry.Path, temporaryPath, TransferProgressReporter());
            var destination = await LocalFiles.PublishDownloadAsync(temporaryPath, entry.Name);
            EndTransfer();
            _notice = $"Saved to {destination}";
        }
        catch (Exception ex) when (ex is SshException or IOException or UnauthorizedAccessException)
        {
            EndTransfer();
            _error = new("Download failed", ex.Message);
        }
        finally
        {
            LocalFiles.DeleteTemporaryFile(temporaryPath);
        }
    }

    private async Task OpenTextAsync(RemoteFile entry)
    {
        _selected = null;
        if (entry.Size > MaxTextBytes)
        {
            _error = new("File is too large to open as text", "Use Download for files larger than 1.5 MB.");
            return;
        }

        var temporaryPath = LocalFiles.CreateTemporaryPath(entry.Name);
        try
        {
            BeginTransfer($"Opening {entry.Name}");
            await Sftp.DownloadAsync(entry.Path, temporaryPath, TransferProgressReporter());
            var bytes = await File.ReadAllBytesAsync(temporaryPath);
            if (bytes.Contains((byte)0))
                throw new InvalidDataException("This file appears to be binary, so it cannot be shown as text.");

            var text = new UTF8Encoding(encoderShouldEmitUTF8Identifier: false, throwOnInvalidBytes: true)
                .GetString(bytes);
            _textTarget = entry;
            _textContent = text;
            _textOriginal = text;
            EndTransfer();
        }
        catch (DecoderFallbackException)
        {
            EndTransfer();
            _error = new("Not a UTF-8 text file", "Download the file instead of opening it in the text viewer.");
        }
        catch (Exception ex) when (ex is SshException or IOException or InvalidDataException)
        {
            EndTransfer();
            _error = new("Could not open as text", ex.Message);
        }
        finally
        {
            LocalFiles.DeleteTemporaryFile(temporaryPath);
        }
    }

    private async Task SaveTextAsync()
    {
        if (_textTarget is null || _textSaving) return;
        _textSaving = true;
        var temporaryPath = LocalFiles.CreateTemporaryPath(_textTarget.Name);
        try
        {
            await File.WriteAllTextAsync(temporaryPath, _textContent, new UTF8Encoding(false));
            BeginTransfer($"Saving {_textTarget.Name}");
            await Sftp.UploadAsync(temporaryPath, _textTarget.Path, TransferProgressReporter());
            _textOriginal = _textContent;
            EndTransfer();
            _notice = "Saved.";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is SshException or IOException or UnauthorizedAccessException)
        {
            EndTransfer();
            _error = new("Could not save file", ex.Message);
        }
        finally
        {
            LocalFiles.DeleteTemporaryFile(temporaryPath);
            _textSaving = false;
        }
    }

    private void CloseTextViewer()
    {
        _textTarget = null;
        _textContent = "";
        _textOriginal = "";
    }

    private IProgress<TransferProgress> TransferProgressReporter() =>
        new Progress<TransferProgress>(progress =>
        {
            _transferFraction = progress.Fraction;
            _ = InvokeAsync(StateHasChanged);
        });

    private void BeginTransfer(string status)
    {
        _transferStatus = status;
        _transferFraction = null;
        StateHasChanged();
    }

    private void EndTransfer()
    {
        _transferStatus = null;
        _transferFraction = null;
        StateHasChanged();
    }

    private async Task ToggleHidden()
    {
        _showHidden = !_showHidden;
        await Task.CompletedTask;
    }

    private void StartNewFolder() => _newFolder = "";

    private async Task CreateFolderAsync()
    {
        var name = _newFolder?.Trim();
        if (string.IsNullOrEmpty(name)) return;
        _newFolder = null;
        try
        {
            await Sftp.CreateDirectoryAsync(RemotePath.Join(_path, name));
        }
        catch (SshException ex)
        {
            _error = new("Could not create folder", ex.Message);
            return;
        }
        await LoadAsync();
    }

    private static string ModeText(uint mode) =>
        Convert.ToString(mode & 0xFFF, 8).PadLeft(4, '0');

    private static string Relative(DateTimeOffset when)
    {
        var age = DateTimeOffset.UtcNow - when;
        return age switch
        {
            { TotalMinutes: < 1 } => "just now",
            { TotalHours: < 1 } => $"{(int)age.TotalMinutes}m ago",
            { TotalDays: < 1 } => $"{(int)age.TotalHours}h ago",
            { TotalDays: < 30 } => $"{(int)age.TotalDays}d ago",
            _ => when.ToString("MMM yyyy", System.Globalization.CultureInfo.InvariantCulture),
        };
    }

    private Task OnClose() => OnClosed.InvokeAsync();

    public void Dispose() { }
}