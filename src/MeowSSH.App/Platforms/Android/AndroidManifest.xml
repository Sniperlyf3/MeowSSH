<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.USE_BIOMETRIC" />
  <!-- Keeps an open session alive while the app is backgrounded; without it
       Android reclaims the process and every connection dies on a screen lock. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application android:allowBackup="false"
               android:extractNativeLibs="true"
               android:icon="@mipmap/appicon"
               android:label="MeowSSH"
               android:roundIcon="@mipmap/appicon_round"
               android:supportsRtl="true">
    <service android:name="dev.sniperlyf3.meowssh.SessionKeepAliveService"
             android:exported="false"
             android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a user-initiated SSH session alive while MeowSSH is backgrounded" />
    </service>
  </application>

</manifest>
